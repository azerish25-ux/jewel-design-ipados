<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework><OutputType>Exe</OutputType><SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <ApplicationId>com.jeweldesign.viewport</ApplicationId><ApplicationTitle>CAD Viewport Test</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion><ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>enable</Nullable><UseSharedCompilation>false</UseSharedCompilation>
    <NativeCandidateArchive Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64'">../../.local/native/ios-sim-all.a</NativeCandidateArchive>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Port/Rendering.Candidate.iOS/Rendering.Candidate.iOS.csproj"/>
    <ProjectReference Include="../Port/Geometry.Candidate.Contracts/Geometry.Candidate.Contracts.csproj"/>
    <Compile Include="../iOS.Native/MetalViewportChecks.cs" Link="MetalViewportChecks.cs"/>
    <NativeReference Include="$(NativeCandidateArchive)"><Kind>Static</Kind><ForceLoad>true</ForceLoad><SmartLink>false</SmartLink><LinkerFlags>-lc++</LinkerFlags></NativeReference>
  </ItemGroup>
  <Target Name="ValidateNativeViewportArchive" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(NativeCandidateArchive)' == ''" Text="Visible viewport harness requires iossimulator-arm64."/>
    <Error Condition="!Exists('$(NativeCandidateArchive)')" Text="Restore the validated simulator native archive before building this harness."/>
  </Target>
</Project>
