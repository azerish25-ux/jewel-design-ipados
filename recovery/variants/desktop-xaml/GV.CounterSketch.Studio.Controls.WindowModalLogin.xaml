<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.Controls.WindowModalLogin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:GV_CounterSketch_Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:GV_CounterSketch_Utilities_Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="Window" Title="WindowModalLogin" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AllowsTransparency="True" Background="#02FFFFFF" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Manual" WindowStartupLocation="Manual" WindowState="Maximized" WindowStyle="None" Foreground="{x:Null}">
  <Grid Name="LoginPrompt" Background="#99000000">
    <Border Width="Auto" Height="Auto" MinWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center">
      <AdornerDecorator>
        <Grid Width="Auto" Height="Auto">
          <Border Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FF000000" BorderThickness="1">
            <DockPanel Margin="5,0,5,5">
              <Border Width="Auto" Height="Auto" DockPanel.Dock="Top" BorderBrush="{x:Null}">
                <i:Interaction.Behaviors>
                  <GV_CounterSketch_Utilities_Behaviors:UIElementBehaviorDragParentWindow />
                </i:Interaction.Behaviors>
                <DockPanel VerticalAlignment="Center">
                  <TextBlock Margin="0,2,5,2" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ReasonForPrompt, ElementName=Window, Mode=Default, FallbackValue=Authentication Required}" />
                  <Button Name="button" HorizontalAlignment="Right" Content="X" DockPanel.Dock="Right" IsCancel="True" Style="{DynamicResource ButtonStyleMainClose}" />
                </DockPanel>
              </Border>
              <Border Width="Auto" BorderBrush="#FF000000" BorderThickness="0.5,1,0.5,0.5" DockPanel.Dock="Top">
                <GV_CounterSketch_Controls:CSLoginControl x:Name="csLoginControl" Width="Auto" Margin="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" LoginControlMode="NormalMode" />
              </Border>
            </DockPanel>
          </Border>
          <Button Height="22" Margin="0,0,84,16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Panel.ZIndex="2" Content="{x:Static l:Strings.CANCEL}" IsCancel="True" />
        </Grid>
      </AdornerDecorator>
    </Border>
  </Grid>
</Window>