        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Custom:SurfaceThumb}">
              <FrameworkTemplate.Resources>
                <ResourceDictionary>
                  <Storyboard x:Key="Touch">
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="16" Duration="0:0:0.05" />
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="0,-1,0,-1" Duration="0:0:0.05" />
                  </Storyboard>
                  <Storyboard x:Key="Release">
                    <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Height" To="14" Duration="0:0:0.1" />
                    <ThicknessAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="Margin" To="0,0,0,0" Duration="0:0:0.1" />
                  </Storyboard>
                </ResourceDictionary>
              </FrameworkTemplate.Resources>
              <Grid Name="Grid" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}">
