<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.MaterialOptionSelectorView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Custom="http://schemas.microsoft.com/surface/2008" xmlns:Custom1="http://www.galasoft.ch/mvvmlight" xmlns:Enums="clr-namespace:GV.CounterSketch.Studio.Model.Objects.Enums" xmlns:GV_CounterSketch_Studio_UserControls_PagedListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.PagedListBox" xmlns:GV_CounterSketch_Studio_Utilities_Converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:GV_CounterSketch_Studio_ViewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="550" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <GV_CounterSketch_Studio_Utilities_Converters:GemColorTypeEnumToDescriptionConverter x:Key="GemColorTypeEnumToDescriptionConverter" />
      <ObjectDataProvider x:Key="GemColorTypeValues" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
        <ObjectDataProvider.MethodParameters>
          <x:TypeExtension TypeName="Enums:GemColorType" />
        </ObjectDataProvider.MethodParameters>
      </ObjectDataProvider>
      <DataTemplate x:Key="DataTemplateGemColorType">
        <Border Background="{Binding Mode=OneWay, Converter={GV_CounterSketch_Studio_Utilities_Converters:ColorStringToBrushConverter}}" />
      </DataTemplate>
      <Style x:Key="ControlBaseStyle" TargetType="{x:Type Control}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="False" />
        <Setter Property="FontFamily" Value="/CounterSketch Studio;component/Fonts/#Helvetica Neue LT Std" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="Padding" Value="6,2,10,10" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="BorderThickness" Value="2" />
      </Style>
      <SolidColorBrush x:Key="ControlHitAreaBrush" Color="#00FFFFFF" />
