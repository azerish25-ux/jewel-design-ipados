<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.DesignImageSummaryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:GV_CounterSketch_Studio_Utilities_Converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="clr-namespace:GV.CounterSketch.Studio.ViewModel" xmlns:GV_CounterSketch_Studio_Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:Command="http://www.galasoft.ch/mvvmlight" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Path=DesignImageSummaryVM, Source={StaticResource Locator}}">
  <i:Interaction.Triggers>
    <i:EventTrigger>
      <Command:EventToCommand Command="{Binding CommandPopulateImages, Mode=OneWay}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="1.5*" />
        <RowDefinition Height="0.5*" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
        <ColumnDefinition Width="1*" />
      </Grid.ColumnDefinitions>
      <Image Grid.ColumnSpan="3" Margin="5" Source="{Binding PerspectiveImageUri, Converter={GV_CounterSketch_Studio_Utilities_Converters:ImagePathToBitmapImageConverter}}" />
      <Image Grid.Row="1" Margin="5" Source="{Binding TopImageUri, Converter={GV_CounterSketch_Studio_Utilities_Converters:ImagePathToBitmapImageConverter}}" />
      <Image Grid.Row="1" Grid.Column="1" Margin="5" Source="{Binding FrontImageUri, Converter={GV_CounterSketch_Studio_Utilities_Converters:ImagePathToBitmapImageConverter}}" />
      <Image Grid.Row="1" Grid.Column="2" Margin="5" Source="{Binding RightImageUri, Converter={GV_CounterSketch_Studio_Utilities_Converters:ImagePathToBitmapImageConverter}}" />
    </Grid>
    <GV_CounterSketch_Studio_Controls:Spinner x:Name="spinIndicator" />
  </Grid>
</UserControl>