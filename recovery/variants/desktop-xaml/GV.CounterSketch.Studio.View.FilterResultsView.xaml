<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.FilterResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pagedListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.PagedListBox" xmlns:system="clr-namespace:System;assembly=mscorlib" DataContext="{Binding TileSearchMainVM.ActiveSearchResultViewModel, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplateNotVirtualized">
        <StackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="DataTemplateTileSearchFilterItemPaged">
        <Border Width="150" Margin="0,0,30,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFFFFFFF" BorderBrush="#DDDDDD" BorderThickness="1" Cursor="Hand">
          <Grid>
            <Button Width="Auto" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Style="{DynamicResource ButtonStyleClear}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <ei:ChangePropertyAction PropertyName="IsOpen" Value="True" TargetObject="{Binding ElementName=popup}" />
                  <ei:ChangePropertyAction PropertyName="IsOpen" Value="True" TargetObject="{Binding}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <DockPanel Name="dockPanel" Width="Auto" HorizontalAlignment="Stretch" Cursor="Hand">
                <StackPanel HorizontalAlignment="Center" DockPanel.Dock="Top" Orientation="Vertical">
                  <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="12" FontWeight="Bold" TextAlignment="Left" Text="{Binding TitleTranslated, FallbackValue=[Title], Converter={StaticResource StringToTitleCaseConverter}}" />
                  <StackPanel Width="Auto" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" FontWeight="Bold" Foreground="#FF65615D" Style="{DynamicResource TextBlockService}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedItemLabel, FallbackValue=[Name]}" />
                    <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" FontWeight="Bold" Foreground="#FF65615D" Style="{DynamicResource TextBlockService}" TextAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding SelectedSearchFilterItem.SecondaryText, FallbackValue=[Name]}" />
                  </StackPanel>
                </StackPanel>
                <Grid Margin="0,5,0,10" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased">
                  <Image Source="{Binding SelectedSearchFilterItem.ImagePath}" />
                  <controls:SelectedItemsImageControl ItemsSource="{Binding SelectedSearchFilterItemImages}" Visibility="{Binding SelectedSearchFilterItemImages.Count, ConverterParameter=1, Converter={StaticResource IntegerToVisibilityConverter}}" />
                </Grid>
              </DockPanel>
            </Button>
            <Grid Width="0" HorizontalAlignment="Right">
              <Popup Name="popup" AllowsTransparency="True" HorizontalOffset="-1" IsOpen="False" Placement="Bottom" PopupAnimation="Slide" StaysOpen="False" VerticalOffset="3" PlacementTarget="{Binding ElementName=dockPanel, Mode=OneWay}">
                <local:ItemChooserView x:Name="pagedListBox" IsFilterPicker="True" IsGemPicker="False" IsMetalPicker="False" SelectionMode="Multiple" IsOpen="{Binding ElementName=popup, Path=IsOpen, Mode=TwoWay}" ItemsSource="{Binding SearchFilterItems, Mode=OneWay}" />
              </Popup>
            </Grid>
            <Border VerticalAlignment="Stretch" Background="#BFFFFFFF" BorderThickness="0" Cursor="No" ToolTip="{x:Static localization:Strings.RemoveAssignedStoneToEdit}" Visibility="{Binding IsFilterDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel Height="134" Margin="0,8">
    <DockPanel Width="450" Margin="0,0,60,0" Background="#FFFFFFFF" Dock="Right" IsHitTestVisible="True" Visibility="{Binding ResultsVisibility}">
      <StackPanel Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Orientation="Horizontal">
        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="SHOWING" />
        <TextBlock Margin="6,0,4,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="{Binding FirstDesignIndexOnPage}" />
        <TextBlock Margin="0" VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="-" />
        <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="{Binding LastDesignIndexOnPage}" />
        <TextBlock Margin="4,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="{Binding Converter={StaticResource StringToUpperCaseConverter}, Source={x:Static localization:Strings.Of}}" />
        <TextBlock Margin="4,0,4,0" VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="{Binding SearchResults.Count}" />
        <TextBlock Margin="14,0,14,0" VerticalAlignment="Top" FontSize="16" Foreground="#FFABABAB" Text="|" />
        <TextBlock VerticalAlignment="Center" FontSize="14" Foreground="#FF000000" Text="RESULTS PER PAGE" />
        <ComboBox Width="60" Margin="14,0,0,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Focusable="False" SelectedValuePath="Content" SelectedValue="{Binding PageSize, Mode=TwoWay}">
          <ComboBoxItem Content="36" />
          <ComboBoxItem Content="72" />
          <ComboBoxItem Content="144" />
        </ComboBox>
      </StackPanel>
      <local:SearchResultsPagerControl Margin="0,10" HorizontalAlignment="Right" />
    </DockPanel>
