                <MultiBinding Converter="{StaticResource TileSizeImagePathToImageConverter}">
                  <Binding Source="{x:Static dxlc:TileSize.Large}" />
                  <Binding Path="SelectedSearchTileCategory.TileImagePath" />
                  <Binding>
                    <Binding.Source>
                      <system:Boolean>true</system:Boolean>
                    </Binding.Source>
                  </Binding>
                  <Binding Path="TileViewDesignsVM.IsTechTheme" Source="{StaticResource Locator}" />
                </MultiBinding>
              </Image.Source>
            </Image>
            <Image Width="310" Height="150" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Stretch" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased" Source="{Binding SelectedSearchTileCategory.TileImagePath, Converter={StaticResource ImagePathToBitmapImageConverter}}" Visibility="{Binding SelectedSearchTileCategory.PackageAttributeId, Converter={StaticResource IntegerGreaterThanZeroToVisibilityConverter}, Mode=OneWay}" />
          </Grid>
        </Border>
