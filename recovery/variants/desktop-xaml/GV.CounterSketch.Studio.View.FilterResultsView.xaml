                </Viewbox>
              </RadioButton>
              <RadioButton Width="40" Height="40" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static localization:Strings.ThroughFinger}" Command="{Binding CommandUpdateSearchResultImageSizes}" IsChecked="{Binding IsFrontView, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
