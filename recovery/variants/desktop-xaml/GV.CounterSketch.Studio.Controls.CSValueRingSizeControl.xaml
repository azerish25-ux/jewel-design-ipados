<?xml version="1.0" encoding="utf-8"?>
<Controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueRingSizeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:GV_CounterSketch_Utilities_Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="CSValueRingSizeUserControl" Height="35" Background="#00FFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="DataTemplateFingerSizeItem">
        <Grid Width="Auto" Height="Auto">
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="13.333" FontWeight="Normal" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Value, FallbackValue=15 1/4}" />
        </Grid>
      </DataTemplate>
      <Style x:Key="ComboBoxStyleFingerSize" TargetType="{x:Type ComboBox}">
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{DynamicResource ComboBoxFocusVisual}" />
        <Setter Property="Background" Value="{DynamicResource ButtonNormalBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonNormalBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ComboBox}">
              <Grid Name="MainGrid" Height="Auto" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="23.647" MinWidth="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
                </Grid.ColumnDefinitions>
                <Popup Name="PART_Popup" Grid.ColumnSpan="2" Margin="1" AllowsTransparency="True" Placement="Bottom" PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}" IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                  <Border Name="DropDownBorder" MaxHeight="175" Margin="0" Background="#FFFFFFFF" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1" Width="{Binding ActualWidth, ElementName=toggleButton, Mode=Default}">
                    <ScrollViewer Name="scrollViewer" CanContentScroll="True" Foreground="{DynamicResource TextBoxAndFrameBackground}" Width="{Binding ActualWidth, ElementName=toggleButton, Mode=Default}">
                      <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                    </ScrollViewer>
                  </Border>
                </Popup>
                <ToggleButton Name="toggleButton" Grid.ColumnSpan="2" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" Style="{DynamicResource ComboBoxReadonlyToggleButton}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter Margin="5" Content="{TemplateBinding ComboBox.SelectionBoxItem}" ContentStringFormat="{TemplateBinding ComboBox.SelectionBoxItemStringFormat}" ContentTemplate="{TemplateBinding ComboBox.SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemsControl.ItemTemplateSelector}" IsHitTestVisible="False" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" TextBlock.Foreground="{DynamicResource TextBoxAndFrameBackground}" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ComboBoxItem.IsHighlighted" Value="True">
                  <Setter Property="TextElement.Foreground" Value="#FF008000" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True" />
                <Trigger Property="ItemsControl.HasItems" Value="False">
                  <Setter TargetName="DropDownBorder" Property="Height" Value="95" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                  <Setter Property="Background" Value="#FFF4F4F4" />
                  <Setter TargetName="toggleButton" Property="UIElement.Opacity" Value="0.25" />
                </Trigger>
                <Trigger Property="ItemsControl.IsGrouping" Value="True">
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <DockPanel Height="40" Margin="12,0,6,0">
      <TextBlock Name="txtTitle" VerticalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FF32302E" Text="Finger Size" />
      <ComboBox Height="20" MinWidth="125" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ItemTemplate="{DynamicResource DataTemplateFingerSizeItem}" SelectedIndex="0" SelectedValuePath="Key" Style="{DynamicResource ComboBoxStyleFingerSize}" ItemsSource="{Binding RingSizeDisplayLookup, ElementName=CSValueRingSizeUserControl}" SelectedValue="{Binding SelectedRingSizeIndex, ElementName=CSValueRingSizeUserControl, Mode=TwoWay}" SelectionChanged="ComboBoxSelectionChanged" />
    </DockPanel>
  </Grid>
</Controls:CSUIControl>