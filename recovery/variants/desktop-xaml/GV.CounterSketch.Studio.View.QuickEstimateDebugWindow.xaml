<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.QuickEstimateDebugWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Command="http://www.galasoft.ch/mvvmlight" xmlns:ViewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Quick Estimate Debug" Width="800" Height="500" MinWidth="800" MinHeight="400" AllowsTransparency="True" Background="#FFFFFFFF" BorderBrush="#FF000000" FontFamily="Helvetica Neue LT Std" FontSize="10pt" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True" SnapsToDevicePixels="True" Style="{DynamicResource WindowStyleModalCS4}" WindowStyle="None" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Path=OrderSummaryVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DataTemplateDebugGem" DataType="ViewModel:GemGroup">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="175" />
            <ColumnDefinition Width="175" />
            <ColumnDefinition Width="65" />
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="50" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="100" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" HorizontalAlignment="Center" Text="{Binding Shape}" />
          <TextBlock Grid.Column="1" Text="{Binding StullerId}" />
          <TextBlock Grid.Column="2" Text="{Binding EstimateQualityLevelName}" />
          <TextBlock Grid.Column="3" Text="{Binding GemNumbersString}" />
          <TextBlock Grid.Column="4" Margin="0,0,10,0" HorizontalAlignment="Right" Text="{Binding Height}" />
          <TextBlock Grid.Column="5" HorizontalAlignment="Center" Text=" x " />
          <TextBlock Grid.Column="6" HorizontalAlignment="Center" Text="{Binding Width}" />
          <TextBlock Grid.Column="7" HorizontalAlignment="Center" Text=" x " />
          <TextBlock Grid.Column="8" HorizontalAlignment="Center" Text="{Binding Length}" />
          <TextBlock Grid.Column="9" HorizontalAlignment="Right" Text="{Binding StullerCost, StringFormat={}{0:C}}" />
          <TextBlock Grid.Column="10" HorizontalAlignment="Right" Text="{Binding CustomerMarkup, StringFormat={}{0:P}}" />
          <TextBlock Grid.Column="11" HorizontalAlignment="Right" Text="{Binding CustomerMarkedUpCost, StringFormat={}{0:C}}" />
        </Grid>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleDebug" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.MouseOver.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.MouseOver.Border}" />
                </MultiTrigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                    <Condition Property="ListBoxItem.IsSelected" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.SelectedInactive.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.SelectedInactive.Border}" />
                </MultiTrigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                    <Condition Property="ListBoxItem.IsSelected" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.SelectedActive.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.SelectedActive.Border}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="TextElement.Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="20" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <Border Name="TopBar" Background="#FFCCC6C1" BorderBrush="#FF000000" BorderThickness="0,0,0,1">
      <i:Interaction.Behaviors>
        <Behaviors:UIElementBehaviorDragParentWindow />
      </i:Interaction.Behaviors>
      <DockPanel Margin="2,0">
        <Button Name="buttonCancel" Width="15" Height="15" HorizontalAlignment="Right" VerticalAlignment="Center" Content="" Cursor="Hand" DockPanel.Dock="Right" IsCancel="False" IsDefault="False" Style="{DynamicResource CSCancelButton}" Template="{DynamicResource CS4CancelButton}">
          <i:Interaction.Behaviors>
            <Behaviors:ButtonBehaviorHideParentNonModalWindow />
          </i:Interaction.Behaviors>
        </Button>
        <TextBlock Margin="2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Text="Estimate Debug Report" TextWrapping="Wrap" />
      </DockPanel>
    </Border>
    <Border Name="WindowFrame" Grid.Row="1" Background="#FFCCC6C1" BorderBrush="#FFCCC6C1" BorderThickness="1,0,1,1">
      <Border Margin="1,0,1,1" Background="#FFFFFFFF" BorderThickness="0" />
    </Border>
    <Grid Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="85" />
      </Grid.RowDefinitions>
      <ScrollViewer Margin="10">
        <StackPanel VerticalAlignment="Top">
          <TextBlock Margin="0,10,15,0" Text="Estimated Stones" />
          <ListBox ItemContainerStyle="{DynamicResource ListBoxItemStyleDebug}" ItemTemplate="{DynamicResource DataTemplateDebugGem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" ItemsSource="{Binding DebugEstimateGemGroups}" />
          <Border Height="1" Margin="0,0,15,0" BorderBrush="#FF000000" BorderThickness="0,1,0,0" />
          <TextBlock Margin="0,10,15,0" Text="Setting" />
          <StackPanel Margin="20,0,15,0" Orientation="Horizontal">
            <TextBlock Width="100" Text="Primary: " />
            <TextBlock Width="200" Text="{Binding PrimaryMetal}" />
            <TextBlock Margin="20,0,0,0" Text="{Binding PrimaryMetalWeight}" />
          </StackPanel>
          <Border Height="1" Margin="0,0,15,15" BorderBrush="#FF000000" BorderThickness="0,1,0,0" />
          <DataGrid AutoGenerateColumns="True" IsReadOnly="True" ItemsSource="{Binding QuickEstimateVM.QuickEstimateItems, Source={StaticResource Locator}, Mode=OneWay}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>