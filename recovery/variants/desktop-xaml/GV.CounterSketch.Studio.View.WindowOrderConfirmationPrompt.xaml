      <DockPanel Name="BuyerInfo" Margin="14,0">
        <StackPanel Name="BuyerContactFields" Orientation="Horizontal">
          <TextBlock Margin="0,0,4,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FF000000" Text="{x:Static l:Strings.Consultant}" TextWrapping="NoWrap" />
          <Grid Name="GridFirstname" Width="100" Margin="4,0,0,0" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFCB0303" Opacity="0.7" Text="{x:Static l:Strings.FirstName}" Visibility="{Binding IsBuyerFirstnamePopulated, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <TextBox VerticalAlignment="Center" TabIndex="1" Background="{x:Null}" Text="{Binding BuyerFirstname, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Behaviors>
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorSelectAllTextWhenFocused />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
          <Grid Name="GridLastname" Width="160" Margin="4,0,0,0" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFCB0303" Opacity="0.7" Text="{x:Static l:Strings.LastName}" Visibility="{Binding IsBuyerLastnamePopulated, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <TextBox VerticalAlignment="Center" TabIndex="2" Background="{x:Null}" Text="{Binding BuyerLastname, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Behaviors>
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorSelectAllTextWhenFocused />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
          <Grid Name="GridEmail" Width="200" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFCB0303" Opacity="0.7" Text="{x:Static l:Strings.Email}" Visibility="{Binding IsBuyerEMailPopulated, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <TextBox VerticalAlignment="Center" TabIndex="3" Background="{x:Null}" Text="{Binding BuyerEMail, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Behaviors>
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorSelectAllTextWhenFocused />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <TextBlock Margin="0,0,4,0" VerticalAlignment="Center" Foreground="#FF000000" Text="{x:Static l:Strings.Reference}" TextWrapping="NoWrap" />
          <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#FFCB0303" Opacity="0.7" Text="{x:Static l:Strings.Reference}" Visibility="{Binding IsCustomerReferenceNumberPopulated, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <TextBox Width="80" HorizontalAlignment="Left" VerticalAlignment="Center" TabIndex="4" Background="{x:Null}" Text="{Binding CustomerReferenceNumber, UpdateSourceTrigger=PropertyChanged}">
              <i:Interaction.Behaviors>
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorSelectAllTextWhenFocused />
                <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
              </i:Interaction.Behaviors>
            </TextBox>
          </Grid>
        </StackPanel>
      </DockPanel>
