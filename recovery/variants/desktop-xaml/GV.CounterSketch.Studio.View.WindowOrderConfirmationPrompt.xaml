            <TextBlock Name="SettingCost" Height="24" MinWidth="60" Margin="0,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Text="{Binding QuotedSettingPriceMarkedUpString}" TextDecorations="{x:Null}" />
          </StackPanel>
          <StackPanel Grid.Column="0" MinWidth="60" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsUsingStullerShowcaseMarkups, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
