            <TextBlock Margin="0,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#7FFFFFFF" FontSize="16" Text="{x:Static l:Strings.Size}" TextAlignment="Right" />
            <TextBlock Margin="0,5,0,0" VerticalAlignment="Center" FontSize="16" Text="{Binding SelectedRingSize}" />
