          </StackPanel>
          <TextBlock Name="TotalCost" Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Height="24" MinWidth="60" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18.667" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" Text="{Binding QuotedPriceString}" TextDecorations="{x:Null}" />
