          <Grid.RowDefinitions>
            <RowDefinition Height="23*" />
            <RowDefinition Height="6*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding IsUsingStullerShowcaseMarkups, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
