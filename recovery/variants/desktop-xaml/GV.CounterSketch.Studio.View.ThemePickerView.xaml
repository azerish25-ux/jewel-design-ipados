<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.ThemePickerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:gvCounterSketchStudioUtilitiesBehaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="UserControl" FontSize="13.333" Foreground="{DynamicResource BaseBackground}" DataContext="{Binding Path=ThemePickerVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <DataTemplate x:Key="DataTemplateImageTheme">
        <DockPanel Height="225">
          <TextBlock Margin="5,2,0,2" HorizontalAlignment="Left" DockPanel.Dock="Top" TextWrapping="Wrap" Text="{Binding Name, FallbackValue=Theme Name}" />
          <Border CornerRadius="5,5,0,0" DockPanel.Dock="Bottom">
            <Grid Margin="1" Background="{x:Null}">
              <Border Height="Auto" Margin="5" BorderThickness="1" CornerRadius="0">
                <Viewbox Width="Auto" Height="Auto" Stretch="Fill">
                  <Image Width="1024" Height="768" Stretch="Fill" ToolTip="{x:Static localization:Strings.ViewportBackground}">
                    <Image.Source>
                      <MultiBinding Converter="{converters:ImagePathToBitmapImageWithSizeConverter}">
                        <Binding Path="ViewportImagePath" />
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Viewbox}}" />
                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType={x:Type Viewbox}}" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </Viewbox>
              </Border>
            </Grid>
          </Border>
        </DockPanel>
      </DataTemplate>
      <Style x:Key="ExpanderRightHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Padding="{TemplateBinding Control.Padding}">
                <Grid Background="#00FFFFFF" SnapsToDevicePixels="False">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="19" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <FrameworkElement.LayoutTransform>
                      <TransformGroup>
                        <TransformGroup.Children>
                          <TransformCollection>
                            <RotateTransform Angle="-90" />
                          </TransformCollection>
                        </TransformGroup.Children>
                      </TransformGroup>
                    </FrameworkElement.LayoutTransform>
                    <Ellipse Name="circle" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFA9A9A9" />
                    <Path Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,1.5 L4.5,5 L8,1.5" SnapsToDevicePixels="False" Stroke="#666" StrokeThickness="2" />
                  </Grid>
                  <ContentPresenter Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="arrow" Property="Path.Data" Value="M1,4.5 L4.5,1 L8,4.5" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF3C7FB1" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#222" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF526C7B" />
                  <Setter TargetName="circle" Property="Shape.StrokeThickness" Value="1.5" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#FF003366" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderUpHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Padding="{TemplateBinding Control.Padding}">
                <Grid Background="#00FFFFFF" SnapsToDevicePixels="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid>
                    <FrameworkElement.LayoutTransform>
                      <TransformGroup>
                        <TransformGroup.Children>
                          <TransformCollection>
                            <RotateTransform Angle="180" />
                          </TransformCollection>
                        </TransformGroup.Children>
                      </TransformGroup>
                    </FrameworkElement.LayoutTransform>
                    <Ellipse Name="circle" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFA9A9A9" />
                    <Path Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,1.5 L4.5,5 L8,1.5" SnapsToDevicePixels="False" Stroke="#666" StrokeThickness="2" />
                  </Grid>
                  <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="arrow" Property="Path.Data" Value="M1,4.5 L4.5,1 L8,4.5" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF3C7FB1" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#222" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF526C7B" />
                  <Setter TargetName="circle" Property="Shape.StrokeThickness" Value="1.5" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#FF003366" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderLeftHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Padding="{TemplateBinding Control.Padding}">
                <Grid Background="#00FFFFFF" SnapsToDevicePixels="False">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="19" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <Grid>
                    <FrameworkElement.LayoutTransform>
                      <TransformGroup>
                        <TransformGroup.Children>
                          <TransformCollection>
                            <RotateTransform Angle="90" />
                          </TransformCollection>
                        </TransformGroup.Children>
                      </TransformGroup>
                    </FrameworkElement.LayoutTransform>
                    <Ellipse Name="circle" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFA9A9A9" />
                    <Path Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,1.5 L4.5,5 L8,1.5" SnapsToDevicePixels="False" Stroke="#666" StrokeThickness="2" />
                  </Grid>
                  <ContentPresenter Grid.Row="1" Margin="0,4,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="arrow" Property="Path.Data" Value="M1,4.5 L4.5,1 L8,4.5" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF3C7FB1" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#222" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FF526C7B" />
                  <Setter TargetName="circle" Property="Shape.StrokeThickness" Value="1.5" />
                  <Setter TargetName="arrow" Property="Shape.Stroke" Value="#FF003366" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderHeaderFocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Border>
                <Rectangle Margin="0" SnapsToDevicePixels="True" Stroke="#FF000000" StrokeDashArray="1 2" StrokeThickness="1" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderDownHeaderStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ToggleButton}">
              <Border Padding="{TemplateBinding Control.Padding}">
                <Grid Background="#00FFFFFF" SnapsToDevicePixels="False">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="19" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse Name="circle" Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFA9A9A9" />
                  <Path Name="arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M1,1.5 L4.5,5 L8,1.5" SnapsToDevicePixels="False" Stroke="#666" StrokeThickness="2" />
                  <ContentPresenter Grid.Column="1" Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="True" />
                </Grid>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="true">
                  <Setter TargetName="arrow" Property="Path.Data" Value="M1,4.5 L4.5,1 L8,4.5" />
                  <Setter TargetName="circle" Value="{DynamicResource WindowFrameBackground}" Property="Shape.Stroke" />
                  <Setter TargetName="arrow" Value="{DynamicResource ToolHeaderground}" Property="Shape.Stroke" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="circle" Value="{DynamicResource HighlightAndAccent}" Property="Shape.Stroke" />
                  <Setter TargetName="arrow" Value="{DynamicResource TextBoxAndFrameBackground}" Property="Shape.Stroke" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="circle" Property="Shape.Stroke" Value="#FFFFFFFF" />
                  <Setter TargetName="circle" Property="Shape.StrokeThickness" Value="1.5" />
                  <Setter TargetName="arrow" Value="{DynamicResource HighlightAndAccent}" Property="Shape.Stroke" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ExpanderStylePrimary" TargetType="{x:Type Expander}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Expander}">
              <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="3" SnapsToDevicePixels="True">
                <DockPanel>
                  <ToggleButton Name="HeaderSite" MinWidth="0" MinHeight="0" Margin="1" Padding="{TemplateBinding Control.Padding}" HorizontalContentAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding HeaderedContentControl.Header}" ContentTemplate="{TemplateBinding HeaderedContentControl.HeaderTemplate}" ContentTemplateSelector="{TemplateBinding HeaderedContentControl.HeaderTemplateSelector}" DockPanel.Dock="Top" FontFamily="{TemplateBinding Control.FontFamily}" FontSize="{TemplateBinding Control.FontSize}" FontStretch="{TemplateBinding Control.FontStretch}" FontStyle="{TemplateBinding Control.FontStyle}" FontWeight="{TemplateBinding Control.FontWeight}" Foreground="{TemplateBinding Control.Foreground}" FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}" Style="{StaticResource ExpanderDownHeaderStyle}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                  <ContentPresenter Name="ExpandSite" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" DockPanel.Dock="Bottom" Focusable="False" Visibility="Collapsed" />
                </DockPanel>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Expander.IsExpanded" Value="True">
                  <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="Expander.ExpandDirection" Value="Right">
                  <Setter TargetName="ExpandSite" Property="DockPanel.Dock" Value="Right" />
                  <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Left" />
                  <Setter TargetName="HeaderSite" Property="Style" Value="{StaticResource ExpanderRightHeaderStyle}" />
                </Trigger>
                <Trigger Property="Expander.ExpandDirection" Value="Up">
                  <Setter TargetName="ExpandSite" Property="DockPanel.Dock" Value="Top" />
                  <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Bottom" />
                  <Setter TargetName="HeaderSite" Property="Style" Value="{StaticResource ExpanderUpHeaderStyle}" />
                </Trigger>
                <Trigger Property="Expander.ExpandDirection" Value="Left">
                  <Setter TargetName="ExpandSite" Property="DockPanel.Dock" Value="Left" />
                  <Setter TargetName="HeaderSite" Property="DockPanel.Dock" Value="Right" />
                  <Setter TargetName="HeaderSite" Property="Style" Value="{StaticResource ExpanderLeftHeaderStyle}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <DockPanel ScrollViewer.VerticalScrollBarVisibility="Disabled">
      <TextBlock Margin="10" VerticalAlignment="Top" DockPanel.Dock="Top" Text="{x:Static localization:Strings.ThemePickerText}" TextWrapping="Wrap" />
      <DockPanel Width="Auto" Margin="0" Dock="Top">
        <StackPanel Margin="5,0,0,0" DockPanel.Dock="Top">
          <DockPanel Height="Auto" Margin="0,10,0,2">
            <TextBlock Margin="5,0" VerticalAlignment="Center" Text="{x:Static localization:Strings.CustomHighlightAccentColor}" Width="{Binding ActualWidth, ElementName=TextBlock1, Mode=Default}" />
            <Button Name="BtnResetHighlightColor" Margin="0,0,5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Panel.ZIndex="-1" Content="{x:Static localization:Strings.Reset}" DockPanel.Dock="Right" Style="{DynamicResource ButtonStyleColored}" Template="{DynamicResource CS4ButtonRounded}" BorderBrush="{x:Null}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <command:EventToCommand Command="{Binding CommandResetHightlightAccentColor}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Button>
            <Border Margin="0,0,5,0" HorizontalAlignment="Stretch" BorderBrush="#FF000000" BorderThickness="1">
              <Grid>
                <i:Interaction.Triggers>
                  <ei:DataTrigger Value="false" Binding="{Binding IsOpen, ElementName=PopupViewPortBackground1}">
                    <command:EventToCommand Command="{Binding CommandApplyCustomColorTheme}" />
                  </ei:DataTrigger>
                </i:Interaction.Triggers>
                <Border Width="Auto" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="{x:Static localization:Strings.ClickToAdjustViewportBackground}" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" DataContext="{Binding HighlightAndAccentColorPickerVM}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                      <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="PopupViewPortBackground1" Value="True" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                  <Popup Name="PopupViewPortBackground1" AllowsTransparency="True" HorizontalOffset="10" StaysOpen="False" VerticalOffset="5">
                    <Border Width="Auto" Height="Auto" Background="{DynamicResource WindowFrameBackground}" BorderBrush="{DynamicResource TextBoxAndFrameBackground}" BorderThickness="1">
                      <DockPanel Margin="5" Background="#FFFFFFFF">
                        <local:ColorPickerView DockPanel.Dock="Top" />
                      </DockPanel>
                    </Border>
                  </Popup>
                </Border>
              </Grid>
            </Border>
          </DockPanel>
          <DockPanel Height="Auto" Margin="0,10,0,2">
            <TextBlock Name="TextBlock1" Width="180" Margin="5,0" VerticalAlignment="Center" Text="{x:Static localization:Strings.ViewportBackgroundColor}" />
            <Button Name="BtnResetViewportColor" Margin="0,0,5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Panel.ZIndex="-1" Content="{x:Static localization:Strings.Reset}" DockPanel.Dock="Right" Style="{DynamicResource ButtonStyleColored}" Template="{DynamicResource CS4ButtonRounded}" BorderBrush="{x:Null}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <command:EventToCommand Command="{Binding CommandResetViewPortBackgroundColor}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Button>
            <Border Margin="0,0,5,0" BorderBrush="#FF000000" BorderThickness="1">
              <Grid>
                <i:Interaction.Triggers>
                  <ei:DataTrigger Value="false" Binding="{Binding IsOpen, ElementName=PopupViewPortBackground}">
                    <command:EventToCommand Command="{Binding CommandSetViewPortBackgroundColor}" />
                  </ei:DataTrigger>
                </i:Interaction.Triggers>
                <Border Width="Auto" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="{x:Static localization:Strings.ClickToAdjustViewportBackground}" Background="{Binding SelectedColor, Converter={StaticResource ColorToBrushConverter}}" DataContext="{Binding ViewPortBackgroundColorPickerVM}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonUp">
                      <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="PopupViewPortBackground" Value="True" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                  <Popup Name="PopupViewPortBackground" AllowsTransparency="True" HorizontalOffset="10" StaysOpen="False" VerticalOffset="5">
                    <Border Width="Auto" Height="Auto" Background="{DynamicResource WindowFrameBackground}" BorderBrush="{DynamicResource TextBoxAndFrameBackground}" BorderThickness="1">
                      <DockPanel Margin="5" Background="#FFFFFFFF">
                        <local:ColorPickerView DockPanel.Dock="Top" />
                      </DockPanel>
                    </Border>
                  </Popup>
                </Border>
              </Grid>
            </Border>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{x:Static localization:Strings.ViewportGraphic}" TextWrapping="Wrap" Width="{Binding ActualWidth, ElementName=TextBlock1, Mode=Default}" />
            <Button Name="BtnResetViewportGraphic" Margin="0,0,5,0" VerticalAlignment="Center" VerticalContentAlignment="Center" Panel.ZIndex="-1" Content="{x:Static localization:Strings.Reset}" DockPanel.Dock="Right" Style="{DynamicResource ButtonStyleColored}" Template="{DynamicResource CS4ButtonRounded}" BorderBrush="{x:Null}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <command:EventToCommand Command="{Binding CommandResetViewPortGraphic}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </Button>
            <Border Margin="5,0" VerticalAlignment="Center" BorderBrush="#FF000000" BorderThickness="1">
              <TextBlock Name="TxtViewportGraphicPath" Padding="0,5,0,0" Cursor="Hand" TextTrimming="CharacterEllipsis" ToolTip="{x:Static localization:Strings.ClickToSetPathForImage}" Text="{Binding ViewPortBackgroundPath}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="MouseLeftButtonUp">
                    <command:EventToCommand Command="{Binding CommandSetViewPortBackground}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </TextBlock>
            </Border>
          </DockPanel>
          <DockPanel Margin="0,10,0,0">
            <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{x:Static localization:Strings.StretchImage}" TextWrapping="Wrap" Width="{Binding ActualWidth, ElementName=TextBlock1, Mode=Default}" />
            <CheckBox Margin="5,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" VerticalContentAlignment="Center" Panel.ZIndex="-1" DockPanel.Dock="Right" BorderBrush="{x:Null}" IsChecked="{Binding IsViewportBitmapStretched}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <command:EventToCommand Command="{Binding CommandViewportBitmapStretchedChanged}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
            </CheckBox>
          </DockPanel>
          <Button Margin="0,2,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{x:Static localization:Strings.ResetTheme}" Cursor="Hand" Style="{DynamicResource ButtonStyleColored}" Template="{DynamicResource CS4ButtonRounded}" ToolTip="{x:Static localization:Strings.ClickToResetTheme}" BorderBrush="{x:Null}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="Click">
                <command:EventToCommand Command="{Binding CommandResetThemes}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Button>
        </StackPanel>
      </DockPanel>
    </DockPanel>
    <Border Margin="-2" Background="{DynamicResource TextBoxAndFrameBackground}" BorderThickness="1" CornerRadius="3" Opacity="0.5" Visibility="Hidden">
      <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="21.333" Text="{x:Static localization:Strings.Please_Wait}" TextWrapping="Wrap" />
      </Grid>
    </Border>
  </Grid>
</UserControl>