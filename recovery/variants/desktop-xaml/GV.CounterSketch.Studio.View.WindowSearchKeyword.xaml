              <Path Canvas.Left="3.41189" Canvas.Top="11.0806" Width="10.8498" Height="5.91937" Data="F1 M14.2616,16.5087 L14.2579,16.5059 L14.2579,11.0806 L3.413,11.0806 L3.413,16.4732 L3.41189,16.4739 L3.41189,17 L3.413,17 L14.2579,17 L14.2616,17 L14.2616,16.5087" Fill="#FF808080" Stretch="Fill" />
            </Canvas>
          </Viewbox>
        </Button>
        <Border Background="#FFB9B9B9" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="2">
          <TextBlock HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static l:Strings.DisplayKeywords}" />
        </Border>
      </DockPanel>
      <Border Margin="10,0,10,10" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="2" DockPanel.Dock="Top">
        <ListBox Name="KeywordsListBox" ItemTemplate="{DynamicResource DataTemplateKeyword}" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel IsItemsHost="True" Orientation="Vertical" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ListBox>
      </Border>
    </DockPanel>
  </Grid>
</Window>