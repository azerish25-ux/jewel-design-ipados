            <ListBox Height="242" Margin="0" IsSynchronizedWithCurrentItem="False" ItemContainerStyle="{DynamicResource ListBoxItemStyle1}" ItemTemplate="{DynamicResource DataTemplate1}" ItemsPanel="{DynamicResource ItemsPanelTemplate1}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="False" ItemsSource="{Binding PreferenceMaterialsVM.GemMaterialOptionItems, Source={StaticResource Locator}}" />
          </StackPanel>
        </DockPanel>
      </TabItem>
      <TabItem Name="TabItemOrderSummary" Header="{x:Static l:Strings.Order}" Style="{DynamicResource SimpleTabItem}" Background="{x:Null}">
        <DockPanel Margin="5">
          <ListView Margin="5" BorderThickness="0" DockPanel.Dock="Top" Foreground="#FF000000" ItemsSource="{Binding Source={StaticResource OrderSummaryItems}}">
            <ListView.View>
              <GridView>
                <GridViewColumn Header="{x:Static l:Strings.Hide}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="common:OrderSummaryPrefItemModel">
                      <CheckBox IsChecked="{Binding IsDisabled}" Visibility="{Binding IsCheckBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Width="500" Header="{x:Static l:Strings.Title}" DisplayMemberBinding="{Binding TranslatedTitle}" />
                <GridViewColumn Width="100" Header="{x:Static l:Strings.IsDefault}">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="common:OrderSummaryPrefItemModel">
                      <RadioButton GroupName="{Binding Section}" IsChecked="{Binding IsDefault}" Visibility="{Binding IsRadioButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <Border Margin="0,5,0,0" BorderBrush="#FF737373" BorderThickness="0,0,0,1">
                      <StackPanel Margin="0,2" Orientation="Horizontal">
                        <CheckBox Margin="0,0,5,0" IsChecked="{Binding Name, Converter={StaticResource SectionNameToDisabledBooleanConverter}, Mode=OneWay}">
                          <i:Interaction.Triggers>
                            <i:EventTrigger EventName="Checked">
                              <i:InvokeCommandAction Command="{Binding PreferenceOrderScreenVM.CommandToggleSection, Source={StaticResource Locator}}" CommandParameter="{Binding Name}" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="Unchecked">
                              <i:InvokeCommandAction Command="{Binding PreferenceOrderScreenVM.CommandToggleSection, Source={StaticResource Locator}}" CommandParameter="{Binding Name}" />
                            </i:EventTrigger>
                          </i:Interaction.Triggers>
                        </CheckBox>
                        <TextBlock FontSize="14" Foreground="#FF343434" Text="{Binding Name}" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
          </ListView>
        </DockPanel>
      </TabItem>
      <TabItem Name="TabItemRegionSetting" Height="21.96" VerticalAlignment="Bottom" Header="{x:Static l:Strings.Region}" Style="{DynamicResource SimpleTabItem}" Background="{x:Null}">
        <StackPanel VerticalAlignment="Top">
          <StackPanel Margin="5,0,5,10" Orientation="Vertical">
            <TextBlock Margin="0,5" FontSize="16" Text="{x:Static l:Strings.RingSizeSettings}" TextWrapping="Wrap" />
            <Border Margin="10,5,10,10" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <DockPanel Margin="5">
                <TextBlock VerticalAlignment="Center" Text="{x:Static l:Strings.SelectRingSizeRegion}" TextWrapping="Wrap" />
                <ComboBox Name="CboRingSize" Width="250" Margin="25,0,0,0" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{DynamicResource CSComboBoxStyleBasic}" />
              </DockPanel>
            </Border>
            <TextBlock Margin="0,5" FontSize="16" Text="{x:Static l:Strings.CurrencySettings}" TextWrapping="Wrap" />
            <Border Margin="10,5,10,10" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <DockPanel Margin="5">
                <TextBlock VerticalAlignment="Center" Text="{x:Static l:Strings.SelectDesiredCurrency}" TextWrapping="Wrap" />
                <ComboBox Name="CboCurrencyType" Width="250" Margin="25,0,0,0" HorizontalAlignment="Right" DockPanel.Dock="Right" Style="{DynamicResource CSComboBoxStyleBasic}" ItemsSource="{Binding Converter={StaticResource EnumToDescriptionConverter}, Mode=OneWay, Source={StaticResource CurrencyEnumValues}}" />
              </DockPanel>
            </Border>
            <StackPanel Name="StackPanelLanguages" Orientation="Vertical" Visibility="Collapsed">
              <TextBlock Margin="0,5" FontSize="16" Text="{x:Static l:Strings.LanguageSettings}" TextWrapping="Wrap" Visibility="Visible" />
              <Border Margin="10,5,10,10" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1" Visibility="Visible">
                <DockPanel Margin="5">
                  <TextBlock VerticalAlignment="Center" Text="{x:Static l:Strings.SelectedDesiredLanguage}" TextWrapping="Wrap" />
                  <ComboBox Name="CboLanguage" Width="250" Margin="25,0,0,0" HorizontalAlignment="Right" DockPanel.Dock="Right" ItemTemplate="{DynamicResource DataTemplateLanguages}" SelectedIndex="0" Style="{DynamicResource CSComboBoxStyleBasic}" />
                </DockPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Name="TabItemTheme" Header="{x:Static l:Strings.Theme}" ScrollViewer.CanContentScroll="True" Style="{DynamicResource SimpleTabItem}" Visibility="Visible" Background="{x:Null}">
        <i:Interaction.Triggers>
          <ei:DataTrigger Value="True" Binding="{Binding IsSelected, ElementName=TabItemTheme}">
            <command:EventToCommand Command="{Binding ThemePickerVM.CommandGetAvailableThemes, Source={StaticResource Locator}}" />
          </ei:DataTrigger>
        </i:Interaction.Triggers>
        <DockPanel LastChildFill="False">
          <StackPanel Margin="5,5,0,0" Orientation="Vertical">
            <TextBlock Margin="0,0,0,10" Padding="0" FontSize="16" Text="{x:Static l:Strings.Theme}" />
            <Border BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Margin="10">
                <gvCounterSketchStudioView:ThemePickerView x:Name="ThemePickerView" DataContext="{Binding ThemePickerVM, Source={StaticResource Locator}}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </TabItem>
      <TabItem Name="TabItemUpdate" Header="{x:Static l:Strings.Update}" Style="{DynamicResource SimpleTabItem}" Background="{x:Null}">
        <StackPanel VerticalAlignment="Top">
          <DockPanel Margin="5,0,5,10" LastChildFill="False">
            <StackPanel Margin="0,0,5,0">
              <TextBlock Margin="0,5,-4,5" FontSize="16" Text="{x:Static l:Strings.DesignLibrary}" TextWrapping="Wrap" />
              <Border Margin="10,5,10,10" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
                <StackPanel Name="PnlDesigns" Orientation="Vertical">
                  <DockPanel Margin="10,10,15,10">
                    <Button Name="BtnImportLibrary" Width="100" Height="20" Margin="10,0" Content="{x:Static l:Strings.ImportDesigns}" DockPanel.Dock="Right" Style="{DynamicResource CSButtonPlain}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnImportLibraryClick" />
                    <TextBlock Width="131.3" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static l:Strings.UseTheImportButtonToAddDesigns}" TextWrapping="WrapWithOverflow" />
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>
          <StackPanel Margin="5,0,5,10" Orientation="Vertical" />
          <StackPanel Margin="5,0,5,10" Orientation="Vertical">
            <TextBlock Margin="0,5" FontSize="16" Text="{x:Static l:Strings.ApplicationUpdateMode}" TextWrapping="Wrap" />
            <Border Margin="10" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Name="PnlApplication" Margin="0,10" Orientation="Vertical">
                <DockPanel Name="PnlUpdateMode" Margin="10,0,15,0">
                  <Button Name="BtnUpdateApplication" Height="20" Margin="10,0" Padding="5,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static l:Strings.UpdateAll}" FontFamily="Helvetica Neue LT Std" Style="{DynamicResource CSButtonPlain}" Click="BtnUpdateApplicationClick" />
                  <CheckBox Name="checkBoxUseStullerServer" />
                  <TextBlock Margin="5,0,0,0" VerticalAlignment="Center" Text="{x:Static l:Strings.UseLegacyUpdateServer}" TextWrapping="Wrap" />
                </DockPanel>
                <StackPanel Name="PnlExplanation" Margin="10,0,120,10">
                  <TextBlock Name="TxtUpdateModeExplanation" Height="75" Margin="0,5,0,0" FontSize="10.667" Text="{x:Static l:Strings.UpdateModeAutomaticExplanation}" TextWrapping="Wrap" />
                </StackPanel>
                <DockPanel Name="PnlVersion" Margin="10,0,20,10" LastChildFill="False">
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.667" Text="{x:Static l:Strings.YourVersion}" TextWrapping="Wrap" />
                  <TextBlock Name="TxtCurrentVersion" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.667" Text="1.0.0.0" TextWrapping="Wrap" />
                  <TextBlock Margin="30,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.667" Text="{x:Static l:Strings.LatestVersion}" TextWrapping="Wrap" />
                  <TextBlock Name="TxtLatestVersion" Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.667" Text="2.0.0.0" TextWrapping="Wrap" />
                </DockPanel>
                <TextBlock Name="TxtUpdateProgressText" Margin="0,0,20,6" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10.667" TextWrapping="Wrap" Visibility="Collapsed" />
                <ProgressBar Name="ProUpdateProgressBar" Width="100" Height="10" Margin="0,0,21,0" HorizontalAlignment="Right" Foreground="{DynamicResource csHighlightGradientBrush}" IsIndeterminate="True" Visibility="Collapsed" />
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </TabItem>
      <TabItem Name="TabItemBackupRecovery" Header="Portfolio" Style="{DynamicResource SimpleTabItem}" Background="{x:Null}">
        <DockPanel Margin="0">
          <gvCounterSketchStudioView:BackupRestoreView x:Name="BackupRestore" DockPanel.Dock="Top" />
          <TextBlock Margin="5,0,0,0" DockPanel.Dock="Top" FontSize="16" Text="{x:Static l:Strings.TimedBackup}" TextWrapping="Wrap" />
          <Border Margin="15,10,10,10" Padding="5" BorderBrush="{DynamicResource BaseBackground}" BorderThickness="1" DockPanel.Dock="Top">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <CheckBox Content="{x:Static l:Strings.EnableTimedBackup}" IsChecked="{Binding MainVM.IsTimedBackupEnabled, Source={StaticResource Locator}}" />
              <StackPanel Margin="50,0,0,0" Orientation="Horizontal">
                <TextBlock Name="textBlock" VerticalAlignment="Center" Text="{x:Static l:Strings.BackupInterval}" TextWrapping="Wrap" />
                <TextBox MinWidth="50" Margin="10,0,0,0" HorizontalContentAlignment="Center" FontSize="10.667" TextAlignment="Right" Text="{Binding MainVM.TimedBackupSeconds, Source={StaticResource Locator}}" />
              </StackPanel>
            </StackPanel>
          </Border>
        </DockPanel>
      </TabItem>
      <TabItem Name="TabItemTroubleShooting" Header="{x:Static l:Strings.Troubleshooting}" Style="{DynamicResource SimpleTabItem}" Background="{x:Null}">
        <DockPanel VerticalAlignment="Top">
          <StackPanel Margin="5,0,5,0" Orientation="Vertical" ScrollViewer.VerticalScrollBarVisibility="Disabled">
            <TextBlock Margin="0,5,0,0" FontSize="16" Text="{x:Static l:Strings.Troubleshooting}" TextWrapping="Wrap" />
            <Border Margin="10" BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Margin="5" Orientation="Vertical">
                <TextBlock Height="40" Margin="5" FontSize="10.667" Text="{x:Static l:Strings.TroubleshootingExplanation}" TextWrapping="Wrap" />
                <StackPanel Margin="25,0" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                  <CheckBox Name="ChkDisableMultiCoreRendering">
                    <TextBlock Margin="5,0,15,0" VerticalAlignment="Center" FontSize="10.667" Text="{x:Static l:Strings.DisableMultiCoreGeneration}" TextWrapping="Wrap" />
                  </CheckBox>
                  <Button Name="BtnShowLog" Width="150" Height="22" Padding="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:Strings.ShowCounterSketchLog}" Cursor="Hand" Style="{DynamicResource CSButton}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnShowLogClick" />
                  <Button Name="BtnLaunchTroubleShooter" Width="150" Height="22" Margin="50,0,0,0" Padding="1" VerticalAlignment="Center" BorderThickness="1" Content="{x:Static l:Strings.LaunchTroubleshooter}" Cursor="Hand" Style="{DynamicResource CSButton}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnLaunchTroubleShooterClick" />
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,20,0,0" FontSize="16" Text="{x:Static l:Strings.SupportDiagnostics}" TextWrapping="Wrap" />
            <Border Margin="10" BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Margin="5" VerticalAlignment="Top">
                <TextBlock Margin="5" Padding="0,5,0,0" VerticalAlignment="Top" Text="{x:Static l:Strings.SupportExplanation}" TextWrapping="Wrap" />
                <Border Height="150.9" Margin="5" VerticalAlignment="Top" BorderBrush="{DynamicResource BaseBackground}" BorderThickness="1">
                  <TextBox Name="TxtDebugComments" Width="673" AcceptsReturn="True" AcceptsTab="True" AutoWordSelection="True" CaretBrush="{DynamicResource HighlightAndAccent}" TextWrapping="Wrap">
                    <Control.Foreground>
                      <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                    </Control.Foreground>
                  </TextBox>
                </Border>
                <Grid Margin="5">
                  <StackPanel Name="PnlSupportInfo" HorizontalAlignment="Left">
                    <TextBlock Name="TxtSupportHours" VerticalAlignment="Bottom" Text="-------" TextWrapping="Wrap" />
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                      <TextBlock HorizontalAlignment="Left" Text="{x:Static l:Strings.CallSupport}" TextWrapping="Wrap" />
                      <TextBlock Name="TxtSupportPhone" HorizontalAlignment="Left" Text="111.222.3333" TextWrapping="Wrap">
                        <TextBlock.Foreground>
                          <SolidColorBrush Color="{DynamicResource HighlightAndAccentColor}" />
                        </TextBlock.Foreground>
                      </TextBlock>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal">
                      <TextBlock Name="TxtSupportEmailLabel" HorizontalAlignment="Left" Text="{x:Static l:Strings.EmailSupport}" TextWrapping="Wrap" />
                      <TextBlock Name="TxtSupportEmail" HorizontalAlignment="Left" Cursor="Hand" Text="countersketch@gemvision.com" TextWrapping="Wrap" MouseLeftButtonDown="TxtSupportEmailMouseLeftButtonDown">
                        <TextBlock.Foreground>
                          <SolidColorBrush Color="{DynamicResource HighlightAndAccentColor}" />
                        </TextBlock.Foreground>
                      </TextBlock>
                    </StackPanel>
                  </StackPanel>
                  <Button Name="BtnSubmitDebugReport" Width="140" Height="22" Margin="0,10,0,5" Padding="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:Strings.SubmitDebugReport}" Cursor="Hand" Style="{DynamicResource CSButton}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnSubmitDebugReportClick" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>