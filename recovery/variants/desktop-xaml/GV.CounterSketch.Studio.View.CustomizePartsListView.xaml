<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.CustomizePartsListView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:attachedBehaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.AttachedBehaviors" xmlns:behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:objects1="clr-namespace:GV.CounterSketch.Shared.Model.Objects;assembly=CounterSketch Studio" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Source={StaticResource Locator}, Path=CustomizePartsListVM}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type dxg:TableDropMarkerControl}" TargetType="{x:Type dxg:TableDropMarkerControl}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type dxg:TableDropMarkerControl}">
              <dx:DXDockPanel Name="panel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False" LastChildFill="True">
                <FrameworkElement.Margin>
                  <Binding Path="DragIndicatorPosition" RelativeSource="{RelativeSource TemplatedParent}">
                    <Binding.Converter>
                      <dx:EnumToObjectConverter DefaultValue="0,0,0,0">
                        <dx:EnumToObjectConverter.Values>
                          <generic:Dictionary xmlns:generic="clr-namespace:System.Collections.Generic;assembly=mscorlib">
                            <dx:EnumObjectProvider x:Key="None" Value="0,0,0,0" />
                            <dx:EnumObjectProvider x:Key="InRow" Value="0,0,0,0" />
                          </generic:Dictionary>
                        </dx:EnumToObjectConverter.Values>
                      </dx:EnumToObjectConverter>
                    </Binding.Converter>
                  </Binding>
                </FrameworkElement.Margin>
                <Border Name="topIndicator" Width="10" HorizontalAlignment="Left" VerticalAlignment="Stretch" DockPanel.Dock="Left" Background="{DynamicResource HighlightAndAccent}" IsHitTestVisible="False">
                  <UIElement.Visibility>
                    <Binding Path="DragIndicatorPosition" RelativeSource="{RelativeSource TemplatedParent}">
                      <Binding.Converter>
                        <dx:EnumToObjectConverter DefaultValue="Collapsed">
                          <dx:EnumToObjectConverter.Values>
                            <Dictionary xmlns="clr-namespace:System.Collections.Generic;assembly=mscorlib">
                              <dx:EnumObjectProvider x:Key="Top" Value="Visible" />
                            </Dictionary>
                          </dx:EnumToObjectConverter.Values>
                        </dx:EnumToObjectConverter>
                      </Binding.Converter>
                    </Binding>
                  </UIElement.Visibility>
                </Border>
                <Border Name="bottomIndicator" Width="10" HorizontalAlignment="Right" VerticalAlignment="Stretch" DockPanel.Dock="Right" Background="{DynamicResource HighlightAndAccent}" IsHitTestVisible="False">
                  <UIElement.Visibility>
                    <Binding Path="DragIndicatorPosition" RelativeSource="{RelativeSource TemplatedParent}">
                      <Binding.Converter>
                        <dx:EnumToObjectConverter DefaultValue="Collapsed">
                          <dx:EnumToObjectConverter.Values>
                            <Dictionary xmlns="clr-namespace:System.Collections.Generic;assembly=mscorlib">
                              <dx:EnumObjectProvider x:Key="Bottom" Value="Visible" />
                            </Dictionary>
                          </dx:EnumToObjectConverter.Values>
                        </dx:EnumToObjectConverter>
                      </Binding.Converter>
                    </Binding>
                  </UIElement.Visibility>
                </Border>
                <Border Name="inRowIndicator" IsHitTestVisible="False" Opacity="0.2">
                  <UIElement.Visibility>
                    <Binding Path="DragIndicatorPosition" RelativeSource="{RelativeSource TemplatedParent}">
                      <Binding.Converter>
                        <dx:EnumToObjectConverter DefaultValue="Collapsed">
                          <dx:EnumToObjectConverter.Values>
                            <Dictionary xmlns="clr-namespace:System.Collections.Generic;assembly=mscorlib">
                              <dx:EnumObjectProvider x:Key="InRow" Value="Visible" />
                              <dx:EnumObjectProvider x:Key="None" Value="Visible" />
                            </Dictionary>
                          </dx:EnumToObjectConverter.Values>
                        </dx:EnumToObjectConverter>
                      </Binding.Converter>
                    </Binding>
                  </UIElement.Visibility>
                  <Border.Background>
                    <Binding Path="DragIndicatorPosition" RelativeSource="{RelativeSource TemplatedParent}">
                      <Binding.Converter>
                        <dx:EnumToObjectConverter DefaultValue="#00FFFFFF">
                          <dx:EnumToObjectConverter.Values>
                            <Dictionary xmlns="clr-namespace:System.Collections.Generic;assembly=mscorlib">
                              <dx:EnumObjectProvider x:Key="InRow" Value="#FF2DB2FF" />
                              <dx:EnumObjectProvider x:Key="None" Value="#FF89C841" />
                            </Dictionary>
                          </dx:EnumToObjectConverter.Values>
                        </dx:EnumToObjectConverter>
                      </Binding.Converter>
                    </Binding>
                  </Border.Background>
                </Border>
              </dx:DXDockPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplatePartsList">
        <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="FreehandParent">
        <Grid>
          <Border Width="65" Height="50" HorizontalAlignment="Left" BorderBrush="#FFCCC6C1" BorderThickness="1">
            <Image Stretch="Fill" Source="{Binding ImportGroupBitmapImage, Converter={StaticResource NullObjectToDoNothingConverter}}" />
          </Border>
        </Grid>
      </DataTemplate>
      <ControlTemplate x:Key="ButtonPartsPanel" TargetType="{x:Type ButtonBase}">
        <Border Name="border" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True" Background="{x:Null}">
          <ContentPresenter Name="contentPresenter" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Focusable="False" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Button.IsDefaulted" Value="True" />
          <Trigger Property="UIElement.IsMouseOver" Value="True" />
          <Trigger Property="ButtonBase.IsPressed" Value="True" />
          <Trigger Property="ToggleButton.IsChecked" Value="True" />
          <Trigger Property="UIElement.IsEnabled" Value="False" />
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <DataTemplate x:Key="PartListItem">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="58*" />
            <RowDefinition Height="17*" />
          </Grid.RowDefinitions>
          <TextBlock Grid.RowSpan="2" Text="{Binding Name}" />
          <Image Grid.RowSpan="2" Width="75" Height="75" Margin="1,1,-1,0" VerticalAlignment="Top" Stretch="Fill" Source="{Binding ImportGroupBitmapImage, Converter={StaticResource NullObjectToDoNothingConverter}}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="ItemControlElementImportGroupItem">
        <Grid>
          <Border Width="75" Height="75" Background="#FFBDBDBD">
            <Image Width="75" Height="75" Margin="0" VerticalAlignment="Center" Stretch="Fill" Source="{Binding ParentPart.ImportGroupBitmapImage, Converter={StaticResource NullObjectToDoNothingConverter}}" />
          </Border>
        </Grid>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="PartListItemPanel">
        <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="PartListBoxItem" DataType="objects1:ImportGroup">
        <Grid Width="90" Height="90">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeftButtonUp">
              <command:EventToCommand Command="{Binding CustomizePartsListVM.CommandSelectedImportGroup, Source={StaticResource Locator}}" CommandParameter="{Binding Identifier}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Border Background="{Binding SelectedColor}" Opacity="{Binding IsSelectedImportGroup, Converter={StaticResource BooleanToOpacityConverter}}" />
          <DockPanel>
            <TextBlock Width="Auto" Height="15" HorizontalAlignment="Center" DockPanel.Dock="Top" Text="{Binding Name, FallbackValue=ItemName}" />
            <Image Width="75" Height="75" Margin="0" VerticalAlignment="Stretch" Stretch="Fill" Source="{Binding ImportGroupBitmapImage, Converter={StaticResource NullObjectToDoNothingConverter}}" />
          </DockPanel>
        </Grid>
      </DataTemplate>
      <SolidColorBrush x:Key="Item.MouseOver.Background" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="Item.MouseOver.Border" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="Item.SelectedInactive.Background" Color="#00ffffff" />
      <SolidColorBrush x:Key="Item.SelectedInactive.Border" Color="#00ffffff" />
      <SolidColorBrush x:Key="Item.SelectedActive.Background" Color="#00FFFFFF" />
      <SolidColorBrush x:Key="Item.SelectedActive.Border" Color="#00ffffff" />
      <Style x:Key="PartsListContainerTemplate" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsMouseOver" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.MouseOver.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.MouseOver.Border}" />
                </MultiTrigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="Selector.IsSelectionActive" Value="False" />
                    <Condition Property="ListBoxItem.IsSelected" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.SelectedInactive.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.SelectedInactive.Border}" />
                </MultiTrigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="Selector.IsSelectionActive" Value="True" />
                    <Condition Property="ListBoxItem.IsSelected" Value="True" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="Bd" Property="Border.Background" Value="{StaticResource Item.SelectedActive.Background}" />
                  <Setter TargetName="Bd" Property="Border.BorderBrush" Value="{StaticResource Item.SelectedActive.Border}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="TextElement.Foreground" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="ImportGroupItem">
        <Grid />
      </DataTemplate>
      <ItemsPanelTemplate x:Key="PartsListItemPanel">
        <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="ImportGroupDataTemplate" DataType="objects1:ImportGroup">
        <DockPanel>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseEnter">
              <command:EventToCommand Command="{Binding CustomizePartsListVM.CommandHighlightImportGroup, Source={StaticResource Locator}}" CommandParameter="{Binding}" />
            </i:EventTrigger>
            <i:EventTrigger EventName="MouseLeave">
              <command:EventToCommand Command="{Binding CustomizePartsListVM.CommandHighlightImportGroup, Source={StaticResource Locator}}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Grid Width="155" Height="155">
            <Grid.RowDefinitions>
              <RowDefinition Height="7*" />
              <RowDefinition Height="24*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.RowSpan="2" Width="Auto" Height="Auto" Margin="0" Background="#FFFFFFFF">
              <TextBlock Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand" DockPanel.Dock="Bottom" FontSize="10" Foreground="#FF000000" TextAlignment="Center" ToolTip="{x:Static l:Strings.ClickToRename}" Text="{Binding Name, FallbackValue=PartName}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="PreviewMouseUp">
                    <command:EventToCommand Command="{Binding CustomizePartsListVM.CommandShowRenamePrompt, Source={StaticResource Locator}}" CommandParameter="{Binding Identifier}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </TextBlock>
              <Image Width="Auto" Height="Auto" Margin="0,4,0,0" VerticalAlignment="Stretch" DockPanel.Dock="Top" Stretch="UniformToFill" Opacity="{Binding IsViewportVisible, ConverterParameter=0.15, Converter={StaticResource BooleanToVariableOpacityConverter}}" Source="{Binding ImportGroupBitmapImage, Converter={StaticResource NullObjectToDoNothingConverter}}" />
            </DockPanel>
            <Border Grid.RowSpan="2" Margin="0,4,0,0" BorderBrush="{DynamicResource HighlightAndAccent}" BorderThickness="3" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <wpf:ImageAwesome Grid.RowSpan="2" FrameworkElement.Width="75" FrameworkElement.Height="75" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" ImageAwesome.Foreground="{DynamicResource HighlightAndAccent}" xmlns:wpf="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" wpf:ImageAwesome.Icon="EyeSlash" UIElement.Visibility="{Binding IsViewportVisible, ConverterParameter=true, Converter={StaticResource BooleanToVisibilityHiddenConverter}}" />
          </Grid>
        </DockPanel>
      </DataTemplate>
      <SolidColorBrush x:Key="Item.MouseOver.Background2" Color="#00ffffff" />
      <SolidColorBrush x:Key="Item.MouseOver.Border2" Color="#00ffffff" />
      <SolidColorBrush x:Key="Item.SelectedActive.Background2" Color="#00ffffff" />
      <Style x:Key="ImportGroupContainer" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Viewbox Stretch="Fill">
                <DockPanel Width="Auto" Height="Auto" Margin="0">
                  <DockPanel>
                    <Grid Width="Auto" Height="Auto" HorizontalAlignment="Stretch">
                      <UIElement.RenderTransform>
                        <TransformGroup>
                          <ScaleTransform ScaleX="{Binding XScale}" ScaleY="{Binding YScale}" />
                          <SkewTransform />
                          <RotateTransform />
                          <TranslateTransform Y="{Binding YHeight}" />
                        </TransformGroup>
                      </UIElement.RenderTransform>
                      <StackPanel Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="1">
                        <Grid>
                          <Grid Width="32" Height="32" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="1" Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button IsHitTestVisible="False" Style="{DynamicResource ButtonStyleRoundAction}" Background="{x:Null}" BorderBrush="{x:Null}" Visibility="{Binding IsSelected, ConverterParameter=true, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <ImageAwesome FrameworkElement.Width="Auto" FrameworkElement.Height="Auto" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" p34:ImageAwesome.Foreground="#FF808080" p34:ImageAwesome.Icon="Link" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                          </Grid>
                          <Grid Width="35" Height="35" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Top" ZIndex="1" Visibility="{Binding IsGroup, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Button Background="{DynamicResource HighlightAndAccent}" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.Ungroup}" BorderBrush="{x:Null}" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <command:EventToCommand Command="{Binding CustomizePartsListVM.CommandBreakPartGroup, Source={StaticResource Locator}}" CommandParameter="{Binding Identifier}" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                              <ImageAwesome FrameworkElement.Width="15" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" p34:ImageAwesome.Foreground="#FFF5F5F5" p34:ImageAwesome.Icon="Unlink" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                          </Grid>
                        </Grid>
                      </StackPanel>
                      <Button Width="35" Height="35" Margin="0,5,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="1" Background="#FFA3A3A3" Style="{DynamicResource ButtonStyleRoundAction}" Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="PreviewMouseUp">
                            <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="True" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <ImageAwesome FrameworkElement.Width="20" FrameworkElement.Height="Auto" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" p31:ImageAwesome.Foreground="#FFFFFFFF" p31:ImageAwesome.Icon="Navicon" xmlns:p31="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                      </Button>
                      <Popup Name="ContextPopup" AllowsTransparency="True" HorizontalOffset="-38" Placement="Right" StaysOpen="False" VerticalOffset="1">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="MouseLeave">
                            <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Grid>
                          <Border Height="44" Margin="0,0,0,0" Background="#FFDDDDDD" BorderBrush="#FFA3A3A3" BorderThickness="2" CornerRadius="20" />
                          <StackPanel Orientation="Horizontal">
                            <Button Width="35" Height="35" Margin="4,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}">
                              <UIElement.RenderTransform>
                                <TransformGroup>
                                  <ScaleTransform />
                                  <SkewTransform />
                                  <RotateTransform Angle="90" />
                                  <TranslateTransform />
                                </TransformGroup>
                              </UIElement.RenderTransform>
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                              <ImageAwesome FrameworkElement.Width="20" FrameworkElement.Height="Auto" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Center" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="Navicon" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                            <Button Width="35" Height="35" Margin="2,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.CreateGroup}" Command="{Binding CustomizePartsListVM.CommandAddPartToGroup, Source={StaticResource Locator}}">
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                              <ImageAwesome FrameworkElement.Width="25" FrameworkElement.Height="Auto" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Stretch" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="Link" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                            <Button Width="35" Height="35" Margin="0,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.DuplicateSelected}" Command="{Binding CustomizePartsListVM.CommandDuplicateImportGroup, Source={StaticResource Locator}}">
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                              <ImageAwesome FrameworkElement.Width="25" FrameworkElement.Height="Auto" FrameworkElement.Margin="-2,0,0,0" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Stretch" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="Copy" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                            <Button Width="35" Height="35" Margin="0,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.PrimarySecondaryMetalsSwitch}" Command="{Binding CustomizePartsListVM.CommandTogglePrimarySecondaryMetal, Source={StaticResource Locator}}">
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                              <ImageAwesome FrameworkElement.Width="24" FrameworkElement.Height="Auto" FrameworkElement.HorizontalAlignment="Stretch" FrameworkElement.VerticalAlignment="Center" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="ToggleOn" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                            </Button>
                            <Button Width="35" Height="35" Margin="0,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.Reset}" BorderBrush="{x:Null}" Command="{Binding CustomizePartsListVM.CommandResetPart, Source={StaticResource Locator}}" CommandParameter="{Binding Identifier}">
                              <Viewbox Width="24" Height="24">
                                <Rectangle Width="103" Height="102" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                  <Shape.Fill>
                                    <VisualBrush AlignmentX="Left" Stretch="Uniform" Visual="{DynamicResource FreehandResetPositionIcon}" />
                                  </Shape.Fill>
                                </Rectangle>
                              </Viewbox>
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                            </Button>
                            <Button Width="35" Height="35" Margin="0,0,5,0" Panel.ZIndex="1" Background="#FFA3A3A3" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.ShowHidePart}" BorderBrush="{x:Null}" Command="{Binding CustomizePartsListVM.CommandTogglePartVisibility, Source={StaticResource Locator}}">
                              <ImageAwesome FrameworkElement.Width="25" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="EyeSlash" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                              <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseUp">
                                  <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="ContextPopup" Value="False" />
                                </i:EventTrigger>
                              </i:Interaction.Triggers>
                            </Button>
                            <Button Width="35" Height="35" Margin="0,0,5,0" Panel.ZIndex="1" Background="{DynamicResource HighlightAndAccent}" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.ExportUserPart}" BorderBrush="{x:Null}" Command="{Binding CustomizePartsListVM.CommandExportSelectedImportGroupsToUserParts, Source={StaticResource Locator}}">
                              <ImageAwesome FrameworkElement.Width="25" p34:ImageAwesome.Foreground="#FFFFFFFF" p34:ImageAwesome.Icon="UserPlus" xmlns:p34="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
