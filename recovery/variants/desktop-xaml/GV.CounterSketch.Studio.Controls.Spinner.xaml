<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.Spinner" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="UserControl" Foreground="#FF008000" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="{x:Type Rectangle}" TargetType="{x:Type Rectangle}">
        <Setter Property="Rectangle.RadiusX" Value="5" />
        <Setter Property="Rectangle.RadiusY" Value="5" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Canvas.Left" Value="220" />
        <Setter Property="Canvas.Top" Value="140" />
        <Setter Property="UIElement.Opacity" Value="0.1" />
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding Path=UseHighlightColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <Setter Property="Fill" Value="{DynamicResource HighlightAndAccent}" />
          </DataTrigger>
          <DataTrigger Value="False" Binding="{Binding Path=UseHighlightColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <Setter Property="Fill" Value="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Storyboard x:Key="canvasAnimation" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="grid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
          <DiscreteDoubleKeyFrame KeyTime="00:00:00" Value="0" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.0500000" Value="20" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.1000000" Value="40" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.1500000" Value="60" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.2000000" Value="80" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.2500000" Value="100" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.3000000" Value="120" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.3500000" Value="140" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.4000000" Value="160" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.4500000" Value="180" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.5000000" Value="200" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.5500000" Value="220" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.6000000" Value="240" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.6500000" Value="260" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.7000000" Value="280" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.7500000" Value="300" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.8000000" Value="320" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.8500000" Value="340" />
          <DiscreteDoubleKeyFrame KeyTime="00:00:00.9000000" Value="360" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Viewbox>
    <Grid Name="grid" Width="300" Height="300" RenderTransformOrigin="0.5,0.5">
      <UIElement.RenderTransform>
        <TransformGroup>
          <ScaleTransform />
          <SkewTransform />
          <RotateTransform />
          <TranslateTransform />
        </TransformGroup>
      </UIElement.RenderTransform>
      <Canvas Name="canvas" Width="300" Height="300" Margin="0,0,0,180" HorizontalAlignment="Left" Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
        <UIElement.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <SkewTransform />
            <RotateTransform />
            <TranslateTransform />
          </TransformGroup>
        </UIElement.RenderTransform>
        <Rectangle Opacity="1" />
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="22.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="45" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="67.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="90" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="112.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="135" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle>
          <UIElement.RenderTransform>
            <RotateTransform Angle="157.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.2">
          <UIElement.RenderTransform>
            <RotateTransform Angle="180" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.3">
          <UIElement.RenderTransform>
            <RotateTransform Angle="202.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.4">
          <UIElement.RenderTransform>
            <RotateTransform Angle="225" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.5">
          <UIElement.RenderTransform>
            <RotateTransform Angle="247.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.6">
          <UIElement.RenderTransform>
            <RotateTransform Angle="270" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.7">
          <UIElement.RenderTransform>
            <RotateTransform Angle="292.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.8">
          <UIElement.RenderTransform>
            <RotateTransform Angle="315" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
        <Rectangle Opacity="0.9">
          <UIElement.RenderTransform>
            <RotateTransform Angle="337.5" CenterX="-70" CenterY="10" />
          </UIElement.RenderTransform>
        </Rectangle>
      </Canvas>
    </Grid>
  </Viewbox>
</UserControl>