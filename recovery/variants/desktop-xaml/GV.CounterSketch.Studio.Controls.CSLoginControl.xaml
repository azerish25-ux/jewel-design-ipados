<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.CSLoginControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="CSLoginUserControl" Margin="10" Background="#FFFFFFFF" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" Loaded="CSLoginUserControl_Loaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Converters:StringToTitleCaseConverter x:Key="StringToTitleCaseConverter" />
      <Converters:BooleanToVisibilityConverter x:Key="LocalBooleanToVisibilityConverter" />
      <Storyboard x:Key="ProcessingStoryBoard" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.Opacity)" Duration="00:00:00.0010000">
          <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Storyboard x:Key="CompletedStoryBoard">
        <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.Opacity)">
          <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
          <SplineDoubleKeyFrame KeyTime="00:00:04" Value="0" />
          <SplineDoubleKeyFrame KeySpline="1,0,1,1" KeyTime="00:00:07" Value="1" />
        </DoubleAnimationUsingKeyFrames>
      </Storyboard>
      <Style x:Key="PasswordBoxControlStyle" TargetType="{x:Type Control}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type Control}">
              <Grid />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="TextBlockStyle1" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="Background" Value="#00FFFFFF" />
      </Style>
      <ControlTemplate x:Key="ButtonBaseControlTemplate" TargetType="{x:Type ButtonBase}">
        <Border Name="border" Background="{DynamicResource WindowFrameBackground}" BorderBrush="{DynamicResource HighlightAndAccent}" BorderThickness="2" CornerRadius="3" SnapsToDevicePixels="True">
          <ContentPresenter Name="contentPresenter" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Focusable="False" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Button.IsDefaulted" Value="True">
            <Setter TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Property="Border.BorderBrush" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True" />
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="border" Property="Border.BorderBrush">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource HighlightAndAccentColor}" />
              </Setter.Value>
            </Setter>
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="border" Property="Border.Background" Value="#FFF4F4F4" />
            <Setter TargetName="border" Property="Border.BorderBrush" Value="#FFADB2B5" />
            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF838383" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="LayoutRoot">
    <StackPanel Name="panelLogin" Margin="5" IsHitTestVisible="False">
      <StackPanel Name="stackPanel" Orientation="Vertical">
        <TextBlock Name="txtInstruction" Margin="0,0,0,5" HorizontalAlignment="Center" FontSize="13.333" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Instruction, ElementName=CSLoginUserControl, Mode=Default}" />
        <DockPanel Name="panelUsername" Margin="0,0,5,0">
          <TextBlock MinWidth="75" Padding="0,0,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13.333" Foreground="#FF3E3E3E" Text="{x:Static l:Strings.Username}" TextAlignment="Right" TextWrapping="Wrap" />
          <TextBox Name="txtUsername" Height="24" MinWidth="250" Margin="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#FF000000" TextWrapping="Wrap" />
        </DockPanel>
        <DockPanel Name="panelPassword" Margin="0,5,5,0">
          <TextBlock MinWidth="75" Padding="0,0,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13.333" Foreground="#FF3E3E3E" Text="{x:Static l:Strings.Password}" TextAlignment="Right" TextWrapping="Wrap" />
          <Grid Margin="10,0,0,0">
            <PasswordBox Name="txtPassword" Height="24" MinWidth="260" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#FF000000" PasswordChar="*" GotKeyboardFocus="txtPassword_GotKeyboardFocus" KeyDown="txtPassword_KeyDown" />
            <Popup Name="popupCapsWarning" Margin="0" AllowsTransparency="True" Visibility="Visible">
              <Grid Width="108" Height="30" Margin="0,6,0,0" ZIndex="5">
                <Ellipse Fill="#FFFFFF00" Stroke="#FF000000" />
                <Path Width="28.577" Height="8.641" Margin="52.1,-6.917,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M6.7012266,4.3037135 C15.454461,-3.3520102 35.147971,-10.62968 32.291894,-8.5964713 C26.03119,-4.1395467 25.034675,4.480243 25.034675,4.480243" Fill="#FFFFFF0E" Stretch="Uniform" Stroke="#FF000000" StrokeEndLineCap="Round" StrokeStartLineCap="Round" />
                <TextBlock Margin="4,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="9.333" FontWeight="Bold" Style="{DynamicResource TextBlockStyle1}" Text="CAPSLOCK is ON!" TextWrapping="Wrap" />
              </Grid>
            </Popup>
          </Grid>
        </DockPanel>
        <DockPanel Name="panelSerialCode" Margin="0,5,5,0">
          <TextBlock MinWidth="75" Padding="0,0,2,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FF3E3E3E" Text="{x:Static l:Strings.SerialCode}" TextAlignment="Right" TextWrapping="Wrap" />
          <TextBox Name="txtSerialCode" Height="24" MinWidth="260" Margin="10,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" BorderBrush="#FF000000" />
        </DockPanel>
        <TextBlock Name="txtResponse" Margin="5" VerticalAlignment="Center" FontSize="16" Foreground="#FF000000" ScrollViewer.VerticalScrollBarVisibility="Disabled" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding Response, ElementName=CSLoginUserControl, Mode=Default}" />
      </StackPanel>
      <StackPanel Name="panelButtons" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
        <TextBlock Name="txtNeedLogin" Margin="0,0,10,0.04" Cursor="Hand" FontSize="13.333" Foreground="#FF000000" Text="{x:Static l:Strings.NeedALogin}" TextWrapping="Wrap" Visibility="{Binding ShowNeedLogin, Converter={StaticResource LocalBooleanToVisibilityConverter}, ElementName=CSLoginUserControl}" MouseLeftButtonDown="txtNeedLogin_MouseLeftButtonDown" />
        <Button Name="btnCancel" MinWidth="60" Margin="5,0,0,0" Cursor="Hand" FontSize="13.333" IsCancel="True" IsTabStop="False" Content="{Binding Source={x:Static l:Strings.CANCEL}, Converter={StaticResource StringToTitleCaseConverter}}" Visibility="{Binding ShowCancel, Converter={StaticResource LocalBooleanToVisibilityConverter}, ElementName=CSLoginUserControl}" Click="btnCancel_Click" />
        <Button Name="btnLogin" MinWidth="60" Margin="5,0,0,0" Cursor="Hand" FontSize="13.333" IsDefault="True" IsTabStop="False" Content="{Binding ActionButtonName, ElementName=CSLoginUserControl}" Click="btnLogin_Click" />
      </StackPanel>
    </StackPanel>
    <Path Width="1" Height="1" Margin="178,0,0,-13.486" HorizontalAlignment="Left" VerticalAlignment="Bottom" Data="M178,119.5" Fill="#FFFFFFFF" Stretch="Fill" Stroke="#FF000000" />
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="LoginModeStates">
        <VisualStateGroup.Transitions>
          <VisualTransition GeneratedDuration="00:00:00" />
        </VisualStateGroup.Transitions>
        <VisualState x:Name="Default">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.Opacity)" Duration="00:00:00.0010000">
              <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <BooleanAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Duration="00:00:00.0010000">
              <DiscreteBooleanKeyFrame KeyTime="00:00:00" Value="True" />
            </BooleanAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="stackPanel" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelButtons" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelSerialCode" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="AlternatePasswordMode">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.Opacity)" Duration="00:00:00.0010000">
              <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <BooleanAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Duration="00:00:00.0010000">
              <DiscreteBooleanKeyFrame KeyTime="00:00:00" Value="True" />
            </BooleanAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="stackPanel" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelButtons" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelSerialCode" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelUsername" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="txtNeedLogin" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="SerialCodeMode">
          <Storyboard>
            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.Opacity)" Duration="00:00:00.0010000">
              <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <BooleanAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelLogin" Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Duration="00:00:00.0010000">
              <DiscreteBooleanKeyFrame KeyTime="00:00:00" Value="True" />
            </BooleanAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="panelButtons" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="stackPanel" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
              <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</UserControl>