<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowExportSearchResultsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="{x:Static l:Strings.ExportSearchResultImages}" Width="600" Height="400" Style="{DynamicResource WindowStyleModalCS4}" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="12" ResizeMode="NoResize" WindowStyle="None" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Path=WindowExportSearchResultsVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary />
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="24" />
    </Grid.RowDefinitions>
    <StackPanel Margin="20,0" VerticalAlignment="Top">
      <DockPanel Margin="0,10,0,0">
        <TextBlock VerticalAlignment="Center" Text="{x:Static l:Strings.SelectTheLocationToExportTo}" TextWrapping="Wrap" />
      </DockPanel>
      <DockPanel Margin="0,10,0,0" VerticalAlignment="Top">
        <Button Margin="20,0,0,0" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{x:Static l:Strings.Browse}" DockPanel.Dock="Right" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandPickFolder}" />
        <Border VerticalAlignment="Center" BorderBrush="#FF000000" BorderThickness="1">
          <TextBlock Width="471" Height="15" TextWrapping="Wrap" Text="{Binding ExportSearchResultsPath, Mode=TwoWay}" />
        </Border>
      </DockPanel>
    </StackPanel>
    <ProgressBar Grid.Row="1" Height="16" Margin="2" VerticalAlignment="Center" SmallChange="1" Maximum="{Binding Count}" Visibility="{Binding IsExporting, Converter={StaticResource BooleanToVisibilityConverter}}" Value="{Binding ProgressIndex}" />
    <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Export Complete, Click View Images to see results." TextWrapping="Wrap" Visibility="{Binding IsComplete, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <DockPanel Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel HorizontalAlignment="Center" DockPanel.Dock="Bottom" Orientation="Horizontal">
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ProgressIndex}" />
        <TextBlock Margin="20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.Of}" TextWrapping="Wrap" />
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Count}" />
      </StackPanel>
      <Image DockPanel.Dock="Top" UseLayoutRounding="False" Source="{Binding CurrentImageSource}" />
    </DockPanel>
    <StackPanel Margin="0,0,20,30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Orientation="Horizontal">
      <Button Padding="3,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:Strings.ViewImages}" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandView}" IsEnabled="{Binding IsViewEnabled}" />
      <Button Margin="10,0,0,0" Padding="3,0,3,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:Strings.Export}" Template="{DynamicResource CS4ButtonRoundedHighlight}" Command="{Binding CommandExport}" />
    </StackPanel>
  </Grid>
</Window>