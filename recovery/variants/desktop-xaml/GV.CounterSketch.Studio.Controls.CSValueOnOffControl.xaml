<?xml version="1.0" encoding="utf-8"?>
<Controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueOnOffControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="CSValueToggleUserControl" Background="#00FFFFFF">
  <Grid Margin="0,4" VerticalAlignment="Center" Background="#02000000">
    <Grid Margin="0,0,0,0" VerticalAlignment="Center">
      <Border Height="1" VerticalAlignment="Top" Background="#FFC6BEB6" Visibility="Hidden" />
      <DockPanel Margin="0">
        <Border Name="borderSubMenu" Margin="0,2,0,0" VerticalAlignment="Top" Background="#02000000" DockPanel.Dock="Right" Visibility="Hidden">
          <Button Name="btnSubMenu" Width="12" Height="13" Margin="2,0,1,0" Cursor="Hand" Style="{DynamicResource CSSubMenuButton}" Click="BtnSubMenuClick" />
        </Border>
        <Line Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" DockPanel.Dock="Right" Stroke="#FFC6BEB6" Visibility="Hidden" Y2="15" />
        <CheckBox Name="chkOnOff" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsThreeState="False" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding OnOff, ElementName=CSValueToggleUserControl, Mode=TwoWay}" Checked="ChkOnOffChecked" Unchecked="ChkOnOffUnchecked">
          <DockPanel Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <TextBlock Name="txtCategory" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="10" Foreground="#FF32302E" Text="{Binding CategoryName, ElementName=CSValueToggleUserControl, FallbackValue=Category:}" />
            <TextBlock Name="txtTitle" HorizontalAlignment="Left" VerticalAlignment="Center" Panel.ZIndex="10" Foreground="#FF6A6A6A" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding DisplayTitle, ElementName=CSValueToggleUserControl, FallbackValue=TitleName}" />
          </DockPanel>
        </CheckBox>
      </DockPanel>
    </Grid>
    <Popup Name="popupSubMenu" AllowsTransparency="True" HorizontalOffset="-20" Placement="Right" PopupAnimation="None" VerticalOffset="-20" MouseLeave="PopupSubMenuMouseLeave">
      <Border Padding="20,20,0,0" Background="#02000000" BorderBrush="#00000000">
        <Border Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FF65615D" BorderThickness="1">
          <StackPanel Name="stackSubMenuActions" Margin="10,4">
            <Border CornerRadius="2">
              <DockPanel>
                <Button Name="btnResetControl" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Reset Control To Default" Cursor="Hand" Foreground="#FFCCCCCC" Style="{DynamicResource CSSubMenuActionButton}" Background="{x:Null}" Click="BtnResetControlClick" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Border>
    </Popup>
  </Grid>
</Controls:CSUIControl>