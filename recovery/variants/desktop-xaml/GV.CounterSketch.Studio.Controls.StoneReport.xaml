<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.StoneReport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" x:Name="stoneReportControl" FontFamily="Helvetica Neue LT Std" FontSize="10pt" DataContext="{Binding Path=GemReportVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ListBoxStyle1" TargetType="{x:Type ListBox}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Name="Bd" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="1" SnapsToDevicePixels="True">
                <ScrollViewer Focusable="False" Padding="{TemplateBinding Control.Padding}">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="DataTemplateStoneReport" DataType="viewModel:Gem">
        <Grid Height="Auto">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80*" />
            <ColumnDefinition Width="130*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="50*" />
            <ColumnDefinition Width="0*" />
            <ColumnDefinition Width="0*" />
            <ColumnDefinition Width="55*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Grid.Column="0" Height="Auto" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Shape" Height="16" Margin="10,0,0,0" HorizontalAlignment="Left" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Shape}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="1" Height="Auto" Margin="10,0,0,0" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Type" Height="16" HorizontalAlignment="Left" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Type}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Height="Auto" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Height" Height="16" Margin="10,0,5,0" HorizontalAlignment="Right" TextWrapping="Wrap" Text="{Binding Height, StringFormat={}{0:N2}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="3" Height="Auto" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Width" Height="16" Margin="10,0,5,0" HorizontalAlignment="Right" TextWrapping="Wrap" Text="{Binding Width, StringFormat={}{0:N2}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="4" Height="Auto" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Length" Height="16" Margin="10,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Length, StringFormat={}{0:N2}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="5" Height="Auto" VerticalAlignment="Stretch" BorderBrush="#FFFFFFFF" BorderThickness="0,0,1,0">
            <TextBlock Name="Carat" Height="16" Margin="10,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Carat, StringFormat={}{0:N2}}" />
          </Border>
          <TextBlock Name="Quantity" Grid.Row="0" Grid.Column="8" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Quantity}" />
        </Grid>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleGemGroupReport" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <StackPanel Name="stackPanel" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="MouseEnter">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightGemGroup, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Controls:StoneReport}}}" CommandParameter="{Binding}" />
                  </i:EventTrigger>
                  <i:EventTrigger EventName="MouseLeave">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightCancel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Controls:StoneReport}}}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected" />
                    <VisualState x:Name="SelectedUnfocused" />
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="ValidationStates">
                    <VisualState x:Name="Valid" />
                    <VisualState x:Name="InvalidFocused" />
                    <VisualState x:Name="InvalidUnfocused" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <DockPanel Width="Auto" Height="Auto">
                  <ContentPresenter Margin="20,0,0,0" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </DockPanel>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
            <TriggerBase.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(ListBoxItem.IsSelected)">
                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                  </BooleanAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.EnterActions>
          </DataTrigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Background" Value="{DynamicResource WindowFrameBackground}" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <DockPanel>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="VisualStateGroup">
        <VisualState x:Name="Default" />
        <VisualState x:Name="IndividualStones">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StoneGroupReportListBox" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="StoneReportListBox" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
    <DockPanel Background="#FFFFFFFF" Dock="Top" LastChildFill="False" Visibility="Collapsed">
      <CheckBox Margin="20,5,0,5" VerticalAlignment="Center" Content="Group Matching Stones" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding GroupedStoneViewActive}" />
    </DockPanel>
    <Border Name="DontDeleteThisBorder" BorderThickness="0,1" DockPanel.Dock="Top">
      <Grid Name="StoneReportHeaderRow" Background="#FFFFFFFF">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="20" />
          <ColumnDefinition Width="80*" />
          <ColumnDefinition Width="130*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="50*" />
          <ColumnDefinition Width="0*" />
          <ColumnDefinition Width="0*" />
          <ColumnDefinition Width="55*" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="{x:Static l:Strings.SHAPE}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Text="{x:Static l:Strings.TYPE}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="3" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Static l:Strings.HEIGHT}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="4" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Static l:Strings.WIDTH}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="5" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Source={x:Static l:Strings.Depth}, Converter={StaticResource StringToUpperCaseConverter}}" />
        <TextBlock Grid.Column="6" Margin="10,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Static l:Strings.CARAT}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="9" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{x:Static l:Strings.QTY}" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <Border Name="Sub_Total" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFFFFFFF" DockPanel.Dock="Bottom">
      <StackPanel Margin="5,0,5,10" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,10,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <TextBlock Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.WEIGHT}" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.QTY}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="{Binding CaratTotalCenterQty, Converter={StaticResource OrderQuantityToVisibilityConverter}}">
          <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" Text="{x:Static l:Strings.CenterGem}" TextWrapping="Wrap" />
          <TextBlock Name="txtCenter" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalCenter, StringFormat={}{0:#0.00} ct}" />
          <TextBlock Name="txtCenterQty" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalCenterQty}" />
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" Text="{x:Static l:Strings.GemsLessThan4mm}" TextWrapping="Wrap" />
          <TextBlock Name="txtMelee" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalMelee, StringFormat={}{0:N2} ct}" />
          <TextBlock Name="txtMeleeQty" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalMeleeQty}" />
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" Text="{x:Static l:Strings.GemsLessThan4mm}" TextWrapping="Wrap" />
          <TextBlock Name="txtLarge" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalLarge, StringFormat={}{0:N2} ct}" />
          <TextBlock Name="txtLargeQty" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratTotalLargeQty}" />
        </StackPanel>
        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
          <TextBlock Width="200" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" Text="{x:Static l:Strings.TotalCaratWeight}" TextWrapping="Wrap" />
          <TextBlock Name="txtTotal" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratGrandTotal, StringFormat={}{0:#0.00} CTW}" />
          <TextBlock Name="txtTotalQty" Width="75" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextDarkBrush}" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding CaratGrandTotalQty}" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Grid DockPanel.Dock="Top">
      <ListBox Name="StoneGroupReportListBox" HorizontalContentAlignment="Stretch" AlternationCount="2" BorderThickness="0" Cursor="Hand" FontFamily="Helvetica Neue LT Std" ItemContainerStyle="{DynamicResource ListBoxItemStyleGemGroupReport}" ItemTemplate="{DynamicResource DataTemplateStoneReport}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" Style="{DynamicResource ListBoxStyle1}" ItemsSource="{Binding StoneReportGems}">
        <i:Interaction.Behaviors>
          <Behaviors:UIElementBehaviorRedirectMouseWheelToParentScrollViewer />
        </i:Interaction.Behaviors>
      </ListBox>
    </Grid>
  </DockPanel>
</UserControl>