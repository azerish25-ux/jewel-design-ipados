<?xml version="1.0" encoding="utf-8"?>
<Controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueGemShapeControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:GV_CounterSketch_Utilities_Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Model="clr-namespace:GV.CounterSketch.Shared.Model;assembly=CounterSketch Studio" xmlns:PagedListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.PagedListBox" xmlns:cvrt="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="CSValueGemShapeUserControl" MinHeight="80" Background="#00FFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="18" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Height="1" VerticalAlignment="Top" Background="#FFC6BEB6" />
      <DockPanel>
        <Border Name="borderSubMenu" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#02000000" DockPanel.Dock="Right">
          <Button Name="btnSubMenu" Width="12" Height="13" Margin="0,2,1,0" VerticalAlignment="Top" Cursor="Hand" Style="{DynamicResource CSSubMenuButton}" Click="BtnSubMenuClick" />
        </Border>
        <Line Margin="0,0,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" DockPanel.Dock="Right" Stroke="#FFC6BEB6" Y2="15" />
        <TextBlock Name="txtTitle" HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Left" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FF32302E" Text="{Binding DisplayTitle, ElementName=CSValueGemShapeUserControl}" />
      </DockPanel>
      <DockPanel Grid.Row="1" Margin="0,0,5,0">
        <PagedListBox:PagedListBox SelectionChanged="Selector_OnSelectionChanged" VerticalContentAlignment="Center" DockPanel.Dock="Top" ItemContainerStyle="{DynamicResource SurfaceListBoxItemStyleChooser}" PagingIndicatorVisibility="Collapsed" ScrollViewer.CanContentScroll="True" Template="{DynamicResource ListBoxControlTemplateChooser}" ItemsSource="{Binding Gems, ElementName=CSValueGemShapeUserControl}" SelectedIndex="{Binding SelectedGemShapeDataIndex, ElementName=CSValueGemShapeUserControl, Mode=TwoWay}">
          <i:Interaction.Behaviors>
            <GV_CounterSketch_Utilities_Behaviors:UIElementBehaviorRedirectMouseWheelToParentScrollViewer />
          </i:Interaction.Behaviors>
        </PagedListBox:PagedListBox>
      </DockPanel>
    </Grid>
    <Popup Name="popupSubMenu" Margin="0" VerticalAlignment="Top" AllowsTransparency="True" HorizontalOffset="-19" Placement="Right" PopupAnimation="None" VerticalOffset="-22" PlacementTarget="{Binding ElementName=btnSubMenu}" MouseLeave="PopupSubMenuMouseLeave">
      <Border Padding="20,20,0,0" Background="#02000000">
        <Border Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FF65615D" BorderThickness="1">
          <StackPanel Name="stackSubMenuActions" Margin="10,4">
            <Border>
              <DockPanel>
                <Button Name="btnResetControl" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Content="Reset Control To Default" Cursor="Hand" FontSize="13.333" Foreground="#FFCCCCCC" Style="{DynamicResource CSSubMenuActionButton}" Background="{x:Null}" Click="BtnResetControlClick" />
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </Border>
    </Popup>
  </Grid>
</Controls:CSUIControl>