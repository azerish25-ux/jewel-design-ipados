<?xml version="1.0" encoding="utf-8"?>
<Controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueXFormObjectControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="CSValueXFormObjectUserControl" Background="#FFFFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <ControlTemplate x:Key="StackControlGraphicalToggle" TargetType="{x:Type ButtonBase}">
        <Grid Width="{TemplateBinding FrameworkElement.Height}" Height="{TemplateBinding FrameworkElement.Width}" Margin="{TemplateBinding FrameworkElement.Margin}" HorizontalAlignment="{TemplateBinding FrameworkElement.HorizontalAlignment}" VerticalAlignment="{TemplateBinding FrameworkElement.VerticalAlignment}" Background="{TemplateBinding Control.Background}" Cursor="Hand" Opacity="{TemplateBinding UIElement.Opacity}" ToolTip="{TemplateBinding FrameworkElement.ToolTip}" Visibility="{TemplateBinding UIElement.Visibility}">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource TextBoxAndFrameBackground}" BorderThickness="2" CornerRadius="1" Opacity="0" />
          <Border Name="border" Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource HighlightAndAccent}" BorderThickness="2" CornerRadius="1" Visibility="Collapsed" />
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CheckStates">
              <VisualState x:Name="Checked">
                <Storyboard>
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Unchecked" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
        </Grid>
      </ControlTemplate>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplate1">
        <UniformGrid IsItemsHost="True" Rows="1" />
      </ItemsPanelTemplate>
      <Style x:Key="ListBoxItemStyle1" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Padding="{TemplateBinding Control.Padding}" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,0,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="0.2*" />
      <ColumnDefinition Width="0.8*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" BorderBrush="#FFAEAEAE" BorderThickness="0,0,1,0">
      <ListBox Margin="0,1,0,-1" Background="#dddddd" BorderThickness="0" ItemContainerStyle="{DynamicResource ListBoxItemStyle1}" ItemsPanel="{DynamicResource ItemsPanelTemplate1}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="SelectionChanged">
            <command:EventToCommand PassEventArgsToCommand="True" Command="{Binding FreehandStackVM.CommandFlipChanged, Source={StaticResource Locator}}" />
          </i:EventTrigger>
        </i:Interaction.Triggers>
        <ListBoxItem Name="flipSideItem" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <StackPanel Width="45" Height="52" Orientation="Vertical">
            <CheckBox Name="flipSide" Width="Auto" Height="40" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" IsThreeState="False" Template="{DynamicResource StackControlGraphicalToggle}" IsChecked="{Binding IsSelected, ElementName=flipSideItem}">
              <Grid>
                <Viewbox Name="Flip" Height="30" Margin="2,0">
                  <StackPanel Orientation="Horizontal">
                    <wpf:ImageAwesome FrameworkElement.Width="12" FrameworkElement.Height="12" FrameworkElement.Margin="0,0,2,0" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.VerticalAlignment="Center" ImageAwesome.Foreground="#FF808080" xmlns:wpf="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" wpf:ImageAwesome.Icon="AlignLeft" />
                    <Path Width="1" Height="20" Data="F1 M15.0001,0.499939 L15.0001,18.4998" Stretch="Fill" Stroke="#FF000000" StrokeDashArray="4,3" StrokeLineJoin="Round" StrokeThickness="1" />
                    <ImageAwesome FrameworkElement.Width="12" FrameworkElement.Height="12" FrameworkElement.Margin="2,0,0,0" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.VerticalAlignment="Center" p19:ImageAwesome.Foreground="#FFCCC6C1" p19:ImageAwesome.Icon="AlignRight" xmlns:p19="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                  </StackPanel>
                </Viewbox>
              </Grid>
            </CheckBox>
            <TextBlock HorizontalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" Foreground="#FF898684" Text="Flip" TextWrapping="Wrap" />
          </StackPanel>
        </ListBoxItem>
      </ListBox>
    </Border>
    <ListBox Grid.Column="1" Margin="0,1,0,-1" Background="#dddddd" BorderThickness="0" ItemContainerStyle="{DynamicResource ListBoxItemStyle1}" ItemsPanel="{DynamicResource ItemsPanelTemplate1}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionMode="Single">
      <i:Interaction.Triggers>
        <i:EventTrigger EventName="SelectionChanged">
          <command:EventToCommand PassEventArgsToCommand="True" Command="{Binding FreehandStackVM.CommandMirrorChanged, Source={StaticResource Locator}}" />
        </i:EventTrigger>
      </i:Interaction.Triggers>
      <ListBoxItem Name="mirrorTopItem" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
        <StackPanel Width="40" Height="52" Orientation="Vertical">
          <CheckBox Name="mirrorTop" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="False" Template="{DynamicResource StackControlGraphicalToggle}" IsChecked="{Binding IsSelected, ElementName=mirrorTopItem}">
            <Grid>
              <Viewbox Name="Top" Width="18" Height="30">
                <Canvas Width="19" Height="30">
                  <Path Canvas.Left="0" Canvas.Top="14.5" Width="19" Height="1.00018" Data="F1 M0.5,15 L18.5,15.0002" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                  <Rectangle Canvas.Left="3.50009" Canvas.Top="18" Width="12" Height="12" Fill="#FF898684" Stretch="Fill" />
                  <Rectangle Canvas.Left="3.50009" Canvas.Top="0" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                </Canvas>
              </Viewbox>
            </Grid>
          </CheckBox>
          <TextBlock HorizontalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" Foreground="#FF898684" Text="Top" TextWrapping="Wrap" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Name="mirrorSideItem" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <StackPanel Width="40" Height="52" Orientation="Vertical">
          <CheckBox Name="mirrorSide" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="False" Template="{DynamicResource StackControlGraphicalToggle}" IsChecked="{Binding IsSelected, ElementName=mirrorSideItem}">
            <Grid>
              <Viewbox Name="Side1" Width="30" Height="18">
                <Canvas Width="30" Height="18.9998">
                  <Path Canvas.Left="14.5001" Canvas.Top="-6.10352e-005" Width="1" Height="18.9999" Data="F1 M15.0001,0.499939 L15.0001,18.4998" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                  <Rectangle Canvas.Left="0" Canvas.Top="3.49957" Width="12" Height="12" Fill="#FF898684" Stretch="Fill" />
                  <Rectangle Canvas.Left="18" Canvas.Top="3.49957" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                </Canvas>
              </Viewbox>
            </Grid>
          </CheckBox>
          <TextBlock HorizontalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" Foreground="#FF898684" Text="Side" TextWrapping="Wrap" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Name="mirrorOppositeItem" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <StackPanel Width="40" Height="52" Orientation="Vertical">
          <CheckBox Name="mirrorOpposite" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="False" Template="{DynamicResource StackControlGraphicalToggle}" IsChecked="{Binding IsSelected, ElementName=mirrorOppositeItem}">
            <Grid>
              <Viewbox Name="Opposite2" Width="33" Height="33">
                <Canvas Width="34.0151" Height="34.0151">
                  <Viewbox Canvas.Left="0" Canvas.Top="0" Width="34.0151" Height="34.0151">
                    <Canvas Width="34.0151" Height="34.0151">
                      <Path Canvas.Left="16.5077" Canvas.Top="0" Width="1" Height="34.0151" Data="F1 M17.0077,0.5 L17.0077,33.5151" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                      <Path Canvas.Left="0" Canvas.Top="16.5078" Width="34.0151" Height="1" Data="F1 M0.5,17.0078 L33.5151,17.0078" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <Rectangle Canvas.Left="2.00764" Canvas.Top="20.0075" Width="12" Height="12" Fill="#FF898684" Stretch="Fill" />
                  <Rectangle Canvas.Left="20.0076" Canvas.Top="2.00751" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                </Canvas>
              </Viewbox>
            </Grid>
          </CheckBox>
          <TextBlock HorizontalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="9.333" Foreground="#FF898684" Text="Opposite" TextWrapping="Wrap" />
        </StackPanel>
      </ListBoxItem>
      <ListBoxItem Name="mirrorQuadItem" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <StackPanel Width="40" Height="52" Orientation="Vertical">
          <CheckBox Name="mirrorQuad" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsThreeState="False" Template="{DynamicResource StackControlGraphicalToggle}" IsChecked="{Binding IsSelected, ElementName=mirrorQuadItem}">
            <Grid>
              <Viewbox Name="Quad3" Width="33" Height="33">
                <Canvas Width="34.0151" Height="34.0151">
                  <Viewbox Canvas.Left="0" Canvas.Top="0" Width="34.0151" Height="34.0151">
                    <Canvas Width="34.0151" Height="34.0151">
                      <Path Canvas.Left="16.5077" Canvas.Top="0" Width="1" Height="34.0151" Data="F1 M17.0077,0.5 L17.0077,33.5151" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                      <Path Canvas.Left="0" Canvas.Top="16.5078" Width="34.0151" Height="1" Data="F1 M0.5,17.0078 L33.5151,17.0078" Stretch="Fill" Stroke="#FF32302E" StrokeLineJoin="Round" />
                    </Canvas>
                  </Viewbox>
                  <Rectangle Canvas.Left="2.00766" Canvas.Top="20.0075" Width="12" Height="12" Fill="#FF898684" Stretch="Fill" />
                  <Rectangle Canvas.Left="2.00766" Canvas.Top="2.00751" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                  <Rectangle Canvas.Left="20.0077" Canvas.Top="20.0075" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                  <Rectangle Canvas.Left="20.0077" Canvas.Top="2.00751" Width="12" Height="12" Fill="#FFCCC6C1" Stretch="Fill" />
                </Canvas>
              </Viewbox>
            </Grid>
          </CheckBox>
          <TextBlock HorizontalAlignment="Center" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" Foreground="#FF898684" Text="Quad" TextWrapping="Wrap" />
        </StackPanel>
      </ListBoxItem>
    </ListBox>
  </Grid>
</Controls:CSUIControl>