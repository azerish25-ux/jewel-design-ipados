<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.TileViewDesigns" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:attachedBehaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.AttachedBehaviors" xmlns:behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:c="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:counterSketchLibrary="clr-namespace:GV.CounterSketch.Studio.Model.Entities.CounterSketchLibrary" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:model="clr-namespace:GV.CounterSketch.Studio.Model" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" xmlns:viewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" DataContext="{Binding TileViewDesignsVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DataTemplateTileList" DataType="model:TileItem">
        <Grid Width="310" Height="150" Margin="0,0,0,10">
          <Border Background="#FFFFFFFF" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Border Background="#333333" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
          <Image Stretch="Fill">
            <Image.Source>
              <MultiBinding Converter="{StaticResource TileSizeImagePathToImageConverter}">
                <Binding Path="Size" />
                <Binding Path="ImagePath" />
                <Binding Path="TileViewDesignsVM.IsLightTheme" Source="{StaticResource Locator}" />
                <Binding Path="TileViewDesignsVM.IsTechTheme" Source="{StaticResource Locator}" />
              </MultiBinding>
            </Image.Source>
          </Image>
          <Grid Margin="0,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Title, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}">
            <TextBlock Margin="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Title}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <TextBlock Margin="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Title}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </Grid>
          <Button Width="32" Height="32" Margin="10,10,10,0" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" Command="{Binding Path=ParentViewModel.CommandAddTile}" CommandParameter="{Binding}">
            <wpf:ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" xmlns:wpf="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" wpf:ImageAwesome.Icon="Plus" />
          </Button>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DataTemplateCategoryAttribute" DataType="counterSketchLibrary:Attribute">
        <TextBlock Text="{Binding AttributeName}" />
      </DataTemplate>
      <Style x:Key="CSTileLayoutControlStyle" TargetType="{x:Type dxlc:TileLayoutControl}">
        <Setter Property="dxlc:FlowLayoutControl.ItemTemplate">
          <Setter.Value>
            <DataTemplate DataType="model:TileItem">
              <dxlc:Tile Cursor="Hand" Width="{Binding CustomWidth}" Height="{Binding CustomHeight}" dxlc:FlowLayoutControl.IsFlowBreak="{Binding IsGroupStart, Mode=TwoWay}" Background="{x:Null}" Command="{Binding TileCommandObject}" CommandParameter="{Binding TileCommandObjectInput}" IsHitTestVisible="{Binding IsHitTestVisible}" IsManipulationEnabled="{Binding TileViewDesignsVM.IsInEditMode, Source={StaticResource Locator}, Converter={StaticResource BooleanInverseConverter}}" Size="{Binding Size, Mode=OneWay}">
                <dx:ContentControlBase.Content>
                  <Grid>
                    <Border Background="#FFFFFFFF" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Background="#333333" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Image Visibility="{Binding TileCommandType, ConverterParameter=True, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                      <Image.Source>
                        <MultiBinding Converter="{StaticResource TileSizeImagePathToImageConverter}">
                          <Binding Path="Size" />
                          <Binding Path="ImagePath" />
                          <Binding Path="TileViewDesignsVM.IsLightTheme" Source="{StaticResource Locator}" />
                          <Binding Path="TileViewDesignsVM.IsTechTheme" Source="{StaticResource Locator}" />
                        </MultiBinding>
                      </Image.Source>
                    </Image>
                    <Image Stretch="Fill" Source="{Binding ImagePath, Converter={StaticResource ImagePathToBitmapImageConverter}}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}" />
                    <Border Margin="15,25,5,35" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFFFFFFF" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock FontSize="12" Foreground="#FFFF0000" TextWrapping="Wrap" Text="{Binding ErrorMessage}" Visibility="{Binding TileViewDesignsVM.IsInEditMode, ConverterParameter=False, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>
                    <Border Margin="15,25,5,35" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#333333" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <TextBlock FontSize="12" Foreground="#FFFF0000" TextWrapping="Wrap" Text="{Binding ErrorMessage}" Visibility="{Binding TileViewDesignsVM.IsInEditMode, ConverterParameter=False, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Border>
                    <Grid Visibility="{Binding TileViewDesignsVM.IsInEditMode, ConverterParameter=False, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}">
                      <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" RenderTransformOrigin="0.5,0.5" Visibility="{Binding Size, ConverterParameter=True, Converter={StaticResource TileSizeToTextVisibilityConverter}}">
                        <FrameworkElement.LayoutTransform>
                          <TransformGroup>
                            <ScaleTransform ScaleX=".55" ScaleY=".55" />
                            <SkewTransform />
                            <RotateTransform />
                            <TranslateTransform />
                          </TransformGroup>
                        </FrameworkElement.LayoutTransform>
                        <c:TileSizeButtonFlyoutControl Margin="5" CurrentTileSize="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Width="32" Height="32" Margin="5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.AddCustomImageTile}" Command="{Binding ParentViewModel.CommandEditTileImage}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p32:ImageAwesome.Icon="Image" xmlns:p32="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                        </Button>
                        <Button Width="32" Height="32" Margin="5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.ShowcaseTileURL}" Command="{Binding ParentViewModel.CommandSetShowcaseTile}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p32:ImageAwesome.Icon="Book" xmlns:p32="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                        </Button>
                        <Button Width="32" Height="32" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.TileURL}" Command="{Binding ParentViewModel.CommandEditTileURL}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p32:ImageAwesome.Icon="Link" xmlns:p32="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                        </Button>
                        <Button Width="32" Height="32" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.Delete}" Command="{Binding ParentViewModel.CommandRemoveTile}" CommandParameter="{Binding}">
                          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p32:ImageAwesome.Icon="Trash" xmlns:p32="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                        </Button>
                      </WrapPanel>
                      <DockPanel HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding Size, Converter={StaticResource TileSizeToTextVisibilityConverter}}">
                        <WrapPanel Margin="10,10,10,0" HorizontalAlignment="Right" DockPanel.Dock="Top" Orientation="Horizontal">
                          <c:TileSizeButtonFlyoutControl Margin="5" CurrentTileSize="{Binding Size, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          <Button Width="32" Height="32" Margin="5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.AddCustomImageTile}" Command="{Binding ParentViewModel.CommandEditTileImage}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p33:ImageAwesome.Icon="Image" xmlns:p33="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                          </Button>
                          <Button Width="32" Height="32" Margin="5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.ShowcaseTileURL}" Command="{Binding ParentViewModel.CommandSetShowcaseTile}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p33:ImageAwesome.Icon="Book" xmlns:p33="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                          </Button>
                          <Button Width="32" Height="32" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.TileURL}" Command="{Binding ParentViewModel.CommandEditTileURL}" CommandParameter="{Binding}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}">
                            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p33:ImageAwesome.Icon="Link" xmlns:p33="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                          </Button>
                          <Button Width="32" Height="32" Margin="5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.Delete}" Command="{Binding ParentViewModel.CommandRemoveTile}" CommandParameter="{Binding}">
                            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p33:ImageAwesome.Icon="Trash" xmlns:p33="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
                          </Button>
                        </WrapPanel>
                        <ComboBox MinWidth="200" Margin="10,10,15,0" DockPanel.Dock="Top" ItemTemplate="{DynamicResource DataTemplateCategoryAttribute}" ItemsSource="{Binding ParentViewModel.PackageAttributes}" SelectedItem="{Binding SelectedAttribute}" Visibility="{Binding TileCommandType, Converter={StaticResource TileCommandIsCustomToVisibilityConverter}}" />
                        <Grid Margin="2" DockPanel.Dock="Top">
                          <Border Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#333333" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <Border Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFFFFFFF" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                          <StackPanel Margin="2" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
                            <TextBlock HorizontalAlignment="Center" Foreground="#FFFFFFFF" Text="{x:Static l:Strings.CustomSize}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock HorizontalAlignment="Center" Foreground="#333333" Text="{x:Static l:Strings.CustomSize}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                              <TextBox Text="{Binding CustomWidth}">
                                <i:Interaction.Behaviors>
                                  <behaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                                  <behaviors:TextBoxBehaviorSelectAllTextWhenFocused />
                                  <behaviors:TextBoxBehaviorLimitInputToNumericValuesTextBoxBehavior />
                                </i:Interaction.Behaviors>
                              </TextBox>
                              <TextBlock Text=" x " />
                              <TextBox Text="{Binding CustomHeight}">
                                <i:Interaction.Behaviors>
                                  <behaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                                  <behaviors:TextBoxBehaviorSelectAllTextWhenFocused />
                                  <behaviors:TextBoxBehaviorLimitInputToNumericValuesTextBoxBehavior />
                                </i:Interaction.Behaviors>
                              </TextBox>
                            </StackPanel>
                          </StackPanel>
                        </Grid>
                      </DockPanel>
                    </Grid>
                    <Grid Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="{Binding Size, ConverterParameter=False, Converter={StaticResource TileSizeToTextVisibilityConverter}}">
                      <Grid>
                        <TextBlock Margin="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Title}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Margin="5,5,5,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontSize="18" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding Title}" Visibility="{Binding TileViewDesignsVM.IsLightTheme, ConverterParameter=True, Source={StaticResource Locator}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      </Grid>
                    </Grid>
                  </Grid>
                </dx:ContentControlBase.Content>
              </dxlc:Tile>
            </DataTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxStyleAvailableTiles" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{StaticResource ListBox.Static.Background}" />
        <Setter Property="BorderBrush" Value="{StaticResource ListBox.Static.Border}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <ScrollViewer Padding="0" Focusable="False" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </ScrollViewer>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FocusVisual2">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate>
              <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeDashArray="1 2" StrokeThickness="1" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Name="TileUIGrid" Width="{Binding ActualWidth, ElementName=GridMain}" Background="{Binding TileBackgroundColor, Converter={StaticResource ColorToBrushConverter}, UpdateSourceTrigger=PropertyChanged}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <i:Interaction.Triggers>
      <ei:DataTrigger Value="True" Binding="{Binding IsInEditMode}">
        <ei:ControlStoryboardAction>
          <ei:StoryboardAction.Storyboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ToolboxBorder" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame KeyTime="0:00:01" Value="336">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ei:StoryboardAction.Storyboard>
        </ei:ControlStoryboardAction>
      </ei:DataTrigger>
      <ei:DataTrigger Value="False" Binding="{Binding IsInEditMode}">
        <ei:ControlStoryboardAction>
          <ei:StoryboardAction.Storyboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ToolboxBorder" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame KeyTime="0:00:0.3" Value="0">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ei:StoryboardAction.Storyboard>
        </ei:ControlStoryboardAction>
      </ei:DataTrigger>
    </i:Interaction.Triggers>
    <Border Name="ToolboxBorder" Grid.ColumnSpan="1" Width="0">
      <Grid Background="#FFB6B6B6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="5" />
        </Grid.ColumnDefinitions>
        <DockPanel Margin="10">
          <StackPanel Margin="0,0,0,10" HorizontalAlignment="Right" DockPanel.Dock="Top" Orientation="Horizontal">
            <Button Name="AddCustomTile" Width="36" Height="36" Margin="0,0,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.AddCustomTile}" Command="{Binding CommandAddCustomTile}">
              <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p25:ImageAwesome.Icon="Plus" xmlns:p25="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
            </Button>
          </StackPanel>
          <ListBox MinWidth="310" HorizontalAlignment="Center" DockPanel.Dock="Top" ItemTemplate="{DynamicResource DataTemplateTileList}" Style="{DynamicResource ListBoxStyleAvailableTiles}" Background="{x:Null}" BorderBrush="{x:Null}" ItemsSource="{Binding AvailableTiles}" />
        </DockPanel>
      </Grid>
    </Border>
    <Viewbox Grid.Column="1" VerticalAlignment="Center">
      <dxlc:TileLayoutControl Margin="0,0,0,0" Padding="10" AllowMaximizedElementMoving="True" GroupHeaderSpace="10" ItemMovingAnimationDuration="0:0:0.5" LayerSpace="10" MovingItemPlaceHolderBrush="#4C000000" Orientation="Vertical" ScrollViewer.VerticalScrollBarVisibility="Disabled" Style="{DynamicResource CSTileLayoutControlStyle}" AllowAddFlowBreaksDuringItemMoving="{Binding IsInEditMode}" AllowItemMoving="{Binding IsInEditMode}" ItemsSource="{Binding Tiles}" TouchUp="TileLayoutControl_TouchUp" />
    </Viewbox>
    <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Background="#4C000000" Orientation="Horizontal" Visibility="{Binding IsInEditMode, ConverterParameter=False, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Popup Name="Popup" Placement="Top" StaysOpen="False">
        <Grid>
          <view:ColorPickerView DataContext="{Binding TileViewDesignsVM.ColorPickerViewModel, Source={StaticResource Locator}}" />
        </Grid>
      </Popup>
      <ToggleButton Width="32" Height="32" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static l:Strings.BackgroundColor}" Command="{Binding CommandSetBackgroundColor}" IsChecked="{Binding IsOpen, ElementName=Popup, Mode=TwoWay}">
        <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p22:ImageAwesome.Icon="PaintBrush" xmlns:p22="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
      </ToggleButton>
      <ToggleButton Width="32" Height="32" Margin="15,5,5,5" VerticalAlignment="Center" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static l:Strings.LightDarkTheme}" IsChecked="{Binding IsLightTheme}">
        <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p22:ImageAwesome.Foreground="#FF292929" p22:ImageAwesome.Icon="LightbulbOutline" xmlns:p22="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
      </ToggleButton>
      <StackPanel Name="EditTemplatesPanel" Margin="15,5,5,5" VerticalAlignment="Center" Orientation="Horizontal">
        <RadioButton Width="32" Height="32" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" GroupName="Template1" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static l:Strings.LayoutOne}" IsChecked="{Binding IsTemplateOne, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <Grid Width="16" Height="15">
            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p24:ImageAwesome.Icon="Bookmark" xmlns:p24="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
            <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="#FFFFFFFF" Text="1" />
          </Grid>
        </RadioButton>
        <RadioButton Width="32" Height="32" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" GroupName="Template2" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static l:Strings.LayoutTwo}" IsChecked="{Binding IsTemplateTwo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <Grid Width="16" Height="15">
            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p24:ImageAwesome.Icon="Bookmark" xmlns:p24="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
            <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="#FFFFFFFF" Text="2" />
          </Grid>
        </RadioButton>
        <RadioButton Width="32" Height="32" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" GroupName="Template3" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ToggleButtonRoundAction}" ToolTip="{x:Static l:Strings.LayoutThree}" IsChecked="{Binding IsTemplateThree, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <Grid Width="16" Height="15">
            <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p24:ImageAwesome.Icon="Bookmark" xmlns:p24="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
            <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="#FFFFFFFF" Text="3" />
          </Grid>
        </RadioButton>
      </StackPanel>
      <StackPanel Name="EditActionsPanel" Margin="15,5,5,5" VerticalAlignment="Center" Orientation="Horizontal">
        <Button Width="32" Height="32" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.ResetLayout}" Command="{Binding CommandResetLayout}" Click="TileLayoutControl_TouchUp">
          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p23:ImageAwesome.Icon="Refresh" xmlns:p23="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
        </Button>
        <Button Width="32" Height="32" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.CANCEL}" Command="{Binding CommandCancelLayout}">
          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p23:ImageAwesome.Icon="Times" UIElement.RenderTransformOrigin="0.5,0.5" xmlns:p23="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
        </Button>
        <Button Width="32" Height="32" Margin="5,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.Save}" Command="{Binding CommandSaveLayout}">
          <ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p23:ImageAwesome.Icon="Save" xmlns:p23="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
        </Button>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>