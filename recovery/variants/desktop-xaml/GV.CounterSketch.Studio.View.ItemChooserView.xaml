<?xml version="1.0" encoding="utf-8"?>
<ListBox x:Class="GV.CounterSketch.Studio.View.ItemChooserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="ItemChooserViewControl" FontFamily="Helvetica Neue LT Std" ItemContainerStyle="{DynamicResource ListBoxItemStyleChooserContainer}" ItemTemplate="{DynamicResource DataTemplateItems}" Template="{DynamicResource ChooserControlTemplate}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="ChooserControlTemplate" TargetType="{x:Type ListBox}">
        <Grid Name="root" Background="#FFFFFFFF">
          <Border Margin="0" BorderBrush="#FF707070" BorderThickness="1">
            <DockPanel>
              <TextBlock Margin="5,10,5,0" HorizontalAlignment="Center" DockPanel.Dock="Top" FontSize="14" TextWrapping="Wrap" Text="{Binding TitleTranslated}" />
              <Path Margin="10,5" Data="F1 M2132.01,660.616 L2411.97,660.616" DockPanel.Dock="Top" Stretch="Fill" Stroke="#FFCCC6C1" StrokeMiterLimit="2.75" />
              <ScrollViewer Name="ItemsListBox" MaxHeight="350" Margin="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}">
                <UniformGrid IsItemsHost="True" Columns="{Binding Columns}" />
              </ScrollViewer>
              <Path Margin="10,10,10,5" Data="F1 M2132.01,660.616 L2411.97,660.616" DockPanel.Dock="Top" Stretch="Fill" Stroke="#FFCCC6C1" StrokeMiterLimit="2.75" Visibility="{Binding IsFilterPicker, ConverterParameter=True, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBlock Margin="10,5" DockPanel.Dock="Top" FontSize="14" TextWrapping="Wrap" MaxWidth="{Binding ElementName=ItemsListBox, Path=ActualWidth}" Text="{Binding MouseOverText}" Visibility="{Binding IsFilterPicker, ConverterParameter=True, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <TextBlock Height="72" Margin="10,0,10,5" VerticalAlignment="Top" DockPanel.Dock="Top" FontSize="10" TextWrapping="Wrap" MaxWidth="{Binding ElementName=ItemsListBox, Path=ActualWidth}" Text="{Binding MouseOverDescription}" Visibility="{Binding IsFilterPicker, ConverterParameter=True, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Path Margin="10,5" Data="F1 M2132.01,660.616 L2411.97,660.616" DockPanel.Dock="Top" Stretch="Fill" Stroke="#FFCCC6C1" StrokeMiterLimit="2.75" Visibility="{Binding IsFilterPicker, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <StackPanel Margin="5,5,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Orientation="Horizontal" Visibility="{Binding IsFilterPicker, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button Height="24" MinWidth="50" Margin="5,0,0,0" Content="{x:Static localization:Strings.Clear}" Command="{Binding CommandClear}" />
                <Button Height="24" MinWidth="50" Margin="5,0,0,0" Command="{Binding CommandCancel}" Content="{Binding Source={x:Static localization:Strings.CANCEL}, Converter={StaticResource StringToTitleCaseConverter}}" />
                <Button Height="24" MinWidth="50" Margin="5,0,0,0" Command="{Binding CommandOK}" Content="{Binding Source={x:Static localization:Strings.OK}}" />
              </StackPanel>
            </DockPanel>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="Selection" />
            </VisualStateManager.VisualStateGroups>
          </Border>
        </Grid>
      </ControlTemplate>
      <DataTemplate x:Key="DataTemplateItems">
        <Grid Margin="0" Visibility="{Binding SearchAttributeId, ConverterParameter=-1, Converter={StaticResource IntegerToVisibilityConverter}}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseEnter">
              <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandUpdateMouseOverText, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}}" CommandParameter="{Binding}" />
            </i:EventTrigger>
            <i:EventTrigger EventName="MouseLeave">
              <i:InvokeCommandAction Command="{Binding Path=DataContext.CommandResetMouseOverText, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Border Width="100" Height="100" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#FFFFFFFF" BorderBrush="#FF9B9B9B" BorderThickness="1" Cursor="Hand" ToolTip="{Binding PrimaryText}" Visibility="{Binding Path=IsFilterPicker, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Margin="0" Stretch="Fill" Source="{Binding ImagePath, Mode=OneWay}" />
          </Border>
          <Border Width="30" Height="30" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="#FF9B9B9B" BorderThickness="1" ToolTip="{Binding PrimaryText}" Visibility="{Binding Path=IsGemPicker, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Image Margin="0" Stretch="Fill" Source="{Binding ImagePath, Mode=OneWay}" />
          </Border>
          <Border Width="56" Height="56" Margin="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="#FF9B9B9B" BorderThickness="1" Visibility="{Binding Path=IsMetalPicker, RelativeSource={RelativeSource FindAncestor, AncestorType=local:ItemChooserView}, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Image Margin="0" Stretch="Fill" Source="{Binding ImagePath, Mode=OneWay}" ToolTip="{Binding PrimaryText}" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Abbreviation, FallbackValue=14KY}" />
            </Grid>
          </Border>
        </Grid>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleChooserContainer" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid Width="Auto" Height="Auto" Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                <Viewbox Name="viewbox" Width="17.479" Height="17.632" HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Hidden">
                  <Canvas Width="17.479" Height="17.6323">
                    <Path Canvas.Left="0" Canvas.Top="0" Width="17.479" Height="17.6323" Data="F1 M3.08203,17.6323 L17.479,17.6323 L17.479,2.92908 C15.6245,1.1167 13.0869,0 10.2888,0 C4.60498,0 0,4.60516 0,10.2886 C0,13.1649 1.17969,15.7654 3.08203,17.6323" Fill="#FFFFFFFF" Stretch="Fill" />
                    <Path Canvas.Left="3.98364" Canvas.Top="5.43921" Width="12.6096" Height="9.69897" Data="F1 M8.83325,15.1382 L3.98364,10.2886 L5.92334,8.34875 L8.83325,11.2585 L14.6536,5.43921 L16.5933,7.37909 L8.83325,15.1382" Fill="#FF4E8499" Stretch="Fill" />
                  </Canvas>
                </Viewbox>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="viewbox" Storyboard.TargetProperty="(UIElement.Visibility)">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SelectedUnfocused">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="viewbox" Storyboard.TargetProperty="(UIElement.Visibility)">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
</ListBox>