<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.DesignReport" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:clr="clr-namespace:System;assembly=mscorlib" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:viewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" x:Name="DesignReportControl" Margin="0" Padding="0,0,10,0" Background="#FFFFFFFF" FontFamily="Helvetica Neue LT Std" FontSize="13.333" DataContext="{Binding Path=GemReportVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ListBoxStyle1" TargetType="{x:Type ListBox}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="Both" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Name="Bd" Padding="1" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Padding="{TemplateBinding Control.Padding}" Focusable="False">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="ItemsControl.IsGrouping" Value="True" />
                    <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
                  </MultiTrigger.Conditions>
                  <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="DataTemplateStoneReport" DataType="viewModel:GemGroup">
        <Grid Margin="0" Background="#FFFFFFFF">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="75*" />
            <ColumnDefinition Width="135*" />
            <ColumnDefinition Width="85*" />
            <ColumnDefinition Width="265*" />
            <ColumnDefinition Width="65*" />
            <ColumnDefinition Width="85*" />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition MinHeight="30" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Image Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="60" Height="60" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Source="{Binding Image}" />
          <Popup Name="PopupImage" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" HorizontalOffset="80" Placement="Relative" StaysOpen="False">
            <Border Background="#FFFFFFFF" BorderBrush="#FF000000" BorderThickness="1">
              <Grid>
                <Image Width="640" Height="640" Stretch="Uniform" Source="{Binding StullerImage}" />
              </Grid>
            </Border>
          </Popup>
          <Image Name="StullerImage" Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Width="60" Height="60" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="True" Source="{Binding StullerImage}" Visibility="{Binding StullerImage, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseUp" SourceObject="{Binding ElementName=StullerImage}">
                <ei:ChangePropertyAction PropertyName="IsOpen" Value="True" TargetObject="{Binding ElementName=PopupImage}" />
              </i:EventTrigger>
              <i:EventTrigger EventName="MouseLeave" SourceObject="{Binding ElementName=StullerImage}">
                <ei:ChangePropertyAction PropertyName="IsOpen" Value="False" TargetObject="{Binding ElementName=PopupImage}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </Image>
          <Border Grid.Row="0" Grid.Column="1" Height="25" Margin="0,0,1,0" VerticalAlignment="Top" Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FFFFFFFF">
            <TextBlock Margin="20,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Source={x:Static l:Strings.TYPE}, Converter={StaticResource StringToTitleCaseConverter}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="2" Height="25" Margin="0,0,1,0" VerticalAlignment="Top" Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FFFFFFFF">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Source={x:Static l:Strings.SHAPE}, Converter={StaticResource StringToTitleCaseConverter}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="3" Height="25" Margin="0,0,1,0" VerticalAlignment="Top" Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FFFFFFFF">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Source={x:Static l:Strings.DETAILS}, Converter={StaticResource StringToTitleCaseConverter}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="4" Height="25" Margin="0,0,1,0" VerticalAlignment="Top" Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FFFFFFFF">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Source={x:Static l:Strings.CARAT}, Converter={StaticResource StringToTitleCaseConverter}}" />
          </Border>
          <Border Grid.Row="0" Grid.Column="5" Height="25" Margin="0,0,1,0" VerticalAlignment="Top" Background="{DynamicResource WindowFrameBackground}" BorderBrush="#FFFFFFFF">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Source={x:Static l:Strings.QTY}, Converter={StaticResource StringToTitleCaseConverter}}" />
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Height="Auto" VerticalAlignment="Stretch" Background="{DynamicResource BaseBackground}" BorderThickness="0,0,1,0" Opacity="0.2" BorderBrush="{x:Null}" />
          <TextBlock Name="StoneType" Grid.Row="1" Grid.Column="1" Margin="5,0" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Type}" />
          <Border Grid.Row="1" Grid.Column="2" Height="Auto" Margin="0,0,1,0" VerticalAlignment="Stretch" Background="{DynamicResource BaseBackground}" Opacity="0.2" BorderBrush="{x:Null}" />
          <TextBlock Name="Shape" Grid.Row="1" Grid.Column="2" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Shape}" />
          <Border Grid.Row="1" Grid.Column="3" Height="Auto" Margin="0,0,1,0" VerticalAlignment="Stretch" Background="{DynamicResource BaseBackground}" Opacity="0.2" BorderBrush="{x:Null}" />
          <StackPanel Grid.Row="1" Grid.Column="3" Margin="0,4,0,4" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Name="Details" Height="Auto" HorizontalAlignment="Center" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding Details}" ToolTip="{Binding Details}" />
            <TextBlock Height="Auto" HorizontalAlignment="Center" Style="{StaticResource TextBlockStyleAutomaticTooltip}" Text="{Binding StullerDescription}" ToolTip="{Binding StullerDescription}" Visibility="{Binding StullerDescription, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}" />
          </StackPanel>
          <Border Grid.Row="1" Grid.Column="4" Height="Auto" Margin="0,0,1,0" VerticalAlignment="Stretch" Background="{DynamicResource BaseBackground}" Opacity="0.2" BorderBrush="{x:Null}" />
          <TextBlock Name="Carat" Grid.Row="1" Grid.Column="4" Height="Auto" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Carat, StringFormat={}{0:N2}}" />
          <Border Name="CaratToolTip" Grid.Row="1" Grid.Column="4" Background="#00000000" ToolTipService.HasDropShadow="True">
            <FrameworkElement.Resources>
              <ResourceDictionary>
                <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
                  <Setter Property="Background" Value="#00FFFFFF" />
                  <Setter Property="BorderBrush" Value="#00FFFFFF" />
                </Style>
              </ResourceDictionary>
            </FrameworkElement.Resources>
            <FrameworkElement.ToolTip>
              <controls:GemCaratToolTipControl DataContext="{TemplateBinding ContentPresenter.Content}" />
            </FrameworkElement.ToolTip>
          </Border>
          <Border Grid.Row="1" Grid.Column="5" Height="Auto" Margin="0,0,1,0" VerticalAlignment="Stretch" Background="{DynamicResource BaseBackground}" Opacity="0.2" BorderBrush="{x:Null}" />
          <TextBlock Name="Quantity" Grid.Row="1" Grid.Column="5" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Quantity}" />
          <DockPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Width="Auto" Height="Auto" Margin="0,10" HorizontalAlignment="Stretch" VerticalAlignment="Center">
            <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static l:Strings.Source}, Converter={StaticResource StringToTitleCaseConverter}}" />
            <ComboBox Name="comboBoxMeleeSource" Width="Auto" Margin="4,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Style="{DynamicResource CSComboBoxStyleBasic}" ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding Source}" />
          </DockPanel>
          <StackPanel Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="5" Margin="0,5" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
            <Border Width="1" Height="34" Margin="0,5,10,5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Border.Background>
                <SolidColorBrush Color="{DynamicResource ToolHeaderBackgroundColor}" />
              </Border.Background>
            </Border>
            <StackPanel Name="PurchaseStoneOptions" Width="Auto" Height="Auto" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding Source, ConverterParameter={x:Static l:Strings.Purchase_Stone_s}, Converter={StaticResource SourceTextAndParameterToVisibilityConverter}}">
              <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static l:Strings.Quality}, Converter={StaticResource StringToTitleCaseConverter}}" />
              <ComboBox Name="comboBoxMeleeQuality" Margin="4,0,10,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" FontFamily="Lucida Console" Style="{DynamicResource CSComboBoxStyleBasic}" TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed" ItemsSource="{Binding StoneQualities}" SelectedItem="{Binding StoneQuality}">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="SelectionChanged">
                    <command:EventToCommand Command="{Binding GemReportVM.CommandUpdateSourceMeleeGems, Source={StaticResource Locator}}" CommandParameter="{Binding SelectedIndex, ElementName=comboBoxMeleeQuality}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </ComboBox>
              <ToggleButton Name="btnToggleInfo" Width="10" Margin="5,2,0,0" VerticalAlignment="Top" Template="{DynamicResource InfoToggleButton}" Visibility="{Binding IsGemstone, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />
              <Popup Name="PopupQualityInfo" HorizontalOffset="16" Placement="Bottom" StaysOpen="False" VerticalOffset="0" IsOpen="{Binding IsChecked, ElementName=btnToggleInfo}" PlacementTarget="{Binding ElementName=btnToggleInfo}">
                <Border Width="600" Background="#FFFFFFFF" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseLeftButtonDown">
                      <ei:ChangePropertyAction PropertyName="IsChecked" Value="False" TargetObject="{Binding ElementName=btnToggleInfo}" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                  <StackPanel Margin="10">
                    <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Source={x:Static l:Strings.Quality}, Converter={StaticResource StringToTitleCaseConverter}}" />
                    <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF000000" TextWrapping="Wrap">
                      <Run Text="AAA - " /> <Run Text="{x:Static l:Strings.AAAExplanation}" /> <Run Text="&#xA;&#xA;" /> <Run Text="AA  - " /> <Run Text="{x:Static l:Strings.AAExplanation}" /> <Run Text="&#xA;&#xA;" /> <Run Text="A   - " /> <Run Text="{x:Static l:Strings.AExplanation}" /></TextBlock>
                    <TextBlock Margin="0,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF000000" Text="{x:Static l:Strings.QualityNote}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Popup>
              <Viewbox Margin="10,0,0,0" Cursor="Hand" ToolTip="{Binding Error}" Visibility="{Binding HasErrors, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl Width="18" Height="15" Margin="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Left" Content="{StaticResource Icon_Warning}" />
              </Viewbox>
            </StackPanel>
            <StackPanel Name="NoStoneSuppliedOptions" Width="383.952" VerticalAlignment="Center" Visibility="{Binding Source, ConverterParameter={x:Static l:Strings.No_Stone_s_Supplied}, Converter={StaticResource SourceTextAndParameterToVisibilityConverter}}">
              <TextBlock VerticalAlignment="Center" FontStyle="Italic" Text="{x:Static l:Strings.NoStoneSuppliedNote}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleGemReport" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <StackPanel Background="#00FFFFFF" OpacityMask="#FFFFFFFF" SnapsToDevicePixels="True">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="MouseEnter">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightGem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:DesignReport}}}" CommandParameter="{Binding}" />
                  </i:EventTrigger>
                  <i:EventTrigger EventName="MouseLeave">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightCancel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:DesignReport}}}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected" />
                    <VisualState x:Name="SelectedUnfocused" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
            <TriggerBase.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(ListBoxItem.IsSelected)">
                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                  </BooleanAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.EnterActions>
          </DataTrigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Background" Value="{DynamicResource WindowFrameBackground}" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ListBoxItemStyleGemGroupReport" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <StackPanel Name="stackPanel" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="MouseEnter">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightGemGroup, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:DesignReport}}}" CommandParameter="{Binding}" />
                  </i:EventTrigger>
                  <i:EventTrigger EventName="MouseLeave">
                    <command:EventToCommand Command="{Binding DataContext.CommandHighlightCancel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type controls:DesignReport}}}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Unselected" />
                    <VisualState x:Name="Selected" />
                    <VisualState x:Name="SelectedUnfocused" />
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="ValidationStates">
                    <VisualState x:Name="Valid" />
                    <VisualState x:Name="InvalidFocused" />
                    <VisualState x:Name="InvalidUnfocused" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </StackPanel>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <DataTrigger Value="True" Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}">
            <TriggerBase.EnterActions>
              <BeginStoryboard>
                <Storyboard>
                  <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="(ListBoxItem.IsSelected)">
                    <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
                  </BooleanAnimationUsingKeyFrames>
                </Storyboard>
              </BeginStoryboard>
            </TriggerBase.EnterActions>
          </DataTrigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Background" Value="{DynamicResource WindowFrameBackground}" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
