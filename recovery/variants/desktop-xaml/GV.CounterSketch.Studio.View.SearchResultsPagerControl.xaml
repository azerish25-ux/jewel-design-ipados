<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.SearchResultsPagerControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:sys="clr-namespace:System;assembly=mscorlib" DataContext="{Binding TileSearchMainVM.ActiveSearchResultViewModel, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <converters:TwoObjectsEqualToVisibilityConverter x:Key="LocalObjectsEqualConverter" />
      <DataTemplate x:Key="DataTemplatePageNumber" DataType="Integer">
        <Button Margin="4,0" Background="#00FFFFFF" Cursor="Hand" Style="{StaticResource ButtonStyleClear}" Command="{Binding DataContext.CommandGotoPage, RelativeSource={RelativeSource AncestorType=UserControl, Mode=FindAncestor, AncestorLevel=1}}" CommandParameter="{Binding}">
          <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Height="30" MinWidth="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource HighlightAndAccent}">
              <UIElement.Visibility>
                <MultiBinding FallbackValue="Hidden" Converter="{StaticResource LocalObjectsEqualConverter}">
                  <Binding />
                  <Binding Path="DataContext.PageNumber" RelativeSource="{RelativeSource AncestorLevel=1, Mode=FindAncestor, AncestorType={x:Type UserControl}}" />
                </MultiBinding>
              </UIElement.Visibility>
              <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" TextAlignment="Center" Text="{Binding}" />
            </Border>
            <Border Height="30" MinWidth="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD">
              <UIElement.Visibility>
                <MultiBinding ConverterParameter="True" Converter="{StaticResource LocalObjectsEqualConverter}">
                  <Binding />
                  <Binding Path="DataContext.PageNumber" RelativeSource="{RelativeSource AncestorLevel=1, Mode=FindAncestor, AncestorType={x:Type UserControl}}" />
                </MultiBinding>
              </UIElement.Visibility>
              <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF000000" TextAlignment="Center" Text="{Binding}" />
            </Border>
          </Grid>
        </Button>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplateHorizontal">
        <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <StackPanel Margin="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="#FFFFFFFF" DockPanel.Dock="Bottom" Orientation="Horizontal">
      <Button Name="ButtonPrevious" Margin="6,0" Background="#00FFFFFF" Cursor="Hand" Style="{StaticResource ButtonStyleClear}" Command="{Binding CommandGotoPreviousPage}" IsEnabled="{Binding ShowPreviousPageButton}">
        <Border Width="50" Height="30" Background="#FFDDDDDD">
          <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M-2,6 L4,12 L4,0" Fill="#FF000000">
            <FrameworkElement.LayoutTransform>
              <ScaleTransform ScaleX="1.5" ScaleY="1.2" />
            </FrameworkElement.LayoutTransform>
          </Path>
        </Border>
      </Button>
      <Button Name="ButtonFirst" Margin="6,0" BorderThickness="0" Cursor="Hand" Style="{StaticResource ButtonStyleClear}" Command="{Binding CommandGotoFirstPage}" IsEnabled="{Binding ShowFirstPageButton}">
        <Border Height="30" MinWidth="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD">
          <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF000000" Text="1" TextAlignment="Center">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource LocalObjectsEqualConverter}" ConverterParameter="True">
                <Binding Source="1" />
                <Binding Path="DataContext.PageNumber" RelativeSource="{RelativeSource AncestorLevel=1, Mode=FindAncestor, AncestorType={x:Type UserControl}}" />
              </MultiBinding>
            </UIElement.Visibility>
          </TextBlock>
        </Border>
      </Button>
      <Border Width="1" Margin="6,0" BorderBrush="#FF000000" BorderThickness="1,0,0,0" />
      <ItemsControl Margin="2,0" BorderBrush="#00FFFFFF" BorderThickness="0" Focusable="False" FontSize="14" Foreground="#FF000000" ItemTemplate="{DynamicResource DataTemplatePageNumber}" ItemsPanel="{DynamicResource ItemsPanelTemplateHorizontal}" ItemsSource="{Binding Pages}" />
      <Border Width="1" Margin="6,0" BorderBrush="#FF000000" BorderThickness="1,0,0,0" />
      <Button Name="ButtonLast" Margin="6,0" BorderThickness="0" Cursor="Hand" Foreground="#FFFFFFFF" Style="{StaticResource ButtonStyleClear}" Command="{Binding CommandGotoLastPage}" IsEnabled="{Binding ShowLastPageButton}">
        <Border Height="30" MinWidth="30" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDDDDD">
          <TextBlock Margin="0,3,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF000000" TextAlignment="Center" Text="{Binding NumberOfPages}">
            <UIElement.Visibility>
              <MultiBinding Converter="{StaticResource LocalObjectsEqualConverter}" ConverterParameter="True">
                <Binding Path="NumberOfPages" />
                <Binding Path="DataContext.PageNumber" RelativeSource="{RelativeSource AncestorLevel=1, Mode=FindAncestor, AncestorType={x:Type UserControl}}" />
              </MultiBinding>
            </UIElement.Visibility>
          </TextBlock>
        </Border>
      </Button>
      <Button Name="ButtonNext" Margin="6,0,0,0" Cursor="Hand" Style="{StaticResource ButtonStyleClear}" Command="{Binding CommandGotoNextPage}" IsEnabled="{Binding ShowNextPageButton}">
        <Border Width="50" Height="30" Background="#FFDDDDDD">
          <Path HorizontalAlignment="Center" VerticalAlignment="Center" Data="M-2,6 L4,12 L4,0" Fill="#FF000000">
            <FrameworkElement.LayoutTransform>
              <TransformGroup>
                <RotateTransform Angle="180" />
                <ScaleTransform ScaleX="1.5" ScaleY="1.2" />
              </TransformGroup>
            </FrameworkElement.LayoutTransform>
          </Path>
        </Border>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>