          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ConfirmationStates">
              <VisualState x:Name="Base" />
              <VisualState x:Name="Delete_">
                <Storyboard>
                  <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border1" Storyboard.TargetProperty="(UIElement.Visibility)">
                    <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DesignHistoryItemDataTemplate" DataType="objects:Design">
        <Grid Name="borderMain" Margin="0,0,25,0">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeave">
              <ic:GoToStateAction StateName="Base" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Grid Margin="0,10,0,0" Background="{x:Null}">
            <Grid Name="theImageGrid" Width="180" Height="158" Margin="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="85*" />
                <RowDefinition Height="19*" />
              </Grid.RowDefinitions>
              <Grid Row="0" Background="#FFFFFFFF">
                <Border Name="ImageBorder" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1" ClipToBounds="True" CornerRadius="0" Cursor="Hand">
                  <Grid>
                    <TextBlock HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13.333" TextWrapping="Wrap" Text="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}}}">
                      <TextBlock.Foreground>
                        <SolidColorBrush Color="{DynamicResource TextSecondaryColor}" />
                      </TextBlock.Foreground>
                    </TextBlock>
                    <Image Name="imgLoadJob" Width="Auto" Height="Auto" Margin="0" VerticalAlignment="Stretch" SnapsToDevicePixels="True" Stretch="Uniform" Source="{Binding FavoriteImagePath, Mode=OneWay, Converter={converters:ImagePathToBitmapImageConverter}}">
                      <i:Interaction.Behaviors>
                        <gvCounterSketchStudioUtilitiesBehaviors:UIElementBehaviorMouseDoubleClickCommand CommandParameter="{Binding Mode=OneWay}" DoubleClickCommand="{Binding DataContext.CommandOpenDesign, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type view:PortfolioManagerView}}}" />
                      </i:Interaction.Behaviors>
                    </Image>
                  </Grid>
                </Border>
              </Grid>
              <TextBox Name="textUserDesignName" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" CaretBrush="{DynamicResource HighlightAndAccent}" Cursor="IBeam" Foreground="{DynamicResource BaseBackground}" TextWrapping="NoWrap" ToolTip="{x:Static localization:Strings.ClickHereToRenameDesign}" Background="{x:Null}" BorderBrush="{x:Null}" Text="{Binding CSUserDesignName, StringFormat={}{0:d}, Mode=TwoWay}">
                <i:Interaction.Behaviors>
                  <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorLoseFocusOnEnterKeyUp />
                  <gvCounterSketchStudioUtilitiesBehaviors:TextBoxBehaviorSelectAllTextWhenFocused />
                </i:Interaction.Behaviors>
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type TextBox}" BasedOn="{x:Null}">
                    <Setter Property="Padding" Value="1" />
                    <Setter Property="UIElement.AllowDrop" Value="True" />
                    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                          <Border Width="Auto" Height="Auto" BorderThickness="1" CornerRadius="4" BorderBrush="{x:Null}">
                            <Border Background="#02000000" CornerRadius="1">
                              <ScrollViewer Name="PART_ContentHost" Height="Auto" Background="#02000000" Foreground="#FFFFFFFF" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" TextBlock.Foreground="#FFFFFFFF" />
                            </Border>
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" Property="Foreground" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
                  </Style>
                </FrameworkElement.Style>
                <i:Interaction.Triggers>
                  <i:EventTrigger EventName="LostFocus">
                    <command:EventToCommand Command="{Binding DataContext.CommandUpdateDesignUserLabel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type view:PortfolioManagerView}}}" CommandParameter="{Binding Mode=OneWay}" />
                  </i:EventTrigger>
                </i:Interaction.Triggers>
              </TextBox>
            </Grid>
            <Button Name="btnSubMenu" Width="12" Height="13" Margin="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" Cursor="Hand" Style="{DynamicResource CSSubMenuButton}" Template="{DynamicResource CS4ButtonPrimary}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="Click">
                  <ic:GoToStateAction StateName="ConfirmDelete" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <Control.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Offset="0" Color="#FFF3F3F3" />
                  <GradientStop Offset="0.5" Color="#FFEBEBEB" />
                  <GradientStop Offset="0.5" Color="#FFDDDDDD" />
                  <GradientStop Offset="1" Color="White" />
                </LinearGradientBrush>
              </Control.Background>
              <Path Width="8.255" Height="8.255" Data="M2616.74,-700.671 L2623.5,-707.425 M2616.74,-707.424 L2623.5,-700.67" Stretch="Fill" Stroke="#FF454341" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
            </Button>
            <Border Name="borderConfirmDelete" Background="#CAFFFFFF" BorderThickness="0" CornerRadius="0" Visibility="Collapsed" BorderBrush="{x:Null}">
              <Grid Name="grid" Opacity="1">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Orientation="Vertical">
                  <TextBlock Name="textBlock" Margin="0,0,0,10" HorizontalAlignment="Center" FontSize="26.667" Foreground="{DynamicResource TextBoxAndFrameBackground}" Text="{x:Static localization:Strings.Delete}" TextWrapping="Wrap" />
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                    <Button Name="buttonConfirmDelete" Width="50" Height="20" Margin="5,0" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.Yes}" FontSize="10.667" Style="{DynamicResource CSButton}">
                      <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                          <command:EventToCommand Command="{Binding DataContext.CommandDeleteDesignFromPortfolio, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type view:PortfolioManagerView}}}" CommandParameter="{Binding Mode=OneWay}" />
                        </i:EventTrigger>
                      </i:Interaction.Triggers>
                      <Control.Foreground>
                        <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                      </Control.Foreground>
                    </Button>
                    <Button Name="buttonCancelDelete" Width="50" Height="20" Margin="5,0" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.No}" FontSize="10.667" Style="{DynamicResource CSButton}">
                      <Control.Foreground>
                        <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                      </Control.Foreground>
                      <i:Interaction.Triggers>
                        <i:EventTrigger EventName="Click">
                          <ic:GoToStateAction StateName="Base" />
                        </i:EventTrigger>
                      </i:Interaction.Triggers>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
            <ToggleButton Width="Auto" Margin="2,0,0,32" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF00" Template="{DynamicResource CS4ToggleButtonFavorite}" Background="{x:Null}" BorderBrush="{x:Null}" IsChecked="{Binding IsFavorite}" />
          </Grid>
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="ActionStates">
              <VisualState x:Name="Base" />
              <VisualState x:Name="ConfirmDelete">
                <Storyboard>
                  <ObjectAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="borderConfirmDelete" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="00:00:00.0010000">
                    <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
                  </ObjectAnimationUsingKeyFrames>
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="textBlock" Storyboard.TargetProperty="(TextElement.FontSize)">
                    <EasingDoubleKeyFrame KeyTime="0" Value="24" />
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="SpiDataTemplate" DataType="objects:Design">
        <Grid>
          <Image Width="Auto" Cursor="Hand" Source="{Binding BaseDesignImagePath, Mode=OneWay, Converter={converters:ImagePathToBitmapImageConverter}}" />
          <ToggleButton Width="Auto" Margin="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF00" Template="{DynamicResource CS4ToggleButtonFavorite}" Background="{x:Null}" BorderBrush="{x:Null}" IsChecked="{Binding IsFavorite}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="FavoritesDataTemplate" DataType="objects:Design">
        <Grid>
          <Image Width="Auto" Cursor="Hand" Source="{Binding Mode=OneWay, Converter={converters:DesignToFavoriteImageConverter}}" />
          <ToggleButton Width="Auto" Margin="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Foreground="#FFFFFF00" Template="{DynamicResource CS4ToggleButtonFavorite}" Background="{x:Null}" BorderBrush="{x:Null}" IsChecked="{Binding IsFavorite}" />
        </Grid>
      </DataTemplate>
      <DataTemplate x:Key="DataTemplatePortfolioCollection">
        <Grid>
          <TextBlock Width="150" Padding="4" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="Hand" TextWrapping="Wrap" Text="{Binding Name}" />
        </Grid>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplateWrapPanel">
        <WrapPanel Name="WrapPanelScaled" IsItemsHost="True" ItemHeight="{Binding ItemWidth, ElementName=WrapPanelScaled}" ItemWidth="{Binding DesignImageWidth, ConverterParameter=+50.0, Converter={converters:ArithmeticConverter}}" />
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="DesignHistoriesItemsPanelTemplate">
        <StackPanel Name="WrapPanel" HorizontalAlignment="Stretch" IsItemsHost="True" />
      </ItemsPanelTemplate>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplateDesignHistory">
        <VirtualizingStackPanel IsItemsHost="True" Orientation="Horizontal" />
      </ItemsPanelTemplate>
      <Style x:Key="DesignHistoriesListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource FindAncestor, AncestorLevel=1, AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle">
          <Setter.Value>
            <Style>
              <Setter Property="Control.Template">
                <Setter.Value>
                  <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeDashArray="1 2" StrokeThickness="1" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Padding="0" Background="{TemplateBinding Control.Background}" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="Selector.IsSelected" Value="False" />
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <Trigger Property="ItemsControl.AlternationIndex" Value="1">
            <Setter Property="Background" Value="#FFEBEBEB" />
          </Trigger>
          <Trigger Property="ItemsControl.AlternationIndex" Value="0">
            <Setter Property="Background" Value="#FFFFFFFF" />
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="ListBoxItemStyleFavorites" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle">
          <Setter.Value>
            <Style>
              <Setter Property="Control.Template">
                <Setter.Value>
                  <ControlTemplate>
                    <Rectangle Margin="2" SnapsToDevicePixels="True" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeDashArray="1 2" StrokeThickness="1" />
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Border Name="Bd" Margin="20" Background="{TemplateBinding Control.Background}" BorderThickness="2" SnapsToDevicePixels="True">
                <Grid Width="Auto" Height="Auto" VerticalAlignment="Stretch">
                  <i:Interaction.Behaviors>
                    <gvCounterSketchStudioUtilitiesBehaviors:UIElementBehaviorMouseDoubleClickCommand CommandParameter="{Binding Mode=OneWay}" DoubleClickCommand="{Binding Path=PortfolioManagerVM.CommandOpenDesign, Source={StaticResource Locator}}" />
                  </i:Interaction.Behaviors>
                  <Border BorderThickness="1">
                    <Border.BorderBrush>
                      <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
                    </Border.BorderBrush>
                    <ContentPresenter />
                  </Border>
                  <Button Name="deleteButton" Width="15" Height="15" Margin="2,2,2,0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ScrollViewer.CanContentScroll="True" Template="{DynamicResource ButtonStyleDeleteItem}" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}">
                    <i:Interaction.Triggers>
                      <i:EventTrigger EventName="Click">
                        <ic:GoToStateAction StateName="ConfirmDeleteState" />
                      </i:EventTrigger>
                    </i:Interaction.Triggers>
                  </Button>
                  <Border Name="border1" Width="Auto" VerticalAlignment="Stretch" Visibility="Hidden">
                    <Border Name="border" Background="#CAFFFFFF" CornerRadius="0" Visibility="Visible">
                      <Grid Name="gridConfirmDelete">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="1*" />
                          <RowDefinition Height="1*" />
                          <RowDefinition Height="1*" />
                          <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <TextBlock Name="textBlock" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18.667" Foreground="{DynamicResource BrushTextPrimary}" Text="{x:Static localization:Strings.Delete}" TextWrapping="Wrap" />
                        <Button Name="buttonConfirmDelete" Grid.Row="2" Grid.Column="0" Width="80" Height="40" Margin="5,2" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.Yes}" FontSize="18.667" Opacity="1" Style="{DynamicResource CSButton}">
                          <i:Interaction.Triggers>
