<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.PortfolioManagerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:cvrt="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:gvCounterSketchStudioUtilitiesBehaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:ic="clr-namespace:Microsoft.Expression.Interactivity.Core;assembly=Microsoft.Expression.Interactions" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:objects="clr-namespace:GV.CounterSketch.Studio.Model.Objects" xmlns:scrollableListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.ScrollableListBox" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" Title="{x:Static localization:Strings.DesignManager}" BorderBrush="#FFCBC4C0" FontSize="10pt" Foreground="{DynamicResource BaseBackground}" ResizeMode="CanResizeWithGrip" Style="{DynamicResource WindowStyleModal}" DataContext="{Binding Mode=Default, Path=PortfolioManagerVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="ListBox.Static.Background" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ListBox.Static.Border" Color="#FFABADB3" />
      <SolidColorBrush x:Key="ListBox.Disabled.Background" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="ListBox.Disabled.Border" Color="#FFD9D9D9" />
      <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
          <Setter.Value>
            <ControlTemplate />
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="DesignHistoryRowDataTemplate" DataType="objects:Design">
        <Grid Margin="0,0,0,5" Background="{x:Null}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid Row="1" Width="Auto">
            <StackPanel Name="SPI_Image_Grid" Width="Auto" Height="Auto" Margin="0,12,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid Width="146" Height="146" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Top" ZIndex="0">
                <Rectangle Stroke="{DynamicResource LinesLightBrush}" />
                <Image Margin="1" Source="{Binding BaseDesignImagePath, Mode=OneWay, Converter={converters:ImagePathToBitmapImageConverter}}">
                  <i:Interaction.Behaviors>
                    <gvCounterSketchStudioUtilitiesBehaviors:UIElementBehaviorMouseDoubleClickCommand CommandParameter="{Binding Mode=OneWay}" DoubleClickCommand="{Binding DataContext.CommandOpenDesign, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type view:PortfolioManagerView}}}" />
                  </i:Interaction.Behaviors>
                </Image>
                <ToggleButton Width="Auto" Margin="4,0,0,4" HorizontalAlignment="Left" VerticalAlignment="Bottom" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FFFFFF00" Template="{DynamicResource CS4ToggleButtonFavorite}" Background="{x:Null}" BorderBrush="{x:Null}" IsChecked="{Binding IsFavorite}" />
                <Button Name="deleteButton" Width="15" Height="15" Margin="0,2,2,0.5" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" BorderThickness="0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ScrollViewer.CanContentScroll="True" Template="{DynamicResource ButtonStyleDeleteItem}" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="Click">
                      <ic:GoToStateAction StateName="Delete_" />
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                </Button>
                <Border Name="border1" Width="Auto" VerticalAlignment="Stretch" Visibility="Hidden">
                  <Border Name="border" Background="#CAFFFFFF" CornerRadius="0" Visibility="Visible">
                    <Grid Name="gridConfirmDelete">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                      </Grid.RowDefinitions>
                      <TextBlock Name="textBlock" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18.667" Foreground="{DynamicResource BrushTextPrimary}" Text="{x:Static localization:Strings.Delete}" TextWrapping="Wrap" />
                      <Button Name="buttonConfirmDelete" Grid.Row="2" Grid.Column="0" Width="60" Height="30" Margin="5,2" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.Yes}" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="18.667" Opacity="1" Style="{DynamicResource CSButton}">
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="Click">
                            <command:EventToCommand Command="{Binding DataContext.CommandDeleteDesignFromPortfolio, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type view:PortfolioManagerView}}}" CommandParameter="{Binding Mode=OneWay}" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <Control.Foreground>
                          <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                        </Control.Foreground>
                      </Button>
                      <Button Name="buttonCancelDelete" Grid.Row="2" Grid.Column="1" Width="60" Height="30" Margin="5,2" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.No}" FontSize="18.667" Opacity="1" Style="{DynamicResource CSButton}">
                        <Control.Foreground>
                          <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                        </Control.Foreground>
                        <i:Interaction.Triggers>
                          <i:EventTrigger EventName="PreviewMouseUp">
                            <ic:GoToStateAction StateName="Base" UseTransitions="False" />
                          </i:EventTrigger>
                        </i:Interaction.Triggers>
                      </Button>
                    </Grid>
                  </Border>
                </Border>
              </Grid>
              <TextBlock Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom" Foreground="{DynamicResource BaseBackground}" TextTrimming="CharacterEllipsis" Text="{Binding SPINumber}" Visibility="{Binding Mode=OneWay, Path=PortfolioManagerVM.SPINumberVisibility, Converter={StaticResource BooleanToVisibilityConverter}, Source={StaticResource Locator}}" />
            </StackPanel>
            <Border Width="2" Height="Auto" Margin="0,8" HorizontalAlignment="Right" VerticalAlignment="Stretch" BorderBrush="{DynamicResource TextBoxAndFrameBackground}" BorderThickness="0,0,2,0" />
          </Grid>
          <ListBox Name="DesignHistoryListBox" Grid.Row="1" Grid.Column="1" Width="Auto" Height="Auto" Margin="20,0,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" BorderThickness="0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ItemContainerStyle="{DynamicResource DesignHistorySubItemListBoxItemStyle}" ItemTemplate="{DynamicResource DesignHistoryItemDataTemplate}" ItemsPanel="{DynamicResource ItemsPanelTemplateDesignHistory}" ScrollViewer.HorizontalScrollBarVisibility="Visible" Style="{DynamicResource DesignHistoriesListBox}" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}" ItemsSource="{Binding DesignHistories}">
            <i:Interaction.Behaviors>
