                            </i:EventTrigger>
                          </i:Interaction.Triggers>
                          <Control.Foreground>
                            <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                          </Control.Foreground>
                        </Button>
                        <Button Name="buttonCancelDelete" Grid.Row="2" Grid.Column="1" Width="80" Height="40" Margin="5,2" VerticalAlignment="Stretch" Content="{x:Static localization:Strings.No}" FontSize="18.667" Opacity="1" Style="{DynamicResource CSButton}">
                          <Control.Foreground>
                            <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
                          </Control.Foreground>
                          <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewMouseUp">
                              <ic:GoToStateAction StateName="Default" UseTransitions="False" />
                            </i:EventTrigger>
                          </i:Interaction.Triggers>
                        </Button>
                      </Grid>
                    </Border>
                  </Border>
                  <StackPanel Width="Auto" Margin="0,0,0,-35" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Vertical">
                    <TextBox Background="#00FFFFFF" BorderThickness="0" CaretBrush="{DynamicResource HighlightAndAccent}" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FF808080" IsReadOnly="True" MaxLines="1" Text="{Binding SPINumber}" Visibility="{Binding Mode=OneWay, Path=PortfolioManagerVM.SPINumberVisibility, Converter={StaticResource BooleanToVisibilityConverter}, Source={StaticResource Locator}}" />
