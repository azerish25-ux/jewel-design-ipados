<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowOrderHistoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:bll="clr-namespace:GV.CounterSketch.Studio.Controls.BLL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:gvCounterSketchUtilitiesBehaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="TheWindow" Title="Order History" Width="1100" Height="746" AllowsTransparency="True" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" ShowInTaskbar="True" Style="{DynamicResource WindowStyleModalCS4}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" Background="{x:Null}" DataContext="{Binding Path=WindowOrderHistoryVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <SolidColorBrush x:Key="BrushFontForegroundBody" Color="Gray" />
      <DataTemplate x:Key="DataTemplateQuoteHistoryListItem" DataType="bll:CSOrder">
        <DockPanel Margin="2" HorizontalAlignment="Stretch" Background="#FFFFFFFF">
          <Border Width="Auto" Height="Auto" Margin="0" Background="#FF999999" DockPanel.Dock="Top">
            <DockPanel Height="Auto" Margin="0" Background="{DynamicResource ToolHeaderBackground}" LastChildFill="False">
              <TextBlock Name="txtCamRequestId" Width="100" Margin="5,2,0,2" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding CamRequestId}" />
              <TextBlock Name="textDateSubmitted" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Foreground="#FFFFFFFF" TextWrapping="Wrap" Text="{Binding DateSubmitted}" />
              <TextBlock Margin="50,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" FontWeight="Bold" Foreground="#FFDCDCDC" Text="{x:Static l:Strings.Date}" TextWrapping="Wrap" />
            </DockPanel>
          </Border>
          <Grid DockPanel.Dock="Top">
            <Popup VerticalAlignment="Stretch" HorizontalOffset="0" Placement="Relative" StaysOpen="False" VerticalOffset="0" IsOpen="{Binding IsViewingPricingImage, Mode=TwoWay}">
              <Border Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#FFFFFFFF" BorderBrush="#FF1B1A1A" BorderThickness="2">
                <Viewbox Height="380" HorizontalAlignment="Right" VerticalAlignment="Top">
                  <Image HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="UniformToFill" Source="{Binding PricingImagePath}" />
                </Viewbox>
              </Border>
            </Popup>
            <DockPanel Margin="10">
              <Button Style="{DynamicResource ButtonStyleClear}" Command="{Binding WindowOrderHistoryVM.CommandOpenDesign, Source={StaticResource Locator}}" CommandParameter="{Binding QuotedDesignPath}">
                <Image Width="300" Height="260" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Uniform" Source="{Binding DesignImageSource}" />
              </Button>
              <StackPanel Width="Auto" Orientation="Vertical" Background="{x:Null}">
                <DockPanel Name="General" Width="Auto" LastChildFill="True">
                  <StackPanel Width="300" Height="Auto" MinWidth="200" Margin="10,5,5,5" DockPanel.Dock="Left" Orientation="Vertical">
                    <TextBlock VerticalAlignment="Top" FontWeight="Bold" Foreground="{DynamicResource BrushFontForegroundBody}" Text="{x:Static l:Strings.Consultant}" TextDecorations="Underline" TextWrapping="Wrap" />
                    <DockPanel Width="Auto" Height="Auto" Margin="0,5,0,0">
                      <StackPanel Width="Auto" Height="Auto" MinWidth="66">
                        <TextBlock Width="Auto" Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static l:Strings.Name}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static l:Strings.Email}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static l:Strings.Phone}" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static l:Strings.Notes}" TextWrapping="Wrap" />
                      </StackPanel>
                      <StackPanel Width="Auto" Margin="10,0,0,0" DockPanel.Dock="Right">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                          <TextBlock Name="textFirstName" Margin="0" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding FirstName}" />
                          <TextBlock Name="textLastName" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding LastName}" />
                        </StackPanel>
                        <TextBlock Name="textEmail" Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ContactEMail}" />
                        <TextBlock Name="textPhone" Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ContactPhone}" />
                        <ScrollViewer Height="Auto" MaxHeight="225" Margin="0,2" HorizontalAlignment="Stretch" VerticalScrollBarVisibility="Auto">
                          <TextBlock Name="textNotes" Width="Auto" Height="Auto" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding Notes}" />
                        </ScrollViewer>
                      </StackPanel>
                    </DockPanel>
                  </StackPanel>
                  <DockPanel Name="GeneralInfo" Width="Auto" Height="Auto" Margin="0" VerticalAlignment="Top">
                    <StackPanel Margin="0,5,5,0" VerticalAlignment="Bottom" DockPanel.Dock="Left">
                      <TextBlock Margin="0,5,0,2" HorizontalAlignment="Right" VerticalAlignment="Top" FontWeight="Bold" Foreground="#FF000000" Text="Reference #:" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{DynamicResource BrushFontForegroundBody}" Text="Order #:" TextWrapping="Wrap" Visibility="Collapsed" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="Status:" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF000000" Text="Scheduled Ship Date:" TextWrapping="Wrap" />
                      <Button Width="Auto" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:UntranslatedStrings.ReorderDesign}" Command="{Binding WindowOrderHistoryVM.CommandReorder, Source={StaticResource Locator}}" />
                      <Button Width="Auto" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:UntranslatedStrings.ResendMissingDesignToCAM}" Command="{Binding WindowOrderHistoryVM.CommandResubmitDesign, Source={StaticResource Locator}}" CommandParameter="{Binding CamRequestId}" />
                      <Button Width="Auto" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:Strings.OpenDesignFile}" Command="{Binding WindowOrderHistoryVM.CommandOpenDesign, Source={StaticResource Locator}}" CommandParameter="{Binding QuotedDesignPath}" />
                      <Button Width="Auto" Margin="0,10,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="{x:Static l:UntranslatedStrings.ViewPricing}" Command="{Binding WindowOrderHistoryVM.CommandViewPricing, Source={StaticResource Locator}}" CommandParameter="{Binding}" Visibility="{Binding ShowViewPricingImageButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Width="Auto" Margin="5,5,0,0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DockPanel.Dock="Right">
                      <TextBlock Name="textReferenceNumber" Margin="0,5,0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ReferenceNumber}" />
                      <TextBlock Name="textOrderNumber" Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Visibility="Collapsed" Text="{Binding OrderNumber}" />
                      <TextBlock Name="textStatus" Width="Auto" Height="Auto" MaxHeight="75" Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding QuoteStatus}" />
                      <TextBlock Name="textShipDate" Width="Auto" Height="Auto" MaxHeight="75" Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding QuoteShipDate}" />
                    </StackPanel>
                  </DockPanel>
                </DockPanel>
                <Border Name="borderDetails" Height="Auto" Margin="0,10,10,0" HorizontalAlignment="Stretch" BorderThickness="1" CornerRadius="1" Visibility="{Binding IsZalesUser, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <DockPanel Height="Auto" Margin="5,0">
                    <TextBlock Margin="0,5" VerticalAlignment="Top" DockPanel.Dock="Top" FontWeight="Bold" Foreground="{DynamicResource BrushFontForegroundBody}" Text="{x:Static l:Strings.Customer}" TextDecorations="Underline" TextWrapping="Wrap" />
                    <StackPanel Name="Details" Width="Auto" MinWidth="66" Margin="0,0,5,0" Background="{x:Null}">
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.FirstName}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.LastName}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.Address1}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.Address2}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.City}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.State}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Right" FontWeight="Bold" Foreground="#FF131313" Text="{x:Static l:Strings.PostalCode}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Name="DetailsData" Width="Auto" Height="Auto" Margin="10,0,0,0" Background="{x:Null}">
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerFirstName}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerLastName}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerAddress1}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerAddress2}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerCity}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerState}" />
                      <TextBlock Margin="0,2" HorizontalAlignment="Left" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CustomerZip}" />
                    </StackPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </DockPanel>
          </Grid>
        </DockPanel>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleContainer" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <i:Interaction.Behaviors>
    <gvCounterSketchUtilitiesBehaviors:WindowBehaviorRequestFocusWhenMouseEnters />
  </i:Interaction.Behaviors>
  <DockPanel Margin="10">
    <Button Name="BtnCancel" Width="75" HorizontalAlignment="Right" BorderThickness="1,5,1,1" Content="Close" DockPanel.Dock="Bottom" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandCloseWindow}" />
    <Border Margin="0,0,0,5" BorderThickness="1" DockPanel.Dock="Top">
      <Grid>
        <ListBox Name="ListboxQuotehistory" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#FFFFFFFF" BorderBrush="#FF737373" ItemContainerStyle="{DynamicResource ListBoxItemStyleContainer}" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ListBoxEmptyStyle}" ItemsSource="{Binding OrderHistoryCollection}" SelectedItem="{Binding SelectedOrder}" ItemTemplate="{StaticResource ResourceKey=DataTemplateQuoteHistoryListItem}" />
      </Grid>
    </Border>
  </DockPanel>
</Window>