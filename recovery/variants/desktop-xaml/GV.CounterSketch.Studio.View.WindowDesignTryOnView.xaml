      </Grid>
      <DockPanel VerticalAlignment="Top" Dock="Top" LastChildFill="False">
        <DockPanel HorizontalAlignment="Center" Dock="Top">
          <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static l:Strings.Gender}" TextWrapping="Wrap" />
          <ComboBox Height="20" Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource CSComboBoxStyleBasic}" ItemsSource="{Binding HandGenderOptions}" SelectedItem="{Binding SelectedHandGender, Mode=TwoWay}">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="SelectionChanged">
                <command:EventToCommand Command="{Binding CommandUpdateHandGender, Mode=OneWay}" />
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </ComboBox>
        </DockPanel>
      </DockPanel>
      <DockPanel Margin="15,0" VerticalAlignment="Top" Dock="Top">
        <TextBlock VerticalAlignment="Center" FontWeight="Bold" Text="{x:Static l:Strings.Finger}" />
        <Slider Name="Slider" Margin="3,0" VerticalAlignment="Center" Cursor="Hand" IsSnapToTickEnabled="True" LargeChange=".5" Maximum="5" Minimum="-5" SmallChange=".1" Style="{DynamicResource SliderStyle1}" Value="{Binding RingPositionOffset, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="ValueChanged">
              <command:EventToCommand Command="{Binding CommandUpdateHandObjects, Mode=OneWay}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </Slider>
      </DockPanel>
      <DockPanel Height="30" Margin="10,0,10,5" Dock="Bottom" LastChildFill="False">
        <CheckBox VerticalAlignment="Center" Content="{x:Static l:Strings.FlipDesign}" Cursor="Hand" FontWeight="Bold" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding IsRingFlipped, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger>
              <command:EventToCommand Command="{Binding CommandUpdateHandObjects, Mode=OneWay}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Control.Foreground>
            <SolidColorBrush Color="{DynamicResource TextPrimaryColor}" />
          </Control.Foreground>
        </CheckBox>
        <Button Width="75" Margin="8,0,0,0" VerticalAlignment="Center" Content="{x:Static l:Strings.OK}" DockPanel.Dock="Right" FontWeight="Bold" Template="{DynamicResource CS4ButtonRoundedHighlight}" Command="{Binding CommandCloseWindow, Mode=OneWay}" />
        <Button Width="75" VerticalAlignment="Center" Content="{x:Static l:Strings.Remove}" DockPanel.Dock="Right" FontWeight="Bold" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandRemoveHand, Mode=OneWay}" Click="ButtonBase_OnClick" />
      </DockPanel>
      <DockPanel Margin="15,10,15,0" VerticalAlignment="Top" Dock="Top" LastChildFill="False">
        <Separator DockPanel.Dock="Top">
          <Control.Background>
            <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
          </Control.Background>
        </Separator>
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Text="{x:Static l:Strings.SkinTone}" TextWrapping="Wrap" />
        <pagedListBox:PagedListBox DockPanel.Dock="Top" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxHand}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemHand}" Template="{DynamicResource PagedListBoxRenderStyle}" ItemsSource="{Binding SkinToneOptions}" SelectedItem="{Binding SelectedSkinToneOption, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
              <command:EventToCommand Command="{Binding CommandUpdateRhinoViewportObjects, Mode=OneWay}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </pagedListBox:PagedListBox>
      </DockPanel>
      <DockPanel Margin="15,0" VerticalAlignment="Top" Dock="Top" LastChildFill="False">
        <Separator DockPanel.Dock="Top">
          <Control.Background>
            <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
          </Control.Background>
        </Separator>
        <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Text="{x:Static l:Strings.NailColor}" TextWrapping="Wrap" />
        <pagedListBox:PagedListBox DockPanel.Dock="Top" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxHand}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" Template="{DynamicResource PagedListBoxRenderStyle}" ItemsSource="{Binding NailOptions}" SelectedItem="{Binding SelectedNailOption, Mode=TwoWay}">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="SelectionChanged">
              <command:EventToCommand Command="{Binding CommandUpdateRhinoViewportObjects, Mode=OneWay}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
        </pagedListBox:PagedListBox>
      </DockPanel>
    </DockPanel>
  </Grid>
</Window>