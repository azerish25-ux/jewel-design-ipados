          <Button Width="50" Height="50" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" HorizontalContentAlignment="Center" Background="#a3a3a3" DockPanel.Dock="Left" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.PreviousDesign}" Command="{Binding CommandPreviousSessionDesign}" CommandParameter="{Binding ElementName=SessionPicksScrollViewer}">
            <ImageAwesome FrameworkElement.Width="15" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p24:ImageAwesome.Foreground="#FFFFFFFF" p24:ImageAwesome.Icon="ArrowLeft" xmlns:p24="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
          </Button>
          <Button Width="50" Height="50" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" HorizontalContentAlignment="Center" Background="#a3a3a3" DockPanel.Dock="Right" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.NextDesign}" Command="{Binding CommandNextSessionDesign}" CommandParameter="{Binding ElementName=SessionPicksScrollViewer}">
            <ImageAwesome FrameworkElement.Width="15" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p24:ImageAwesome.Foreground="#FFFFFFFF" p24:ImageAwesome.Icon="ArrowRight" xmlns:p24="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
          </Button>
          <ScrollViewer Name="SessionPicksScrollViewer" Margin="20,0" VerticalAlignment="Center" CanContentScroll="True" DockPanel.Dock="Top" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
            <ListBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FFFFFFFF" Focusable="False" IsHitTestVisible="True" ItemContainerStyle="{DynamicResource ListBoxItemStyleSearchResults}" ItemTemplate="{DynamicResource DataTemplateSessionPicks}" ItemsPanel="{DynamicResource ItemsPanelTemplateSingle}" SelectionMode="Single" BorderBrush="{x:Null}" ItemsSource="{Binding SessionPickDesigns, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedDesignSearch, Mode=OneWay}">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="SelectionChanged">
                  <command:EventToCommand Command="{Binding CommandSelectedDesignSearchChanged, Mode=OneWay}" />
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <Control.Template>
                <ControlTemplate>
                  <StackPanel Margin="2" IsItemsHost="True" Orientation="Horizontal" />
                </ControlTemplate>
              </Control.Template>
            </ListBox>
          </ScrollViewer>
        </DockPanel>
        <Grid Margin="0,-26,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseLeftButtonUp">
              <command:EventToCommand Command="{Binding CommandToggleSessionPicks, Mode=OneWay}" />
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Border Padding="40,10" HorizontalAlignment="Center" Background="#FFDDDDDD" CornerRadius="5,5,0,0" Cursor="Hand">
            <StackPanel Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFdddddd" FlowDirection="LeftToRight" Orientation="Horizontal">
              <Border Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFA3A3A3" BorderBrush="#FFFFFFFF" CornerRadius="10" />
              <Border Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFA3A3A3" BorderBrush="#FFFFFFFF" CornerRadius="10" />
              <Border Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFA3A3A3" BorderBrush="#FFFFFFFF" CornerRadius="10" />
              <Border Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFA3A3A3" BorderBrush="#FFFFFFFF" CornerRadius="10" />
              <Border Width="7" Height="7" Margin="0,0,2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#FFA3A3A3" BorderBrush="#FFFFFFFF" CornerRadius="10" />
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>