<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowNewLibrary" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="Library Updated" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner" DataContext="{Binding Source={StaticResource Locator}, Path=UpdateInfoVM}" Closing="WindowNewLibrary_OnClosing">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid Width="400" Height="400" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Border BorderThickness="1">
        <Image Source="{Binding ImageTopLeft}" />
      </Border>
      <Border Grid.Column="1" BorderThickness="1">
        <Image Source="{Binding ImageTopRight}" />
      </Border>
      <Border Grid.Row="1" BorderThickness="1">
        <Image Source="{Binding ImageBottomLeft}" />
      </Border>
      <Border Grid.Row="1" Grid.Column="1" BorderThickness="1">
        <Image Source="{Binding ImageBottomRight}" />
      </Border>
    </Grid>
    <Grid Column="1" Height="400" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <StackPanel Grid.RowSpan="2" VerticalAlignment="Center" Orientation="Vertical">
        <TextBlock Grid.ColumnSpan="2" Margin="10,0,0,0" HorizontalAlignment="Center" FontSize="16" Text="{x:Static l:Strings.YourLibraryHasBeenUpdated}" />
        <TextBlock Margin="0,5,10,0" HorizontalAlignment="Center" FontSize="16" Text="{Binding LibraryUpdateName, StringFormat=v {0}}" />
        <TextBlock MaxWidth="300" Margin="10,35,10,10" HorizontalAlignment="Center" FontSize="16" Text="Choose below and click the New Designs or New Parts Tile to see what is new." TextWrapping="Wrap" />
        <Button MinWidth="140" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Browse Designs" Command="{Binding CommandShowNewDesigns, Mode=OneWay}" Visibility="{Binding HasNewDesigns, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <Button MinWidth="140" Margin="0,10,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="Browse Parts" Command="{Binding CommandShowNewParts, Mode=OneWay}" Visibility="{Binding HasNewParts, Converter={StaticResource BooleanToVisibilityConverter}}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>