<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.Controls.WindowModalAccount" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:D="http://schemas.microsoft.com/expression/blend/2008" xmlns:Mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:l="clr-namespace:Localization;assembly=Localization" x:Name="_theWindow" Title="Account Info" Width="900" MinHeight="100" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AllowsTransparency="True" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="{DynamicResource BaseBackground}" ResizeMode="NoResize" ShowInTaskbar="False" SizeToContent="Height" SnapsToDevicePixels="True" Style="{DynamicResource WindowStyleModalCS4}" WindowStartupLocation="Manual" WindowStyle="None" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" Loaded="WindowLoaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="TextBoxStyleMarkup" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="UIElement.AllowDrop" Value="True" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalFirst" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type TextBox}">
              <Border Name="border" Margin="1" Background="{TemplateBinding Control.Background}" BorderBrush="#FFA1A1A1" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <Grid>
                  <ScrollViewer Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                  <TextBlock Name="TextPrompt" Margin="3,0" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Focusable="False" IsHitTestVisible="False" Text="{TemplateBinding FrameworkElement.Tag}" Visibility="Collapsed" Background="{x:Null}">
                    <TextBlock.Foreground>
                      <SolidColorBrush Color="{DynamicResource TextSecondaryColor}" />
                    </TextBlock.Foreground>
                  </TextBlock>
                </Grid>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled" />
                    <VisualState x:Name="ReadOnly">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush)">
                          <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Null}" />
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="MouseOver" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Border>
              <ControlTemplate.Triggers>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsFocused" Value="False" />
                    <Condition Property="Text" Value="" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="TextPrompt" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Collapsed" />
                </MultiTrigger>
                <MultiTrigger>
                  <MultiTrigger.Conditions>
                    <Condition Property="UIElement.IsFocused" Value="False" />
                    <Condition Property="Text" Value="" />
                  </MultiTrigger.Conditions>
                  <Setter TargetName="TextPrompt" Property="Visibility" Value="Visible" />
                  <Setter TargetName="PART_ContentHost" Property="Visibility" Value="Collapsed" />
                </MultiTrigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
        <Style.Triggers>
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="TextBoxBase.IsInactiveSelectionHighlightEnabled" Value="True" />
              <Condition Property="TextBoxBase.IsSelectionActive" Value="False" />
            </MultiTrigger.Conditions>
            <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
          </MultiTrigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="{x:Type Hyperlink}" TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="#FF0000FF" />
        <Setter Property="Inline.TextDecorations" Value="Underline" />
        <Style.Triggers>
          <Trigger Property="ContentElement.IsMouseOver" Value="True">
            <Setter Property="Foreground" Value="#FFFF0000" />
          </Trigger>
          <Trigger Property="ContentElement.IsEnabled" Value="False">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
          </Trigger>
          <Trigger Property="ContentElement.IsEnabled" Value="True">
            <Setter Property="FrameworkContentElement.Cursor" Value="Hand" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Name="stackPanel" Margin="0">
    <StackPanel Name="panelOptions" Margin="0" Orientation="Vertical">
      <Grid Margin="10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="400" />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical">
          <StackPanel Name="AccountSettings" Orientation="Vertical">
            <TextBlock FontSize="13.333" Text="Account Info" TextWrapping="Wrap" />
            <Border Height="150" MinHeight="110" Margin="0,0,0,16" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <Grid Name="BillToShipTo" Margin="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="0.472*" />
                  <ColumnDefinition Width="0.528*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" MinHeight="161.12" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Column="1" Margin="3.092,3,33,0" VerticalAlignment="Top" Orientation="Vertical">
                  <TextBlock FontSize="13.333" Opacity="0.75" Text="Ship To Account:" TextWrapping="Wrap" />
                  <ComboBox Name="cbxShipToAccountNumber" Margin="0,3" VerticalAlignment="Center" FontSize="13.333" Style="{DynamicResource CSComboBoxStyleBasic}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="3,3,2.908,0" VerticalAlignment="Top" Orientation="Vertical">
                  <TextBlock FontSize="13.333" Opacity="0.75" Text="Bill To Account:" TextWrapping="Wrap" />
                  <TextBlock Name="txtBillToAccountNumber" Margin="0,3" VerticalAlignment="Center" FontSize="13.333" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Name="txtBillToInfo" Grid.Row="1" Grid.Column="0" Margin="3,3,2.908,0" VerticalAlignment="Top" FontSize="13.333" TextWrapping="Wrap" />
                <TextBlock Name="txtShipToInfo" Grid.Row="1" Grid.Column="1" Margin="3.092,3,33,0" VerticalAlignment="Top" FontSize="13.333" TextWrapping="Wrap" />
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Name="QuoteContactSettings" Margin="5,0,0,5" Orientation="Vertical">
            <TextBlock FontSize="13.333" Text="Account Manager" TextWrapping="Wrap" />
            <Border Margin="0,0,0,5" VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Name="EmailQuoteSettings" Margin="10">
                <DockPanel Margin="0,0,0,5">
                  <TextBlock VerticalAlignment="Center" FontSize="13.333" Text="Email for Quote:" TextWrapping="Wrap" />
                  <TextBox Name="txtEmailQuote" Margin="10,0" CaretBrush="{DynamicResource HighlightAndAccent}" FontSize="13.333" Style="{DynamicResource CS4TextBoxStyle}" Tag="email@domain.com" TextWrapping="Wrap" />
                </DockPanel>
                <DockPanel Margin="0,5,0,5">
                  <TextBlock VerticalAlignment="Center" FontSize="13.333" Text="Phone / SMS:" TextWrapping="Wrap" />
                  <TextBox Name="txtPhone" Margin="10,0" VerticalAlignment="Center" CaretBrush="{DynamicResource HighlightAndAccent}" FontSize="13.333" Style="{DynamicResource CS4TextBoxStyle}" Tag="xxx-xxx-xxxx" />
                </DockPanel>
                <DockPanel Margin="0,5,0,5">
                  <TextBlock Text="Send SMS Notifications:" TextWrapping="Wrap" />
                  <CheckBox Name="chkSendSMSNotifications" Margin="10,0,0,0" />
                </DockPanel>
                <TextBlock FontStyle="Italic" TextWrapping="Wrap">
                  <Run Text="Update your CAD/CAM Profile to ensure that you receive SMS messages:" /> <Hyperlink NavigateUri="https://www.stuller.com/countersketchstudio/cadcamprofile" RequestNavigate="Hyperlink_RequestNavigate">Edit CAD/CAM Profile</Hyperlink></TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="20,0,0,0">
          <TextBlock DockPanel.Dock="Left" FontSize="13.333" Text="Markups" TextWrapping="Wrap" />
          <Border Margin="0,0,0,16" BorderBrush="#FF4A4D4A" BorderThickness="1">
            <StackPanel Orientation="Vertical">
              <DockPanel Margin="10" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" LineHeight="18" TextWrapping="Wrap">CounterSketch uses your account's Stuller Showcase Markups to calculate the prices showin in CounterSketch, including Quick Estimate and Order screen prices.</TextBlock>
              </DockPanel>
              <StackPanel Margin="10,0,10,10" DockPanel.Dock="Bottom" Orientation="Horizontal">
                <TextBlock>
                  <Hyperlink NavigateUri="https://www.stuller.com/showcasemarkups/" RequestNavigate="Hyperlink_RequestNavigate">Set Stuller Showcase Markups</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0" FontWeight="Bold" Foreground="#cc8850" Text="Incomplete" Visibility="{Binding HasStullerShowcaseMarkupsAvailable, ConverterParameter=True, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=_theWindow}" />
                <TextBlock Margin="10,0" FontWeight="Bold" Foreground="#6caa48" Text="Complete" Visibility="{Binding HasStullerShowcaseMarkupsAvailable, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=_theWindow}" />
              </StackPanel>
              <TextBlock Margin="10" FontStyle="Italic" TextWrapping="Wrap">
                <Run Text="If Stuller Showcase Markups are not completed, or &quot;Hide Prices&quot; is selected, CounterSketch prices will NOT reflect your custom retail prices." />
              </TextBlock>
            </StackPanel>
          </Border>
          <StackPanel>
            <TextBlock FontSize="13.333" Text="Currency Region" TextWrapping="Wrap" />
            <Border Margin="0,0,0,16" BorderBrush="#FF4A4D4A" BorderThickness="1">
              <Grid Margin="10">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="1*" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock HorizontalAlignment="Left" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Text="Exchange Rate:" />
                <TextBlock Grid.Column="1" Margin="5,0" HorizontalAlignment="Center" FontSize="13.333" Opacity="0.75" Text="US Dollars" TextWrapping="Wrap" />
                <TextBlock Name="txtDollars" Grid.Column="2" Margin="5,0" HorizontalAlignment="Center" FontSize="13.333" Opacity="0.75" Text="$1.00" TextWrapping="Wrap" />
                <TextBlock Grid.Column="3" Margin="5,0" HorizontalAlignment="Center" FontSize="13.333" Opacity="0.75" Text="=" TextWrapping="Wrap" />
                <TextBlock Name="txtExchangedDollars" Grid.Column="4" Margin="5,0" HorizontalAlignment="Center" FontSize="13.333" Opacity="0.75" Text=".62" TextWrapping="Wrap" />
                <TextBlock Name="txtCurrencyEnum" Grid.Column="5" Margin="5,0,0,0" Padding="0,0,5,0" HorizontalAlignment="Center" Cursor="Hand" FontSize="13.333" Opacity="0.75" Text="United Kingdom Pounds " TextDecorations="Underline" TextWrapping="Wrap" ToolTip="{x:Static l:Strings.TooltipChangeCurrency}" MouseLeftButtonDown="TxtCurrencyEnumMouseLeftButtonDown" />
              </Grid>
            </Border>
          </StackPanel>
          <StackPanel Name="ApplicationPermissions" Orientation="Vertical">
            <TextBlock FontSize="13.333" Text="Application Permissions" TextWrapping="Wrap" />
            <Border VerticalAlignment="Bottom" BorderBrush="#FF595959" BorderThickness="1">
              <StackPanel Margin="6" Orientation="Vertical">
                <DockPanel Margin="0,0,0,5">
                  <TextBlock VerticalAlignment="Center" FontSize="13.333" Text="Require a password to access Preferences:" TextWrapping="Wrap" />
                  <CheckBox Name="chkRequirePreferencesPassword" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </Grid>
      <DockPanel Name="ActionButtons" Margin="10,0,10,10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
        <Grid Height="25">
          <Button Name="btnCancel" Width="100" Margin="0,0,112,0" HorizontalAlignment="Right" Content="Cancel" Style="{DynamicResource CSButton}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnCancelClick" />
          <Button Name="btnClose" Width="100" HorizontalAlignment="Right" Content="Close" Style="{DynamicResource CSButton}" Template="{DynamicResource CS4ButtonRounded}" Click="BtnCloseClick" />
          <TextBlock Name="txtInfoMessage" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="13.333" Opacity="0" Text="Please Enter Markup Values and Contact Info." TextWrapping="Wrap" Visibility="Hidden" />
        </Grid>
      </DockPanel>
    </StackPanel>
  </StackPanel>
</Window>