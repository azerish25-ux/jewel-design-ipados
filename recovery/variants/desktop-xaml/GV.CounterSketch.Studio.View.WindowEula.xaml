<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowEula" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="{x:Static l:Strings.LicenseAgreement}" Width="800" Height="600" Background="#FFE6E6E6" Icon="/CounterSketch Studio;component/Images/Activation.ico" Topmost="True" WindowStartupLocation="CenterScreen" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View">
  <Grid>
    <Border Margin="20,50,20,65" BorderBrush="#FF2B2B2B" BorderThickness="1">
      <RichTextBox Name="richTextBox" BorderThickness="0" HorizontalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True" VerticalScrollBarVisibility="Auto">
        <FlowDocument>
          <Paragraph>
            <Run Text="RichTextBox" />
          </Paragraph>
        </FlowDocument>
      </RichTextBox>
    </Border>
    <StackPanel Margin="20,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Orientation="Vertical">
      <RadioButton Name="radAgree" Content="{x:Static l:Strings.IAcceptTheAgreement}" GroupName="eula" />
      <RadioButton Name="radNoAgree" Margin="0,5,0,0" Content="{x:Static l:Strings.IDoNotAcceptTheAgreement}" GroupName="eula" />
    </StackPanel>
    <Button Name="ButtonClose" Width="75" Margin="10,10,20,16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{x:Static l:Strings.Continue}" Click="ButtonClick" />
    <TextBlock Name="textBlock" Margin="20,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Text="{x:Static l:Strings.EulaExplanation}" TextWrapping="Wrap" />
  </Grid>
</Window>