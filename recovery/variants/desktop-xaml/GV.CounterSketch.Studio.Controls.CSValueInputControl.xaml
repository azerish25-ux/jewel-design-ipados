<?xml version="1.0" encoding="utf-8"?>
<controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueInputControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="TheValueInputControl">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CounterSketch Studio;component/ResourceDictionaries/Converters.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,4">
    <DockPanel>
      <Border Height="1" VerticalAlignment="Top" Background="#FFC6BEB6" DockPanel.Dock="Top" />
      <Grid Name="GridDisplayImage">
        <Rectangle Name="RectImage" Width="50" Height="70" Stretch="Fill" StrokeLineJoin="Round" StrokeThickness="0" />
      </Grid>
      <Border Name="BorderSubMenu" Margin="0" Background="#02000000" DockPanel.Dock="Right" />
      <Grid Margin="0" DockPanel.Dock="Top">
        <DockPanel Margin="0" VerticalAlignment="Top">
          <TextBlock Name="TxtTitle" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF32302E" Text="{Binding Path=DisplayTitle, ElementName=TheValueInputControl, FallbackValue=Title}" />
        </DockPanel>
        <TextBox Name="TxtValue" MinWidth="50" Margin="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Center" Background="#FFFFFFFF" BorderBrush="#A1A1A1" BorderThickness="1" Foreground="#FF32302E" MaxLines="1" Text="{Binding ElementName=TheValueInputControl, Path=ValueGeneric, FallbackValue=Value}" KeyUp="TxtValue_OnKeyUp" LostFocus="TxtValue_OnLostFocus" />
      </Grid>
    </DockPanel>
  </Grid>
</controls:CSUIControl>