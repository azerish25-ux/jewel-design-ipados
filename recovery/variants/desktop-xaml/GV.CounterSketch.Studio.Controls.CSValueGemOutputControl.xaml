<?xml version="1.0" encoding="utf-8"?>
<controls:CSUIControl x:Class="GV.CounterSketch.Studio.Controls.CSValueGemOutputControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pricing="clr-namespace:GV.CounterSketch.Shared.Pricing;assembly=CounterSketch Studio" x:Name="TheValueGemOutputControl" FontSize="9">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DataTemplate x:Key="DataTemplateGemItem" DataType="pricing:StudioGem">
        <Grid Margin="2,2,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{DynamicResource TextBoxAndFrameBackground}" BorderBrush="{DynamicResource WindowFrameBackground}" MinWidth="50" BorderThickness="1" CornerRadius="0.5" Margin="0,0,4,0">
            <DockPanel>
              <Grid Width="Auto" Background="{DynamicResource WindowFrameBackground}">
                <TextBlock Grid.Column="0" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="QTY" FontSize="10" />
              </Grid>
              <TextBlock Name="txtCount" Width="Auto" MinWidth="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" TextAlignment="Center" Text="{Binding Quantity, FallbackValue=3}" />
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Background="{DynamicResource TextBoxAndFrameBackground}" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1" CornerRadius="0.5" VerticalAlignment="Stretch">
            <DockPanel>
              <Grid Width="Auto" Background="{DynamicResource WindowFrameBackground}">
                <TextBlock Grid.Column="0" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="H" FontSize="10" />
              </Grid>
              <TextBlock Name="txtHeight" Width="Auto" MinWidth="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" TextAlignment="Center" Text="{Binding Height, StringFormat={}{0:#.00#}, FallbackValue=11.11}" />
            </DockPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource TextBoxAndFrameBackground}" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1" CornerRadius="0.5" VerticalAlignment="Stretch" Margin="2,0">
            <DockPanel>
              <Grid Width="Auto" Background="{DynamicResource WindowFrameBackground}">
                <TextBlock Grid.Column="0" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="W" FontSize="10" />
              </Grid>
              <TextBlock Name="txtWidth" Width="Auto" MinWidth="20" VerticalAlignment="Center" Foreground="#FFFFFFFF" HorizontalAlignment="Center" FontSize="10" TextAlignment="Center" Text="{Binding Width, StringFormat={}{0:#.00#}, FallbackValue=11.11}" />
            </DockPanel>
          </Border>
          <Border Grid.Column="3" Background="{DynamicResource TextBoxAndFrameBackground}" BorderBrush="{DynamicResource WindowFrameBackground}" BorderThickness="1" CornerRadius="0.5" VerticalAlignment="Stretch">
            <DockPanel>
              <Grid Width="Auto" Background="{DynamicResource WindowFrameBackground}">
                <TextBlock Grid.Column="0" Margin="2,0" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" Text="D" FontSize="10" />
              </Grid>
              <TextBlock Name="txtDepth" Width="Auto" MinWidth="20" VerticalAlignment="Center" Foreground="#FFFFFFFF" HorizontalAlignment="Center" FontSize="10" TextAlignment="Center" Text="{Binding Length, StringFormat={}{0:#.00#}, FallbackValue=11.11}" />
            </DockPanel>
          </Border>
          <Border Grid.Column="6" Background="{DynamicResource TextBoxAndFrameBackground}" BorderBrush="{DynamicResource WindowFrameBackground}" MinWidth="50" BorderThickness="1" CornerRadius="0.5" Margin="4,0,0,0">
            <DockPanel>
              <TextBlock HorizontalAlignment="Stretch" TextWrapping="NoWrap" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="10" Style="{DynamicResource TextBlockStyleAutomaticTooltip}" Margin="1,0,0,0" Text="{Binding GemShapeOption, FallbackValue=Unknown Gem Shape}" />
            </DockPanel>
          </Border>
        </Grid>
      </DataTemplate>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplateGemOutputs">
        <VirtualizingStackPanel IsItemsHost="True" ScrollViewer.VerticalScrollBarVisibility="Disabled" />
      </ItemsPanelTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0,4">
    <DockPanel Background="#02000000">
      <Grid Name="GridDisplayImage" Margin="0,0,5,0">
        <Rectangle Name="RectImage" Width="27" Height="35" VerticalAlignment="Top" Stretch="Fill" Stroke="#FFFFFFFF" StrokeLineJoin="Round" StrokeThickness="0.5" />
      </Grid>
      <Border Name="BorderSubMenu" Margin="0" Background="#02000000" DockPanel.Dock="Right" />
      <Grid Margin="0,0,5,0" DockPanel.Dock="Top">
        <Grid.RowDefinitions>
          <RowDefinition Height="auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Height="1" VerticalAlignment="Top" Background="#FFC6BEB6" />
        <DockPanel Grid.Row="0" Margin="0" VerticalAlignment="Top">
          <TextBlock Name="TxtTitle" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#FF32302E" Text="{Binding Path=DisplayTitle, ElementName=TheValueGemOutputControl}" />
        </DockPanel>
        <ItemsControl Name="LstGemItems" Grid.Row="1" MinHeight="21" Margin="2,4,2,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" VerticalContentAlignment="Stretch" Foreground="#FFFFFFFF" ItemTemplate="{DynamicResource DataTemplateGemItem}" ItemsPanel="{DynamicResource ItemsPanelTemplateGemOutputs}" ScrollViewer.CanContentScroll="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="{x:Null}" />
      </Grid>
    </DockPanel>
  </Grid>
</controls:CSUIControl>