<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.Controls.WindowBrowser" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:GV_CounterSketch_Utilities_Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:localization="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:wpf="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf" x:Name="theWindow" Width="1200" Height="800" AllowsTransparency="False" Background="#FFFFFFFF" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Foreground="#FFFFFFFF" WindowStartupLocation="CenterScreen" Title="{Binding Title}" Loaded="TheWindowLoaded">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="CS4BrowserCloseButton" TargetType="{x:Type ButtonBase}">
        <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1,0,1,1" CornerRadius="3,3,0,0" SnapsToDevicePixels="True">
          <ContentPresenter Name="contentPresenter" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Focusable="False" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="Button.IsDefaulted" Value="True">
            <Setter TargetName="border" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Property="Border.BorderBrush" />
          </Trigger>
          <Trigger Property="UIElement.IsMouseOver" Value="True" />
          <Trigger Property="ButtonBase.IsPressed" Value="True">
            <Setter TargetName="border" Property="Border.BorderBrush">
              <Setter.Value>
                <SolidColorBrush Color="{DynamicResource HighlightAndAccentColor}" />
              </Setter.Value>
            </Setter>
          </Trigger>
          <Trigger Property="UIElement.IsEnabled" Value="False">
            <Setter TargetName="border" Property="Border.Background" Value="#FFF4F4F4" />
            <Setter TargetName="border" Property="Border.BorderBrush" Value="#FFADB2B5" />
            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="#FF838383" />
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <i:Interaction.Behaviors>
    <GV_CounterSketch_Utilities_Behaviors:WindowBehaviorRequestFocusWhenMouseEnters />
  </i:Interaction.Behaviors>
  <DockPanel>
    <StackPanel Name="ShopperButtonsPanel" Margin="10" HorizontalAlignment="Right" DockPanel.Dock="Bottom" Orientation="Horizontal" Visibility="Collapsed">
      <FrameworkElement.Resources>
        <ResourceDictionary>
          <ControlTemplate x:Key="StoneShopperButton" TargetType="{x:Type ButtonBase}">
            <Border Name="border" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
              <ContentPresenter Name="contentPresenter" Margin="{TemplateBinding Control.Padding}" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" Content="{TemplateBinding ContentControl.Content}" ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}" ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}" Focusable="False" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
            </Border>
          </ControlTemplate>
        </ResourceDictionary>
      </FrameworkElement.Resources>
      <Controls:StoneTray Height="30" Foreground="#FF454341" ShowStoneText="True" ShowStoneTrayGraphic="True" />
      <Button Name="ButtonSearchMountings" Height="30" Margin="10,0,0,0" Padding="10,0" VerticalAlignment="Bottom" Background="{DynamicResource HighlightAndAccent}" BorderThickness="0" Content="{x:Static localization:Strings.SearchMountings}" Cursor="Hand" DockPanel.Dock="Right" FontSize="13.333" Foreground="#FFFFFFFF" Template="{DynamicResource StoneShopperButton}" Click="ButtonSearchMountings_Click" />
    </StackPanel>
    <wpf:ChromiumWebBrowser Name="Browser" DockPanel.Dock="Top" FrameLoadEnd="Browser_FrameLoadEnd">
      <i:Interaction.Behaviors>
        <GV_CounterSketch_Utilities_Behaviors:HoverLinkBehaviour x:Name="HoverLinkBehaviour" />
      </i:Interaction.Behaviors>
    </wpf:ChromiumWebBrowser>
  </DockPanel>
</Window>