              <TextBlock FontSize="12" FontWeight="Light" Foreground="#FF808080" Text="{x:Static l:UntranslatedStrings.DesignRangesExpandedWarning1}" TextWrapping="Wrap" />
              <TextBlock FontSize="12" FontWeight="Light" Foreground="#FF808080" Text="{x:Static l:UntranslatedStrings.DesignRangesExpandedWarning2}" TextWrapping="Wrap" />
              <ListBox Margin="0,6,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{DynamicResource ListBoxItemStyleWithoutSelection}" ItemTemplate="{DynamicResource DataTemplateExpandedControl}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding ExpandedControls}" />
            </StackPanel>
          </Grid>
          <ListBox Name="FreehandStackListBox" Margin="0,5,0,0" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0" DockPanel.Dock="Top" ItemContainerStyle="{DynamicResource ListBoxItemStyleWithoutSelection}" ItemTemplate="{DynamicResource CategoryControlsDataTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Style="{DynamicResource ListBoxStylePrimary}" Background="{x:Null}" ItemsSource="{Binding FreehandStackItemContainers, Mode=Default}" MouseEnter="freehandStackListBox_MouseEnter" MouseLeave="freehandStackListBox_MouseLeave" />
        </DockPanel>
      </Grid>
    </Grid>
    <Grid DataContext="{Binding Mode=Default, Path=MainVM, Source={StaticResource Locator}}">
      <Border Background="#FFFFFFFF" BorderBrush="#FF000000" Opacity="0.9" Visibility="{Binding IsRhinoBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
        <telerik:RadBusyIndicator HorizontalAlignment="Center" VerticalAlignment="Center" BusyContent="{x:Static l:Strings.Working}" IsBusy="True" Style="{DynamicResource RadBusyIndicatorStyleGlobal}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>