<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.UpdateInfoView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" xmlns:Converters="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns:ViewModel="clr-namespace:GV.CounterSketch.Studio.ViewModel" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" HorizontalAlignment="Center" VerticalAlignment="Center" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Path=UpdateInfoVM, Source={StaticResource Locator}}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="RadBusyIndicatorStyle1" TargetType="{x:Type telerik:RadBusyIndicator}">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="telerik:RadBusyIndicator.DisplayAfter" Value="0:0:0.1" />
        <Setter Property="Background">
          <Setter.Value>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Offset="0" Color="White" />
              <GradientStop Offset="1" Color="#A9DCDADA" />
            </LinearGradientBrush>
          </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#FFD0D0D0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="telerik:RadBusyIndicator.ProgressBarStyle">
          <Setter.Value>
            <Style TargetType="{x:Type telerik:RadProgressBar}">
              <Setter Property="Margin" Value="15,15,15,5" />
              <Setter Property="RangeBase.Maximum" Value="100" />
              <Setter Property="telerik:RadProgressBar.Orientation" Value="Horizontal" />
              <Setter Property="IsTabStop" Value="False" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="{x:Type telerik:RadProgressBar}">
                    <Grid>
                      <Path Name="IndeterminateBackgroundDonut" Width="44" Height="44" Fill="{TemplateBinding Control.Foreground}" RenderTransformOrigin="0.5,0.5" Stroke="{TemplateBinding Control.Foreground}">
                        <Path.Data>
                          <GeometryGroup FillRule="EvenOdd">
                            <EllipseGeometry Center="22,22" RadiusX="20" RadiusY="20" />
                            <EllipseGeometry Center="22,22" RadiusX="14" RadiusY="14" />
                          </GeometryGroup>
                        </Path.Data>
                      </Path>
                      <Path Name="IndeterminateDonut" Width="44" Height="44" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                        <Path.Data>
                          <GeometryGroup FillRule="EvenOdd">
                            <EllipseGeometry Center="22,22" RadiusX="20" RadiusY="20" />
                            <EllipseGeometry Center="22,22" RadiusX="14" RadiusY="14" />
                          </GeometryGroup>
                        </Path.Data>
                        <Shape.Fill>
                          <RadialGradientBrush Center="0.5,-0.23" GradientOrigin="0.8,0.25" RadiusX="0.68" RadiusY="0.68">
                            <GradientStop Offset="0" Color="#BFFFFFFF" />
                            <GradientStop Offset="0.65" Color="#FF3d6db5" />
                          </RadialGradientBrush>
                        </Shape.Fill>
                        <UIElement.RenderTransform>
                          <TransformGroup>
                            <RotateTransform />
                          </TransformGroup>
                        </UIElement.RenderTransform>
                      </Path>
                      <Grid Name="ProgressBarTrack" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                        <UIElement.Clip>
                          <EllipseGeometry Center="12,12" RadiusX="12" RadiusY="12" />
                        </UIElement.Clip>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <UIElement.RenderTransform>
                          <RotateTransform Angle="-90" />
                        </UIElement.RenderTransform>
                        <Rectangle Name="SkipValueSpacer" />
                        <Rectangle Name="ProgressBarIndicator" Grid.Column="1" />
                      </Grid>
                      <VisualStateManager.VisualStateGroups>
                        <VisualStateGroup x:Name="CommonStates">
                          <VisualState x:Name="Determinate" />
                          <VisualState x:Name="Indeterminate">
                            <Storyboard RepeatBehavior="Forever">
                              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IndeterminateDonut" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="0">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                  <ObjectKeyFrame.Value>
                                    <Visibility>Visible</Visibility>
                                  </ObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                              </ObjectAnimationUsingKeyFrames>
                              <DoubleAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="IndeterminateDonut" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(RotateTransform.Angle)">
                                <SplineDoubleKeyFrame KeyTime="0:0:1" Value="360" />
                              </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                          </VisualState>
                        </VisualStateGroup>
                      </VisualStateManager.VisualStateGroups>
                    </Grid>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="telerik:AnimationManager.AnimationSelector">
          <Setter.Value>
            <telerik:AnimationSelector>
              <telerik:FadeAnimation AnimationName="Hide" Direction="Out" MaxOpacity="1" MinOpacity="0" SpeedRatio="0" TargetElementName="Indicator" Easing="{x:Null}" />
              <telerik:FadeAnimation AnimationName="Show" Direction="In" MaxOpacity="1" MinOpacity="0" SpeedRatio="0" TargetElementName="Indicator" Easing="{x:Null}" />
            </telerik:AnimationSelector>
          </Setter.Value>
        </Setter>
        <Setter Property="telerik:RadBusyIndicator.OverlayStyle">
          <Setter.Value>
            <Style TargetType="{x:Type Rectangle}">
              <Setter Property="Fill" Value="#88FFFFFF" />
            </Style>
          </Setter.Value>
        </Setter>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type telerik:RadBusyIndicator}">
              <Grid>
                <Border Name="Indicator" MinWidth="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <telerik:RadProgressBar Name="ProgressBar" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" FocusVisualStyle="{DynamicResource ControlStyle1}" Foreground="{TemplateBinding Control.Foreground}" IsIndeterminate="{TemplateBinding telerik:RadBusyIndicator.IsIndeterminate}" RenderTransformOrigin="0.5,0.5" Style="{TemplateBinding telerik:RadBusyIndicator.ProgressBarStyle}" Value="{TemplateBinding telerik:RadBusyIndicator.ProgressValue}">
                    <FrameworkElement.LayoutTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="0.42" ScaleY="0.42" />
                        <SkewTransform />
                        <RotateTransform />
                        <TranslateTransform />
                      </TransformGroup>
                    </FrameworkElement.LayoutTransform>
                  </telerik:RadProgressBar>
                </Border>
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="VisibilityStates">
                    <VisualState x:Name="Hidden">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="0:0:0.001">
                          <DiscreteObjectKeyFrame KeyTime="0">
                            <ObjectKeyFrame.Value>
                              <Visibility>Collapsed</Visibility>
                            </ObjectKeyFrame.Value>
                          </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Visible">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="Indicator" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="0:0:0.001">
                          <DiscreteObjectKeyFrame KeyTime="0">
                            <ObjectKeyFrame.Value>
                              <Visibility>Visible</Visibility>
                            </ObjectKeyFrame.Value>
                          </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                  </VisualStateGroup>
                  <VisualStateGroup x:Name="BusyStatusStates">
                    <VisualState x:Name="Idle">
                      <Storyboard>
                        <ObjectAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ProgressBar" Storyboard.TargetProperty="(UIElement.Visibility)" Duration="0:0:0.001">
                          <DiscreteObjectKeyFrame KeyTime="0">
                            <ObjectKeyFrame.Value>
                              <Visibility>Collapsed</Visibility>
                            </ObjectKeyFrame.Value>
                          </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                        <ObjectAnimationUsingKeyFrames BeginTime="0" Storyboard.TargetName="ProgressBar" Storyboard.TargetProperty="IsIndeterminate" Duration="0">
                          <DiscreteObjectKeyFrame KeyTime="0">
                            <ObjectKeyFrame.Value>
                              <System:Boolean>False</System:Boolean>
                            </ObjectKeyFrame.Value>
                          </DiscreteObjectKeyFrame>
                        </ObjectAnimationUsingKeyFrames>
                      </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Busy" />
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#00000000">
    <i:Interaction.Triggers>
      <i:EventTrigger EventName="MouseEnter">
        <i:Interaction.Behaviors>
          <ei:ConditionBehavior>
            <ei:ConditionalExpression>
              <ei:ComparisonCondition RightOperand="True" LeftOperand="{Binding IsUpdateInProgress, Mode=OneWay}" />
            </ei:ConditionalExpression>
          </ei:ConditionBehavior>
        </i:Interaction.Behaviors>
        <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="popup" Value="True" />
      </i:EventTrigger>
      <i:EventTrigger EventName="MouseLeave">
        <ei:ChangePropertyAction PropertyName="IsOpen" TargetName="popup" Value="False" />
      </i:EventTrigger>
    </i:Interaction.Triggers>
    <i:Interaction.Behaviors>
      <ei:DataStateBehavior FalseState="Normal" TrueState="Updating" Value="True" Binding="{Binding IsUpdateInProgress}" />
      <ei:DataStateBehavior FalseState="Normal" TrueState="Completed" Value="True" Binding="{Binding IsDownloadCompleted}" />
    </i:Interaction.Behaviors>
    <Popup Name="popup" HorizontalAlignment="Right" AllowsTransparency="True" Placement="Top" HorizontalOffset="{Binding ActualWidth, ConverterParameter=*-.5, ElementName=grid, Converter={Converters:ArithmeticConverter}}" PlacementTarget="{Binding ElementName=alignmentBorder}">
      <Grid Name="grid" Margin="0" HorizontalAlignment="Right">
        <Border Margin="0,0,0,19.5" Padding="10" Background="#FFFFFFFF" BorderBrush="#FF000000" BorderThickness="1" CornerRadius="10">
          <Grid>
            <StackPanel Name="UpdateStatuses">
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsApplicationUpdateInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" Text="Application Update: " TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ApplicationUpdateName}" />
              </StackPanel>
              <ProgressBar Height="10" Margin="0,5,0,10" Visibility="{Binding IsApplicationUpdateInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Value="{Binding ApplicationUpdatePercentage}" />
              <StackPanel Orientation="Horizontal" Visibility="{Binding IsLibraryUpdateInProgress, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" Text="Design Library: " TextWrapping="Wrap" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding LibraryUpdateName}" />
              </StackPanel>
              <ProgressBar Height="10" Margin="0,5,0,10" Visibility="{Binding IsLibraryUpdateInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" Value="{Binding LibraryUpdatePercentage}" />
            </StackPanel>
            <Grid Name="Action_Buttons" Margin="5" Background="#FFFFFFFF" Visibility="Collapsed">
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="25" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Static l:Strings.NOW}" Template="{DynamicResource CS4ButtonRoundedHighlight}" Command="{Binding CommandApplyUpdates, Mode=OneWay}" />
              <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Static l:Strings.LATER}" Template="{DynamicResource CS4ButtonRounded}" ToolTip="{x:Static l:Strings.UpdateLaterExplanation}" Command="{Binding CommandDelayUpdates, Mode=OneWay}" />
              <StackPanel Grid.ColumnSpan="2" Margin="10" Orientation="Vertical">
                <TextBlock MaxWidth="200" Margin="0,0,0,10" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" Text="The following updates have been downloaded:" TextWrapping="Wrap" />
                <StackPanel Margin="20,0,0,0" Orientation="Horizontal" Visibility="{Binding IsApplicationUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock MaxWidth="200" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" Text="Version: " TextWrapping="Wrap" />
                  <TextBlock MaxWidth="200" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" TextWrapping="Wrap" Text="{Binding ApplicationUpdateName}" />
                </StackPanel>
                <StackPanel Margin="20,0,0,0" Orientation="Horizontal" Visibility="{Binding IsLibraryUpdateReady, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock MaxWidth="200" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" Text="Design Library: " TextWrapping="Wrap" />
                  <TextBlock MaxWidth="200" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" TextWrapping="Wrap" Text="{Binding LibraryUpdateName}" />
                </StackPanel>
                <TextBlock MaxWidth="200" Margin="0,10,0,0" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" FontSize="13.333" Foreground="#FF000000" Style="{DynamicResource TextBlockService}" Text="Please click the NOW button to apply the update(s)." TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Viewbox HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <Canvas Width="48.6766" Height="21.1615">
            <Rectangle Canvas.Left="10.9107" Canvas.Top="0" Width="27.5417" Height="1.66667" Fill="#FFFFFFFF" Stretch="Fill" />
            <Path Canvas.Left="10.4841" Canvas.Top="0.807705" Width="28.2911" Height="20.1038" Data="F1 M10.9841,1.3077 C21.2183,1.30772 24.6297,7.93148 24.6297,20.4115 C24.6297,7.76091 28.6239,1.30772 38.2753,1.30772" Fill="#FFFFFFFF" Stretch="Fill" Stroke="#FF000000" StrokeEndLineCap="Square" StrokeLineJoin="Round" StrokeStartLineCap="Square" />
          </Canvas>
        </Viewbox>
      </Grid>
    </Popup>
    <telerik:RadBusyIndicator Name="radBusyIndicator" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#00000000" BorderBrush="#00D0D0D0" Content="RadBusyIndicator" Foreground="#FF3d6db5" Style="{DynamicResource RadBusyIndicatorStyle1}" Visibility="Collapsed" IsBusy="{Binding IsUpdateInProgress, Mode=OneWay}" />
    <Grid Name="LEDIndicator" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Visibility="Collapsed">
      <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#FFFFFFFF" Stroke="#FFFFFFFF" />
      <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="#FFFFFFFF">
        <Shape.Fill>
          <RadialGradientBrush GradientOrigin="0.5,0.5">
            <GradientStop Offset="0.681" Color="#FF3d6db5" />
            <GradientStop Offset="1" />
          </RadialGradientBrush>
        </Shape.Fill>
      </Ellipse>
    </Grid>
    <Border Name="alignmentBorder" Width="1" Height="1" HorizontalAlignment="Center" VerticalAlignment="Top" BorderThickness="1" />
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="UpdateStates">
        <VisualState x:Name="Normal" />
        <VisualState x:Name="Updating">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpdateStatuses" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Action_Buttons" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="radBusyIndicator" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Completed">
          <Storyboard>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="UpdateStatuses" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
            </ObjectAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Action_Buttons" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
            <BooleanAnimationUsingKeyFrames Storyboard.TargetName="popup" Storyboard.TargetProperty="(Popup.IsOpen)">
              <DiscreteBooleanKeyFrame KeyTime="0" Value="True" />
            </BooleanAnimationUsingKeyFrames>
            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="LEDIndicator" Storyboard.TargetProperty="(UIElement.Visibility)">
              <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
            </ObjectAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</UserControl>