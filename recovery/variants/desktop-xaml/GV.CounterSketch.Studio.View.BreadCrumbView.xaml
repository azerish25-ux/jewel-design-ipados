<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.BreadCrumbView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" DataContext="{Binding Source={StaticResource Locator}, Path=BreadCrumbVM}">
  <Grid HorizontalAlignment="Left">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <ToggleButton Grid.Column="3" Height="32" Margin="-10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True" Style="{DynamicResource ToggleButtonBreadCrumb}" IsChecked="{Binding IsOrdering, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsOrderingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Order" />
    </ToggleButton>
    <Button Name="ButtonOrder" Grid.Column="3" Height="32" Style="{DynamicResource ButtonStyleTransparent}" Command="{Binding CommandNavigateToOrder}" Visibility="{Binding IsOrderingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <ToggleButton Grid.Column="2" Height="32" Margin="-10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True" Style="{DynamicResource ToggleButtonBreadCrumb}" IsChecked="{Binding IsEditing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsDesignLoaded}" Visibility="{Binding IsEditingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LabelEditing, FallbackValue=SCS-3245-OVF}" />
    </ToggleButton>
    <Button Name="ButtonCustomize" Grid.Column="2" Height="32" Style="{DynamicResource ButtonStyleTransparent}" Command="{Binding CommandNavigateToCustomize}" Visibility="{Binding IsEditingVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <ToggleButton Grid.Column="1" Height="32" Margin="-10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" SnapsToDevicePixels="True" Style="{DynamicResource ToggleButtonBreadCrumb}" IsChecked="{Binding IsSearch, Mode=TwoWay, FallbackValue=True, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding LabelSearch, FallbackValue=Fashion}" />
    </ToggleButton>
    <Button Name="ButtonSearch" Grid.Column="1" Height="32" Style="{DynamicResource ButtonStyleBlank}" Command="{Binding CommandNavigateToSearch}" Visibility="{Binding IsSearchVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <ToggleButton Width="32" Height="32" Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#DDDDDD" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" SnapsToDevicePixels="True" Style="{DynamicResource ToggleButtonBreadCrumbHome}" IsChecked="{Binding IsHome, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsHomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    <Button Name="ButtonHome" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource ButtonStyleTransparent}" Command="{Binding CommandNavigateToHome}" Visibility="{Binding IsHomeVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Viewbox Height="20">
        <ContentControl Content="{StaticResource TopBar_Home}" Style="{DynamicResource ContentControlStyleShadow}" />
      </Viewbox>
    </Button>
  </Grid>
</UserControl>