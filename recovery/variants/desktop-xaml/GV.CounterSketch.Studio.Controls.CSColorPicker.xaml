<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.CSColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Width="510" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <DrawingBrush x:Key="CheckerboardBrush" Stretch="None" TileMode="Tile" AlignmentX="Left" AlignmentY="Top" Viewport="0,0,10,10" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
          <DrawingGroup>
            <GeometryDrawing Brush="sc# 1,1,1">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,10,10" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="sc# 0.5,0.5,0.5">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="0,0,5,5" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="sc# 0.5,0.5,0.5">
              <GeometryDrawing.Geometry>
                <RectangleGeometry Rect="5,5,5,5" />
              </GeometryDrawing.Geometry>
            </GeometryDrawing>
          </DrawingGroup>
        </DrawingBrush.Drawing>
      </DrawingBrush>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="0" Background="{x:Null}">
    <Grid.RowDefinitions>
      <RowDefinition Height="35" />
      <RowDefinition Height="*" />
      <RowDefinition Height="0" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" HorizontalAlignment="Stretch" Orientation="Horizontal">
      <Label Content="Choose your color below:" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
    </StackPanel>
    <Grid Row="1" VerticalAlignment="Top" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="170" />
      </Grid.ColumnDefinitions>
      <Grid Column="0" Row="0" Margin="10,30,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Border BorderBrush="#FF000000" BorderThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFFFFFFF" Width="154" Height="154" />
        <Image Name="ColorImage" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2" Source="/CounterSketch Studio;component/Images/ColorSwatchSquare2.png" />
        <Canvas Name="CanvImage" Width="150" Height="150" HorizontalAlignment="Center" Background="#00FFFFFF" VerticalAlignment="Top" Margin="2" MouseDown="CanvImage_MouseDown" MouseUp="CanvImage_MouseUp" MouseMove="CanvImage_MouseMove">
          <Ellipse Name="ellipsePixel" Width="10" Height="10" Stroke="#FF000000" Fill="#FFFFFFFF" Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Label Content="Preview" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
        <Canvas Name="CanvPreview" Margin="4,5,10,0" Width="154" Height="154" Background="{StaticResource CheckerboardBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" MouseDown="CanvPreview_MouseDown" MouseMove="CanvPreview_MouseMove" MouseUp="CanvPreview_MouseUp">
          <Image Name="imageLogo" Stretch="Fill" Canvas.Left="15" Canvas.Top="60" Width="125" Height="30" />
          <Ellipse Name="ellipsePixelPreview" Width="10" Height="10" Stroke="#FF000000" Fill="#FFFFFFFF" Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Vertical" Margin="0,0,0,10" HorizontalAlignment="Center" VerticalAlignment="Bottom">
        <StackPanel Orientation="Horizontal" Margin="0,30,0,0" Visibility="Collapsed">
          <Label Content="A" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Width="50" Height="30">
            <TextBox Name="txtAlpha" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
            <TextBox Name="txtAlphaHex" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Label Content="R" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Width="50" Height="30">
            <TextBox Name="txtRed" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
            <TextBox Name="txtRedHex" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Label Content="G" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Width="50" Height="30">
            <TextBox Name="txtGreen" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
            <TextBox Name="txtGreenHex" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Label Content="B" Margin="5,0,0,0" HorizontalAlignment="Left" Foreground="#FFFFFFFF" FontWeight="Bold" VerticalAlignment="Center" />
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Width="50" Height="30">
            <TextBox Name="txtBlue" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
          <Border CornerRadius="5" BorderBrush="#FF000000" Background="#FFD3D3D3" BorderThickness="2" Margin="10,0,0,0" Width="50" Height="30">
            <TextBox Name="txtBlueHex" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
          <Border CornerRadius="5" Margin="22,0,0,0" Background="#FFD3D3D3" BorderBrush="#FF000000" BorderThickness="2" Width="112" Height="30">
            <TextBox Name="txtAll" BorderThickness="0" Background="#FFD3D3D3" BorderBrush="#00FFFFFF" Margin="5,1,5,1" IsReadOnly="True" />
          </Border>
        </StackPanel>
      </StackPanel>
    </Grid>
    <Border Name="AlphaBorder" Grid.Row="2" BorderBrush="#FF000000" Height="0" BorderThickness="2" CornerRadius="5" Margin="10,36.667,10,-5" Background="#FFFFFFFF" Visibility="Collapsed">
      <Slider Name="AlphaSlider" Orientation="Horizontal" Minimum="0" Maximum="255" SmallChange="1" LargeChange="25" VerticalAlignment="Center" Margin="5" Value="255" Visibility="Collapsed" ValueChanged="AlphaSlider_ValueChanged" />
    </Border>
  </Grid>
</UserControl>