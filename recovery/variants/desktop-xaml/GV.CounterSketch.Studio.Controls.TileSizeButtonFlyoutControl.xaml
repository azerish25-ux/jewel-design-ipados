<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.Controls.TileSizeButtonFlyoutControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Name="TileSizeControl" Background="#00000000" xmlns:controls="clr-namespace:GV.CounterSketch.Studio.Controls" MouseLeave="TileSizeButtonFlyoutControl_OnMouseLeave">
  <Grid>
    <i:Interaction.Behaviors>
      <ei:DataStateBehavior FalseState="Default" TrueState="Open" Value="True" Binding="{Binding IsOpen, ElementName=popup, UpdateSourceTrigger=PropertyChanged}" />
    </i:Interaction.Behaviors>
    <Button Width="32" Height="32" Padding="0" VerticalAlignment="Top" BorderBrush="#FF808080" Cursor="Hand" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.AdjustTileSize}" Click="Button_Click">
      <Grid>
        <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileLarge}" Stroke="#FF000000" Visibility="{Binding IsLarge, ElementName=TileSizeControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
        <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileWide}" Stroke="#FF000000" Visibility="{Binding IsWide, ElementName=TileSizeControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
        <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileMedium}" Stroke="#FF000000" Visibility="{Binding IsMedium, ElementName=TileSizeControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
        <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileSmall}" Stroke="#FF000000" Visibility="{Binding IsSmall, ElementName=TileSizeControl, Converter={StaticResource BooleanToVisibilityConverter}, UpdateSourceTrigger=PropertyChanged}" />
      </Grid>
    </Button>
    <Popup Name="popup" AllowsTransparency="True" VerticalOffset="-1" IsOpen="{Binding IsOpen, ElementName=TileSizeControl, UpdateSourceTrigger=PropertyChanged}">
      <Grid Width="32" Height="136" Margin="0,1,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#00000000">
        <Button Name="SmallButton" Width="32" Height="32" Margin="0,1,0,0" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.SmallTile}" Click="SmallButton_OnClick">
          <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileSmall}" Stroke="#FF000000" />
        </Button>
        <Button Name="MediumButton" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.MediumTile}" Click="MediumButton_OnClick">
          <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileMedium}" Stroke="#FF000000" />
        </Button>
        <Button Name="WideButton" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.WideTile}" Click="WideButton_OnClick">
          <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileWide}" Stroke="#FF000000" />
        </Button>
        <Button Name="LargeButton" Width="32" Height="32" HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" ToolTip="{x:Static l:Strings.LargeTile}" Click="LargeButton_OnClick">
          <Rectangle Width="16" Height="16" MinWidth="0.8" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource TileLarge}" Stroke="#FF000000" />
        </Button>
      </Grid>
    </Popup>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="VisualStateGroup">
        <VisualState x:Name="Default" />
        <VisualState x:Name="Open">
          <Storyboard>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="LargeButton" Storyboard.TargetProperty="(FrameworkElement.Margin)">
              <EasingThicknessKeyFrame KeyTime="0:0:0.1" Value="0,104,0,0" />
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="WideButton" Storyboard.TargetProperty="(FrameworkElement.Margin)">
              <EasingThicknessKeyFrame KeyTime="0:0:0.1" Value="0,70,0,0" />
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="MediumButton" Storyboard.TargetProperty="(FrameworkElement.Margin)">
              <EasingThicknessKeyFrame KeyTime="0:0:0.1" Value="0,36,0,0" />
            </ThicknessAnimationUsingKeyFrames>
            <ThicknessAnimationUsingKeyFrames Storyboard.TargetName="SmallButton" Storyboard.TargetProperty="(FrameworkElement.Margin)">
              <EasingThicknessKeyFrame KeyTime="0:0:0.1" Value="0,2,0,0" />
            </ThicknessAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</UserControl>