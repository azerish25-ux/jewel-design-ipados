<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowRenderOptionsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:cvrt="clr-namespace:GV.CounterSketch.Studio.Utilities.Converters" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:pagedListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.PagedListBox" x:Name="TheWindow" Title="{x:Static l:Strings.Render}" Width="830" Height="600" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" AllowsTransparency="True" FontFamily="Helvetica Neue LT Std" Foreground="{DynamicResource BaseBackground}" ResizeMode="NoResize" ShowInTaskbar="False" SnapsToDevicePixels="True" Style="{DynamicResource WindowStyleNonModalCS4}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" Background="{x:Null}" DataContext="{Binding Mode=Default, Path=WindowRenderOptionsVM, Source={StaticResource Locator}}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition />
      <RowDefinition Height="40" />
    </Grid.RowDefinitions>
    <DockPanel Grid.ColumnSpan="2" Margin="10,10,10,0" LastChildFill="False">
      <TextBlock VerticalAlignment="Center" Text="{x:Static l:Strings.RenderResolution}" TextWrapping="Wrap" />
      <ComboBox Height="20" Margin="10,0,0,0" VerticalAlignment="Center" Style="{DynamicResource CSComboBoxStyleBasic}" ItemsSource="{Binding SelectedRenderResolutionOptions, Mode=OneWay, Converter={cvrt:EnumToDescriptionConverter}}" SelectedItem="{Binding SelectedRenderResolution, Mode=TwoWay, Converter={cvrt:EnumToDescriptionConverter}}" />
      <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" Content="{x:Static l:Strings.LayFlat}" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding IsRenderDesignLayFlat}" />
      <CheckBox Margin="10,0,0,0" VerticalAlignment="Center" Content="{x:Static l:Strings.ToggleRenderPreview}" Style="{DynamicResource CS4CheckBoxStyle}" Visibility="Collapsed" IsChecked="{Binding IsRenderPreviewToggled}" />
    </DockPanel>
    <StackPanel Grid.Row="1" Margin="10,10,0,0">
      <Border Margin="0" BorderThickness="0,1,0,0">
        <Border.BorderBrush>
          <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
        </Border.BorderBrush>
        <StackPanel>
          <StackPanel Orientation="Vertical">
            <DockPanel Margin="0,5" LastChildFill="False">
              <TextBlock Margin="5,0,0,0" FontSize="14.667" Text="{x:Static l:Strings.RENDERPROPS}" TextWrapping="Wrap" />
            </DockPanel>
            <pagedListBox:PagedListBox Margin="0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxItemRender}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" Template="{DynamicResource PagedListBoxRenderStyle}" ItemsSource="{Binding RenderPropOptions}" SelectedItem="{Binding SelectedRenderProp}" />
            <Separator Margin="0,4">
              <Control.Background>
                <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
              </Control.Background>
            </Separator>
          </StackPanel>
          <StackPanel Margin="0,5,0,0">
            <TextBlock Margin="5,0,0,0" Text="{x:Static l:Strings.PROPSPRIMARYMATERIAL}" TextWrapping="Wrap" />
            <pagedListBox:PagedListBox Margin="0,6,0,0" FontFamily="Helvetica Neue LT Std" FontSize="10.667" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxItemRender}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" Template="{DynamicResource PagedListBoxRenderStyle}" IsEnabled="{Binding PrimaryPropMaterialOptionsEnabled}" ItemsSource="{Binding RenderPropMaterialOptions, Mode=OneWay}" SelectedItem="{Binding SelectedRenderPropPrimaryMaterial, Mode=TwoWay}" />
            <Separator Margin="0,2">
              <Control.Background>
                <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
              </Control.Background>
            </Separator>
          </StackPanel>
          <StackPanel>
            <TextBlock Margin="5,0,0,0" Text="{x:Static l:Strings.PROPSSECONDARYMATERIAL}" TextWrapping="Wrap" />
            <pagedListBox:PagedListBox Margin="0,6,0,0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="10.667" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxItemRender}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" Template="{DynamicResource PagedListBoxRenderStyle}" IsEnabled="{Binding SecondaryPropMaterialOptionsEnabled}" ItemsSource="{Binding RenderPropMaterialOptions, Mode=OneWay}" SelectedItem="{Binding SelectedRenderPropSecondaryMaterial, Mode=TwoWay}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    <Border Grid.Row="1" Grid.Column="1" Margin="0,10,10,0" BorderThickness="1,1,0,0">
      <Border.BorderBrush>
        <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
      </Border.BorderBrush>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="164*" />
          <RowDefinition Height="164*" />
          <RowDefinition Height="164*" />
        </Grid.RowDefinitions>
        <Border>
          <StackPanel Margin="0,2,0,0">
            <TextBlock Margin="10,0,0,10" FontSize="14.667" Text="{x:Static l:Strings.GROUNDPLANE}" TextWrapping="Wrap" />
            <pagedListBox:PagedListBox Margin="0" FontFamily="Helvetica Neue LT Std" FontSize="10.667" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxItemRender}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" Template="{DynamicResource PagedListBoxRenderStyle}" ItemsSource="{Binding RenderGroundplaneMaterialOptions, Mode=OneWay}" SelectedItem="{Binding SelectedRenderGroundPlane, Mode=TwoWay}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Grid.RowSpan="2" BorderThickness="0,1,0,0">
          <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
          </Border.BorderBrush>
          <StackPanel Margin="0,3,0,0">
            <TextBlock Margin="10,0,0,10" FontFamily="Helvetica Neue LT Std" FontSize="14.667" Text="{x:Static l:Strings.ENVIRONMENT}" TextWrapping="Wrap" />
            <pagedListBox:PagedListBox Margin="0" FontFamily="Helvetica Neue LT Std" FontSize="10.667" ItemContainerStyle="{DynamicResource ItemStylePagedListBoxItemRender}" ItemTemplate="{DynamicResource DataTemplatePagedListBoxItemRounded}" SelectedIndex="0" Template="{DynamicResource PagedListBoxRenderStyle}" ItemsSource="{Binding RenderEnvironmentOptions}" SelectedItem="{Binding SelectedRenderEnvironment}" />
          </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.RowSpan="2" BorderThickness="0,1,0,0">
          <Border.BorderBrush>
            <SolidColorBrush Color="{DynamicResource WindowFrameBackgroundColor}" />
          </Border.BorderBrush>
          <StackPanel>
            <TextBlock Margin="10,5,0,0" FontSize="14.667" TextWrapping="Wrap" Text="{Binding Source={x:Static l:Strings.OutputOptions}, Converter={StaticResource StringToUpperCaseConverter}}" />
            <StackPanel Margin="20,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Orientation="Horizontal">
              <CheckBox Name="CheckBox" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Static l:Strings.SaveRendersToFolder}" FontFamily="Helvetica Neue LT Std" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding IsSaveRenderEnabled, FallbackValue=True}" />
              <Button Margin="10,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Static l:Strings.Browse}" FontFamily="Helvetica Neue LT Std" Padding="5,1" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandSetRenderSaveLocation, Mode=OneWay}" Visibility="{Binding IsChecked, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=CheckBox, Mode=OneWay}" />
            </StackPanel>
            <CheckBox Name="CheckBox_Copy" Margin="20,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static l:Strings.RenderPropsOnAlphaChannel}" FontFamily="Helvetica Neue LT Std" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding IsRenderPropsAlphaed, FallbackValue=True}" />
            <CheckBox Name="CheckBox_Copy1" Margin="20,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static l:Strings.RenderGroundPlaneOnAlphaChannel}" FontFamily="Helvetica Neue LT Std" Style="{DynamicResource CS4CheckBoxStyle}" IsChecked="{Binding IsRenderGroundPlaneAlphaed, FallbackValue=True}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="10,0">
      <Button Margin="0,10.8" VerticalAlignment="Center" Content="{x:Static l:Strings.SaveAsDefault}" FontFamily="Helvetica Neue LT Std" Padding="10,1" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandSaveDefaults, Mode=OneWay}" />
      <Button Name="BtnRenderSettings" Margin="5,12.8,0,12.8" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Helvetica Neue LT Std" Template="{DynamicResource CS4ButtonPrimaryNoBackground}" Command="{Binding CommandResetOptions, Mode=OneWay}">
        <TextBlock FontFamily="Helvetica Neue LT Std" FontWeight="Bold" Foreground="{DynamicResource WindowFrameBackground}" Text="{x:Static l:Strings.Reset}" TextWrapping="Wrap" />
      </Button>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Right" Orientation="Horizontal">
        <Button VerticalAlignment="Center" Content="{x:Static l:Strings.Render}" FontFamily="Helvetica Neue LT Std" Padding="10,1" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandRender, Mode=OneWay}" />
        <Button Margin="10,0,0,0" VerticalAlignment="Center" Content="{x:Static l:Strings.Close}" FontFamily="Helvetica Neue LT Std" Padding="20,1" Template="{DynamicResource CS4ButtonRoundedHighlight}" Click="ButtonBase_OnClick" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>