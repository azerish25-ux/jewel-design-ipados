        <DockPanel Margin="0,0,0,4" HorizontalAlignment="Stretch" Background="#FFFFFFFF">
          <ContentControl Width="18" Height="15" Margin="4,0" HorizontalAlignment="Right" VerticalAlignment="Center" DockPanel.Dock="Left" Content="{StaticResource Icon_Warning}" />
          <Button VerticalAlignment="Center" Background="#00FFFFFF" Content="Reset" DockPanel.Dock="Right" Foreground="#7b7b7b" Command="{Binding Path=DesignStackVM.CommandResetUIControl, Source={StaticResource Locator}}" CommandParameter="{Binding}" />
          <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Left" FontSize="11" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding ControlName, Mode=OneTime, Converter={StaticResource TranslateStringConverter}}" />
        </DockPanel>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
