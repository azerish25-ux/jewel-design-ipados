<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.DesignStackView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:custom="http://www.galasoft.ch/mvvmlight" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:system="clr-namespace:System;assembly=mscorlib" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" x:Name="UserControl" Margin="0" Background="#FFFFFFFF" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding Source={StaticResource Locator}, Path=DesignStackVM}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="MainColorBrush" Color="#0a9696" />
      <SolidColorBrush x:Key="MainColorLightBrush" Color="#15cdcd" />
      <SolidColorBrush x:Key="MainTextBrush" Color="#e6e6fa" />
      <SolidColorBrush x:Key="LightTextBrush" Color="#fafaff" />
      <SolidColorBrush x:Key="DarkTextBrush" Color="#b4b4c8" />
      <system:Double x:Key="DisabledOpacity">0.4</system:Double>
      <system:Double x:Key="MediumFontSize">13</system:Double>
      <Style x:Key="SwitchStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type CheckBox}">
              <FrameworkTemplate.Resources>
                <ResourceDictionary>
                  <Storyboard x:Key="OnChecking">
                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="slider" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                      <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="20" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                  <Storyboard x:Key="OnUnchecking">
                    <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="slider" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                      <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="0" />
                    </DoubleAnimationUsingKeyFrames>
                  </Storyboard>
                </ResourceDictionary>
              </FrameworkTemplate.Resources>
              <Grid>
                <Border Name="BorderBackground" Width="40" Height="20" Background="#FF808080" CornerRadius="10">
                  <Border Name="slider" Width="16" Height="16" Margin="2,0,2,0" HorizontalAlignment="Left" Background="#fafaff" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                    <UIElement.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <SkewTransform AngleX="0" AngleY="0" />
                        <RotateTransform Angle="0" />
                        <TranslateTransform X="0" Y="0" />
                      </TransformGroup>
                    </UIElement.RenderTransform>
                  </Border>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <TriggerBase.ExitActions>
                    <BeginStoryboard Name="OnUnchecking_BeginStoryboard" Storyboard="{StaticResource OnUnchecking}" />
                  </TriggerBase.ExitActions>
                  <TriggerBase.EnterActions>
                    <BeginStoryboard Name="OnChecking_BeginStoryboard" Storyboard="{StaticResource OnChecking}" />
                  </TriggerBase.EnterActions>
                  <Setter TargetName="BorderBackground" Value="{DynamicResource HighlightAndAccent}" Property="Border.Background" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter Property="UIElement.Opacity" Value="{StaticResource DisabledOpacity}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxItemStyleWithoutSelection" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="BorderBrush" Value="#00FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid Height="Auto">
                <ContentPresenter Width="Auto" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <DataTemplate x:Key="CategoryControlsDataTemplate">
        <DockPanel Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Width="Auto" Height="Auto" VerticalAlignment="Top" BorderBrush="#FF808080" BorderThickness="0,0,0,3" DockPanel.Dock="Top">
            <Grid Margin="0,10,0,2">
              <TextBlock HorizontalAlignment="Stretch" VerticalAlignment="Bottom" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="14.667" FontWeight="Bold" Foreground="#FF808080" TextAlignment="Center" TextWrapping="Wrap" Text="{Binding ContainerName}" />
            </Grid>
          </Border>
          <ListBox Width="Auto" Height="Auto" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" BorderThickness="0" DockPanel.Dock="Bottom" ItemContainerStyle="{DynamicResource ListBoxItemStyleWithoutSelection}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" Style="{DynamicResource ListBoxEmptyStyle}" Template="{DynamicResource ListBoxControlTemplateWithoutScroll}" ItemsSource="{Binding CategoryControls}" />
        </DockPanel>
      </DataTemplate>
      <ControlTemplate x:Key="ListBoxControlTemplateWithoutScroll" TargetType="{x:Type ListBox}">
        <ItemsPresenter Name="itemsPresenter" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
        <ControlTemplate.Triggers>
          <Trigger Property="UIElement.IsEnabled" Value="False" />
          <MultiTrigger>
            <MultiTrigger.Conditions>
              <Condition Property="ItemsControl.IsGrouping" Value="True" />
              <Condition Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="False" />
            </MultiTrigger.Conditions>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
            <Setter TargetName="itemsPresenter" Value="{DynamicResource ItemsPresenterStyleEmpty}" Property="FrameworkElement.Style" />
          </MultiTrigger>
        </ControlTemplate.Triggers>
      </ControlTemplate>
      <Style x:Key="ListBoxItemStyleCategoryControl" TargetType="{x:Type ListBoxItem}">
        <Setter Property="UIElement.SnapsToDevicePixels" Value="True" />
        <Setter Property="Padding" Value="4,1" />
