<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.Controls.WindowModalColorPicker" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity" xmlns:GV_CounterSketch_Utilities_Behaviors="clr-namespace:GV.CounterSketch.Studio.Utilities.Behaviors" xmlns:Controls="clr-namespace:GV.CounterSketch.Studio.Controls" x:Name="theWindow" Title="Options" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" SnapsToDevicePixels="True" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Foreground="#FFFFFFFF" ShowInTaskbar="False" SizeToContent="WidthAndHeight" Style="{DynamicResource WindowStyleModalCS4}" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" Background="{x:Null}">
