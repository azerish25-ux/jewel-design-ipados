<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="GV.CounterSketch.Studio.View.UserPartsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:command="http://www.galasoft.ch/mvvmlight" xmlns:counterSketchLibrary="clr-namespace:GV.CounterSketch.Studio.Model.Entities.CounterSketchLibrary" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:fa="http://schemas.fontawesome.io/icons/" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:local="clr-namespace:GV.CounterSketch.Studio.View" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:objects="clr-namespace:GV.CounterSketch.Studio.Model.Objects" xmlns:scrollableListBox="clr-namespace:GV.CounterSketch.Studio.UserControls.ScrollableListBox" xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation" Background="#FFFFFFFF">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ItemsPanelTemplate x:Key="ItemsPanelTemplate">
        <WrapPanel Name="VirtualizingWrapPanel" IsItemsHost="True" Width="{Binding Path=ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" ItemHeight="{Binding ItemWidth, ElementName=VirtualizingWrapPanel, UpdateSourceTrigger=PropertyChanged}" ItemWidth="{Binding Path=TileSearchMainVM.TileSearchResultPartsVM.DesignImageWidth, Source={StaticResource Locator}}" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="DataTemplateSearchResults" DataType="objects:PartItem">
        <Grid>
          <UIElement.InputBindings>
            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding Path=UserPartsVM.CommandAddSelectedPart, Source={StaticResource Locator}}" CommandParameter="{Binding}" />
          </UIElement.InputBindings>
          <DockPanel>
            <StackPanel Width="Auto" Margin="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" DockPanel.Dock="Bottom" Orientation="Vertical">
              <TextBox MaxWidth="200" Background="#00FFFFFF" BorderThickness="0" FontFamily="/EmbeddedFonts;Component/Fonts/#Helvetica Neue LT Std" FontSize="14" Foreground="#FF808080" IsReadOnly="True" MaxLines="1" TextWrapping="NoWrap" Text="{Binding Name}" Visibility="{Binding Path=TileSearchMainVM.ActiveSearchResultViewModel.SPINumberVisibility, Source={StaticResource Locator}}" />
            </StackPanel>
            <Grid>
              <Image MinWidth="100" MinHeight="100" MaxWidth="400" MaxHeight="400" Cursor="Hand" Width="{Binding Path=TileSearchMainVM.TileSearchResultPartsVM.DesignImageWidth, Source={StaticResource Locator}}" Height="{Binding Path=TileSearchMainVM.TileSearchResultPartsVM.DesignImageWidth, Source={StaticResource Locator}}" Source="{Binding ItemImagePath, Converter={StaticResource ImagePathToBitmapImageConverter}}" ToolTip="{Binding Name}" ToolTipService.IsEnabled="{Binding Path=TileSearchMainVM.ActiveSearchResultViewModel.ShowSPIToolTipNumber, Source={StaticResource Locator}}" />
              <Button Width="26" Height="26" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top" Style="{DynamicResource ButtonStyleRoundAction}" Command="{Binding Path=UserPartsVM.CommandDeleteUserPart, Source={StaticResource Locator}}" CommandParameter="{Binding}">
                <wpf:ImageAwesome FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" xmlns:wpf="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" wpf:ImageAwesome.Icon="Trash" />
              </Button>
            </Grid>
          </DockPanel>
        </Grid>
      </DataTemplate>
      <Style x:Key="ListBoxItemStyleSearchResults" TargetType="{x:Type ListBoxItem}">
        <Setter Property="ListBoxItem.IsSelected" Value="{Binding IsSelected}" />
        <Setter Property="Background" Value="#00FFFFFF" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Margin" Value="10" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBoxItem}">
              <Grid>
                <Border Name="Bd" Margin="0" Padding="0" BorderBrush="{DynamicResource HighlightAndAccent}" BorderThickness="1" CornerRadius="0" SnapsToDevicePixels="True" />
                <ContentPresenter Margin="10" HorizontalAlignment="{TemplateBinding Control.HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="ListBoxStyleSearchResults" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        <Setter Property="BorderBrush" Value="{StaticResource ListBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
        <Setter Property="ScrollViewer.PanningMode" Value="VerticalOnly" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="True" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ListBox}">
              <Border Name="Bd" Padding="0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" SnapsToDevicePixels="True">
                <ScrollViewer Name="ScrollViewerResults" Margin="10" Padding="{TemplateBinding Control.Padding}" CanContentScroll="False" Focusable="False">
                  <ItemsPresenter SnapsToDevicePixels="{TemplateBinding UIElement.SnapsToDevicePixels}" />
                </ScrollViewer>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Bd" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Property="Border.Background" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="10" Background="#FFFFFFFF">
    <telerik:RadSlider Name="RadSlider" Width="300" Height="20.3" Margin="0,5,10,5" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="Hand" LargeChange="10" Maximum="500" Minimum="100" SmallChange="10" ThumbStyle="{DynamicResource RadThumbStyle}" TrackStyle="{DynamicResource RadSliderTrackStyle}" Value="{Binding Source={StaticResource Locator}, Path=TileSearchMainVM.TileSearchResultPartsVM.DesignImageWidth, Mode=TwoWay}" />
    <scrollableListBox:ScrollableListBox x:Name="SearchResultsList" Grid.Row="2" Margin="30" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#FFFFFFFF" IsHitTestVisible="True" ItemContainerStyle="{DynamicResource ListBoxItemStyleSearchResults}" ItemTemplate="{DynamicResource DataTemplateSearchResults}" ItemsPanel="{DynamicResource ItemsPanelTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionMode="Single" Style="{StaticResource ListBoxStyleSearchResults}" Width="{Binding ElementName=VirtualWrapPanelSizer, Path=ActualWidth}" Height="{Binding ElementName=VirtualWrapPanelSizer, Path=ActualHeight}" BorderBrush="{x:Null}" ItemsSource="{Binding Parts, UpdateSourceTrigger=PropertyChanged}" SelectedItem="{Binding SelectedDesignSearch, Mode=TwoWay}" Visibility="{Binding ResultsVisibility}" />
    <Button Width="32" Height="32" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Style="{DynamicResource ButtonStyleRoundAction}" Command="{Binding CommandImportPart}">
      <ImageAwesome FrameworkElement.Margin="2" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" p16:ImageAwesome.Icon="Plus" xmlns:p16="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" xmlns="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF" />
    </Button>
  </Grid>
</UserControl>