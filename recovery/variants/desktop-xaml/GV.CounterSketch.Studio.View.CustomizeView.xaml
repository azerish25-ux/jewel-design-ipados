  <FrameworkElement.Resources>
    <ResourceDictionary>
      <ControlTemplate x:Key="CS4ButtonPrimary" TargetType="{x:Type Button}">
        <Grid>
          <Grid Name="Default" Opacity="0">
            <Grid Width="Auto" Height="Auto">
              <Panel.Background>
                <LinearGradientBrush StartPoint="1.00038,0.998987" EndPoint="0.000375366,-0.00101929">
                  <GradientStop Offset="0" Color="#FFCCC6C1" />
                  <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Panel.Background>
            </Grid>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="#FFCCC6C1" BorderThickness="1" />
          </Grid>
          <Grid Name="HoverPressed" Opacity="0">
            <Grid>
              <Panel.Background>
                <LinearGradientBrush StartPoint="1.00038,0.998987" EndPoint="0.000376892,-0.00101929">
                  <GradientStop Offset="0" Color="{DynamicResource HighlightAndAccentColor}" />
                  <GradientStop Offset="1" Color="#00FFFFFF" />
                </LinearGradientBrush>
              </Panel.Background>
            </Grid>
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch" BorderBrush="{DynamicResource HighlightAndAccent}" BorderThickness="1" />
          </Grid>
          <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
          <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
              <VisualState x:Name="Normal" />
              <VisualState x:Name="MouseOver">
                <Storyboard>
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Default" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Pressed">
                <Storyboard>
                  <DoubleAnimationUsingKeyFrames Storyboard.TargetName="HoverPressed" Storyboard.TargetProperty="(UIElement.Opacity)">
                    <EasingDoubleKeyFrame KeyTime="0" Value="1" />
                  </DoubleAnimationUsingKeyFrames>
                </Storyboard>
              </VisualState>
              <VisualState x:Name="Disabled" />
            </VisualStateGroup>
          </VisualStateManager.VisualStateGroups>
        </Grid>
      </ControlTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Background="#FFFFFFFF">
    <i:Interaction.Triggers>
      <ei:DataTrigger Value="True" Binding="{Binding IsOrderSectionVisible}">
        <ei:ControlStoryboardAction>
          <ei:StoryboardAction.Storyboard>
            <Storyboard Completed="ShowOrderTimeline_OnCompleted">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrderSummaryViewControl" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="800" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DesignStackView" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FreehandStackView" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridPartsListView" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Components" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DesignActionButtons" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ei:StoryboardAction.Storyboard>
        </ei:ControlStoryboardAction>
      </ei:DataTrigger>
      <ei:DataTrigger Value="False" Binding="{Binding IsOrderSectionVisible}">
        <ei:ControlStoryboardAction>
          <ei:StoryboardAction.Storyboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="OrderSummaryViewControl" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="0" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DesignStackView" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="400" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FreehandStackView" Storyboard.TargetProperty="Width">
                <EasingDoubleKeyFrame Value="400" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GridPartsListView" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="1" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Components" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="1" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DesignActionButtons" Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame Value="1" KeyTime="{Binding OrderTransitionTime}">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <PowerEase EasingMode="EaseInOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ei:StoryboardAction.Storyboard>
        </ei:ControlStoryboardAction>
      </ei:DataTrigger>
