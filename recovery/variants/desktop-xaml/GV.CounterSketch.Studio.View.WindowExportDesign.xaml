<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="GV.CounterSketch.Studio.View.WindowExportDesign" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ei="http://schemas.microsoft.com/expression/2010/interactions" xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" xmlns:l="clr-namespace:Localization;assembly=Localization" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" Title="{x:Static l:Strings.ExportSTL3DM}" SizeToContent="WidthAndHeight" xmlns:view="clr-namespace:GV.CounterSketch.Studio.View" DataContext="{Binding WindowExportDesignVM, Mode=Default, Source={StaticResource Locator}}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="200*" />
      <RowDefinition Height="25*" />
      <RowDefinition Height="25*" />
      <RowDefinition Height="25*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition />
      <ColumnDefinition />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>
    <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,20,10" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
      <Button Name="button_Copy" Width="74" Margin="0,0,20,0" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Static l:Strings.Browse}" Command="{Binding CommandBrowse}" />
      <Button Name="button" Width="74" HorizontalAlignment="Center" VerticalAlignment="Stretch" Command="{Binding CommandExportDesign}" Content="{Binding ExportButtonText}" />
    </StackPanel>
    <StackPanel Height="120" Margin="22,10,12,9" HorizontalAlignment="Left" Orientation="Vertical">
      <DockPanel Margin="0,0,20,0" HorizontalAlignment="Left" VerticalAlignment="Top">
        <TextBlock Name="textBlock" VerticalAlignment="Bottom" DockPanel.Dock="Top" FontSize="10.667" FontWeight="Bold" Text="{x:Static l:Strings.DesignOptions}" TextWrapping="Wrap" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" DockPanel.Dock="Bottom">
          <RadioButton Name="radioButton" Margin="0,10,0,0" Content="{x:Static l:Strings.Default}" GroupName="DesignOptionsGrp" IsChecked="{Binding IsDesignOptionDefault}" />
          <RadioButton Name="radioButton1" Margin="0,10,0,0" Content="{x:Static l:Strings.ExtendProngs}" GroupName="DesignOptionsGrp" IsChecked="{Binding IsDesignOptionProngsExtended}" />
        </StackPanel>
      </DockPanel>
      <TextBlock Name="textBlock3" Width="Auto" Margin="0,10,0,0" Text="{x:Static l:Strings.ExtendProngsWarning}" TextWrapping="Wrap" Visibility="{Binding IsChecked, ElementName=radioButton1, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </StackPanel>
    <DockPanel Grid.Column="1" Margin="10,10,10,0" HorizontalAlignment="Center" VerticalAlignment="Top">
      <TextBlock Name="textBlock1" VerticalAlignment="Bottom" DockPanel.Dock="Top" FontSize="10.667" FontWeight="Bold" Text="{x:Static l:Strings.StoneOptions}" TextWrapping="Wrap" />
      <StackPanel DockPanel.Dock="Bottom">
        <DockPanel Margin="0,12,0,5">
          <CheckBox Name="checkBox" Width="16" Margin="0,0,5,0" IsChecked="{Binding IsStoneOptionCenterEnabled}" />
          <TextBlock Text="{x:Static l:Strings.ShowCenter}" />
        </DockPanel>
        <DockPanel Margin="0,12,0,5">
          <CheckBox Name="checkBox1" Width="16" Margin="0,0,5,0" IsChecked="{Binding IsStoneOptionSideEnabled}" />
          <TextBlock Text="{x:Static l:Strings.ShowSide}" />
        </DockPanel>
        <DockPanel Margin="0,12,0,5">
          <CheckBox Name="checkBox2" Width="16" Margin="0,0,5,0" IsChecked="{Binding IsStoneOptionAccentEnabled}" />
          <TextBlock Text="{x:Static l:Strings.ShowAccent}" />
        </DockPanel>
      </StackPanel>
    </DockPanel>
    <DockPanel Grid.Column="2" Margin="10,10,10,0" HorizontalAlignment="Center" VerticalAlignment="Top">
      <TextBlock Name="textBlock2" VerticalAlignment="Bottom" DockPanel.Dock="Top" FontSize="10.667" FontWeight="Bold" Text="{x:Static l:Strings.OutputOptions}" TextWrapping="Wrap" />
      <StackPanel Width="85" HorizontalAlignment="Center" VerticalAlignment="Top" DockPanel.Dock="Bottom">
        <RadioButton Name="radioButton3" Margin="0,10,0,0" Content="3DM" GroupName="OutputOptionsGrp" IsChecked="{Binding IsExportOption3DM}" />
        <RadioButton Name="radioButton2" Margin="0,10,0,0" Content="STL" GroupName="OutputOptionsGrp" IsChecked="{Binding IsExportOptionSTL}" />
        <DockPanel Margin="0,15,0,0" LastChildFill="True" Visibility="{Binding IsChecked, ElementName=radioButton2, Converter={StaticResource BooleanToVisibilityConverter}}">
          <CheckBox Name="checkBox3" Width="16" FontSize="10.667" IsChecked="{Binding IsRepairMeshEnabled}" IsEnabled="{Binding IsChecked, ElementName=radioButton2}" />
          <TextBlock Text="{x:Static l:Strings.RepairMesh}" />
        </DockPanel>
      </StackPanel>
    </DockPanel>
    <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="20,5">
      <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static l:Strings.ExportTo}" TextWrapping="Wrap" />
      <Border Margin="10,0,0,0" VerticalAlignment="Top" BorderBrush="#FF3F3F46" BorderThickness="1">
        <TextBlock Margin="2" TextAlignment="Right" TextTrimming="CharacterEllipsis" Text="{Binding SavePath, Mode=OneWay}" />
      </Border>
    </DockPanel>
    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="20,5">
      <Border Width="80" HorizontalAlignment="Left" BorderBrush="#FF3F3F46" BorderThickness="1,1,1,0" CornerRadius="5,5,0,0" DockPanel.Dock="Top">
        <Grid>
          <TextBlock HorizontalAlignment="Center" Text="{x:Static l:Strings.Statistics}" Visibility="{Binding IsExportFeatureEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}" />
          <TextBlock HorizontalAlignment="Center" Text="{x:Static l:Strings.OrderHistory}" Visibility="{Binding IsExportFeatureEnabled, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
      </Border>
      <Border BorderBrush="#FF3F3F46" BorderThickness="1" DockPanel.Dock="Top">
        <Grid Height="32" Margin="10,0">
          <StackPanel Name="InternationalExportStats" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsExportFeatureEnabled, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=True}">
            <StackPanel Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.Allowed}" TextWrapping="Wrap" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExportsAllowed}" />
            </StackPanel>
            <StackPanel Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.Used}" TextWrapping="Wrap" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExportsCompleted}" />
            </StackPanel>
            <StackPanel Width="100" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.Remaining}" TextWrapping="Wrap" />
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ExportsRemaining}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Name="FeatureExportHistory" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="{Binding IsExportFeatureEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{x:Static l:Strings.ExportsThisMonth}" TextWrapping="Wrap" />
              <TextBlock Margin="5,0" HorizontalAlignment="Center" VerticalAlignment="Center" Text=":" TextWrapping="Wrap" />
              <TextBlock Margin="0,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextWrapping="Wrap" Text="{Binding ExportsCompletedCurrentMonth}" />
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </DockPanel>
  </Grid>
</Window>