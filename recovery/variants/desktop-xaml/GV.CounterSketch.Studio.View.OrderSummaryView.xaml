          <Button Name="btnExportSTL3DM" Margin="0,0,20,0" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource WindowFrameBackground}" BorderThickness="1" FontSize="16" Foreground="#FFFFFFFF" Template="{DynamicResource ButtonQuoteStyle}" BorderBrush="{x:Null}" Command="{Binding CommandExportSTL3DM}" Visibility="{Binding ExportStl3DMVisibility}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="  " />
              <TextBlock Text="{x:Static localization:Strings.ExportSTL3DM}" />
              <TextBlock Text="  " />
            </StackPanel>
          </Button>
          <Button Name="btnGetCompleteQuote" MinWidth="120" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Background="{DynamicResource WindowFrameBackground}" BorderThickness="1" Content="{x:Static localization:Strings.GetPricing}" FontSize="16" Foreground="#FFFFFFFF" Template="{DynamicResource ButtonQuoteStyle}" BorderBrush="{x:Null}" Command="{Binding CommandQuoteSubmit}" IsEnabled="{Binding IsDesignQuotable}" />
          <StackPanel Name="txtOrderedAlreadyText" Orientation="Vertical" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static localization:Strings.DesignPreviouslyOrdered}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF000000" Text="{x:Static localization:UntranslatedStrings.CAMRequest}" TextWrapping="Wrap" />
              <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF000000" Text="#" TextWrapping="Wrap" />
              <TextBlock Margin="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding CamJobResponseResult.CamJob.CamJobID}" />
            </StackPanel>
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10.667" FontStyle="Italic" Text="{x:Static localization:Strings.ToEditThisDesignSaveAndReOpen}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Name="txtOrderedErrorsOnOrder" Orientation="Vertical" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" Text="{x:Static localization:Strings.OrderContainsErrors}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal">
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10.667" FontStyle="Italic" Text="{x:Static localization:Strings.ToGetPricingFixErrorsIn}" TextWrapping="Wrap" />
              <TextBlock HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="10.667" FontStyle="Italic" Foreground="#FFFF0000" Text="{x:Static localization:Strings.Red}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </StackPanel>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="OrderStateGroup">
          <VisualState x:Name="Default" />
          <VisualState x:Name="Ordered">
            <Storyboard>
              <BooleanAnimationUsingKeyFrames Storyboard.TargetName="stackPanel" Storyboard.TargetProperty="(UIElement.IsHitTestVisible)">
                <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
              </BooleanAnimationUsingKeyFrames>
              <BooleanAnimationUsingKeyFrames Storyboard.TargetName="OrderOptionsGrid" Storyboard.TargetProperty="(UIElement.IsHitTestVisible)">
                <DiscreteBooleanKeyFrame KeyTime="0" Value="False" />
              </BooleanAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="btnGetCompleteQuote" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="txtOrderedAlreadyText" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
              </ObjectAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Errored">
            <Storyboard>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="btnGetCompleteQuote" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
              </ObjectAnimationUsingKeyFrames>
              <ObjectAnimationUsingKeyFrames Storyboard.TargetName="txtOrderedErrorsOnOrder" Storyboard.TargetProperty="(UIElement.Visibility)">
                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
              </ObjectAnimationUsingKeyFrames>
            </Storyboard>
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
