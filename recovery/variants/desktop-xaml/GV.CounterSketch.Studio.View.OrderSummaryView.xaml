                <StackPanel Width="700" Margin="50,0,38,5" DockPanel.Dock="Top" Orientation="Vertical">
                  <RadioButton Margin="0,0,0,5" Content="{x:Static localization:Strings.No}" GroupName="MoreThanRingOption" Style="{DynamicResource CS4RadioButtonStyle}" IsChecked="{Binding SelectedNoMoreThanARing}" />
                  <RadioButton Margin="0,0,0,5" Content="{x:Static localization:Strings.BookAndDigitalImages}" GroupName="MoreThanRingOption" Style="{DynamicResource CS4RadioButtonStyle}" IsChecked="{Binding SelectedMoreThanARing}" />
                  <RadioButton Margin="0,0,0,5" Content="{x:Static localization:Strings.DigitalImagesOnly}" GroupName="MoreThanRingOption" Style="{DynamicResource CS4RadioButtonStyle}" IsChecked="{Binding SelectedMoreThanARingDigitalOnly}" />
                </StackPanel>
                <DockPanel Margin="50,0,0,0" Dock="Top">
                  <TextBlock Margin="0,0,5,0" Text="{x:Static localization:Strings.LookBookBriefDescription}" TextWrapping="Wrap" />
                  <TextBlock>
                    <Hyperlink TextDecorations="None" Command="{Binding CommandOpenMoreThanARingPreview, Mode=OneWay}">
                      <InlineUIContainer>
                        <TextBlock DockPanel.Dock="Top" FontStyle="Italic" TextWrapping="Wrap">
                          <TextBlock.Foreground>
                            <SolidColorBrush Color="{DynamicResource HighlightAndAccentColor}" />
                          </TextBlock.Foreground>
                          <Run Text="{x:Static localization:Strings.ViewBookExample}" />
                        </TextBlock>
                      </InlineUIContainer>
                    </Hyperlink>
                  </TextBlock>
                </DockPanel>
              </DockPanel>
              <DockPanel Name="WaxMemo" Margin="0,0,0,20" Visibility="{Binding IsWaxMemoSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,3" DockPanel.Dock="Top" Text="{x:Static localization:Strings.WaxMemo}" TextWrapping="Wrap" />
                <Separator Margin="0,0,0,10" DockPanel.Dock="Top" SnapsToDevicePixels="True" />
                <StackPanel Margin="50,0,38,5" DockPanel.Dock="Top" Orientation="Vertical">
                  <RadioButton Margin="0,0,0,5" Content="{x:Static localization:Strings.YesSendAWaxMemo}" GroupName="WaxMemoGroup" Style="{DynamicResource CS4RadioButtonStyle}" IsChecked="{Binding IncludeWaxMemo, Mode=TwoWay}" Visibility="{Binding IsWaxMemoNoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <RadioButton Margin="0,0,0,5" Content="{x:Static localization:Strings.NoWaxMemo}" GroupName="WaxMemoGroup" Style="{DynamicResource CS4RadioButtonStyle}" IsChecked="{Binding IncludeWaxMemo, Mode=TwoWay, Converter={StaticResource BooleanInverseConverter}}" Visibility="{Binding IsWaxMemoYesVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
              </DockPanel>
              <DockPanel Name="SupportingDocs" Margin="0,0,0,10" Visibility="{Binding IsSupportingDocsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Margin="0,0,0,3" DockPanel.Dock="Top" Text="{x:Static localization:UntranslatedStrings.SupportingDocuments}" TextWrapping="Wrap" />
                <Separator Margin="0,0,0,10" DockPanel.Dock="Top" SnapsToDevicePixels="True" />
                <DockPanel Dock="Top">
                  <TextBlock Margin="50,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Center" DockPanel.Dock="Left" Text="{x:Static localization:UntranslatedStrings.SupportingDocumentNote}" TextWrapping="Wrap" />
                  <Button MinWidth="100" Margin="10,0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static localization:Strings.Clear}" DockPanel.Dock="Left" Command="{Binding CommandClearFiles}" />
                  <Button MinWidth="100" Margin="10,0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{x:Static localization:UntranslatedStrings.AddFile}" DockPanel.Dock="Left" Command="{Binding CommandAttachFile}" />
                </DockPanel>
                <ListBox Margin="50,5,0,5" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="0" ItemContainerStyle="{StaticResource ListBoxItemStyleWithoutSelection}" ItemTemplate="{StaticResource DataTemplateAttachedFiles}" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding AttachedFiles}" />
              </DockPanel>
              <Separator Margin="0,0,0,10" SnapsToDevicePixels="True" />
              <TextBlock Margin="10" HorizontalAlignment="Center" Foreground="#FFFF0000" TextWrapping="Wrap" Text="{Binding NotesToCustomer}" Visibility="{Binding NotesToCustomer, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}" />
              <TextBlock Margin="10,0,10,2" Foreground="#FF000000" Text="{x:Static localization:Strings.AdditionalDesignNotes}" TextWrapping="Wrap" Visibility="{Binding AdditionalDesignNotes, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}" />
              <Border Margin="10,0,10,10" Padding="10" Background="#FFD3D3D3" BorderBrush="#FF000000" BorderThickness="1" Visibility="{Binding AdditionalDesignNotes, Converter={StaticResource StringIsNullOrEmptyToVisibilityConverter}}">
                <TextBlock Margin="4" Foreground="#FF000000" TextWrapping="Wrap" Text="{Binding AdditionalDesignNotes}" />
              </Border>
              <Button Width="246" Margin="0,0,0,10" Content="{x:Static localization:Strings.AdditionalDesignNotes}" Template="{DynamicResource CS4ButtonRounded}" Command="{Binding CommandOpenDesignNotesWindow, Mode=OneWay}" />
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </DockPanel>
